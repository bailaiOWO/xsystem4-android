diff --git a/src/sprite.c b/src/sprite.c
index e845f88..126eb32 100644
--- a/src/sprite.c
+++ b/src/sprite.c
@@ -405,7 +405,9 @@ void sprite_text_draw(struct sact_sprite *sp, struct string *text, struct text_s
 	}
 
 	ts->font_spacing = sp->text.char_space;
-	sp->text.pos.x += gfx_render_text(&sp->text.texture, sp->text.pos.x, sp->text.pos.y, text->text, ts, false);
+	float w = gfx_render_text(&sp->text.texture, sp->text.pos.x, sp->text.pos.y, text->text, ts, false);
+	sp->text.pos.x += w;
+	sp->text.last_draw_width = (int)w;
 	if (sp->text.current_line_height < ts->size)
 		sp->text.current_line_height = ts->size;
 	sprite_dirty(sp);
@@ -447,9 +449,43 @@ void sprite_text_copy(struct sact_sprite *dsp, struct sact_sprite *ssp)
 	dsp->text.char_space = ssp->text.char_space;
 	dsp->text.line_space = ssp->text.line_space;
 	dsp->text.current_line_height = ssp->text.current_line_height;
+	dsp->text.last_draw_width = ssp->text.last_draw_width;
 	sprite_dirty(dsp);
 }
 
+void sprite_text_scroll(struct sact_sprite *sp, int dx, int dy)
+{
+	if (!sp->text.texture.handle)
+		return;
+
+	struct texture tmp;
+	gfx_init_texture_rgba(&tmp, sp->text.texture.w, sp->text.texture.h, COLOR(0, 0, 0, 0));
+	gfx_copy(&tmp, dx, dy, &sp->text.texture, 0, 0, sp->text.texture.w, sp->text.texture.h);
+	gfx_copy(&sp->text.texture, 0, 0, &tmp, 0, 0, tmp.w, tmp.h);
+	gfx_delete_texture(&tmp);
+
+	sp->text.pos.x += dx;
+	sp->text.pos.y += dy;
+	sprite_dirty(sp);
+}
+
+void sprite_text_back_space(struct sact_sprite *sp)
+{
+	if (!sp->text.texture.handle || sp->text.last_draw_width <= 0)
+		return;
+
+	int x = sp->text.pos.x - sp->text.last_draw_width;
+	if (x < 0)
+		x = 0;
+	// erase the pixels of the last drawn character(s)
+	gfx_fill_alpha_color(&sp->text.texture, x, sp->text.pos.y,
+			sp->text.pos.x - x,
+			sp->text.texture.h - sp->text.pos.y, 0, 0, 0, 0);
+	sp->text.pos.x = x;
+	sp->text.last_draw_width = 0;
+	sprite_dirty(sp);
+}
