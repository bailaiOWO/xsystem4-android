+/*
+ * Log every distinct HLL entry point the game uses, once per run.
+ *
+ * Porting a new game means answering "which engine APIs does it actually
+ * call?" - this gives that list directly (several hundred lines at most),
+ * without the noise of per-call tracing.
+ */
+static void log_hll_usage(struct ain_library *lib, int libno, int fno)
+{
+	static bool **seen;
+	static unsigned *seen_size;
+	if (!seen) {
+		seen = xcalloc(ain->nr_libraries, sizeof(bool*));
+		seen_size = xcalloc(ain->nr_libraries, sizeof(unsigned));
+	}
+	if (!seen[libno] || seen_size[libno] < lib->nr_functions) {
+		unsigned old = seen_size[libno];
+		seen[libno] = xrealloc(seen[libno], lib->nr_functions * sizeof(bool));
+		memset(seen[libno] + old, 0, (lib->nr_functions - old) * sizeof(bool));
+		seen_size[libno] = lib->nr_functions;
+	}
+	if (!seen[libno][fno]) {
+		seen[libno][fno] = true;
+		NOTICE("HLLUSE: %s.%s", lib->name, lib->functions[fno].name);
+	}
+}
+
