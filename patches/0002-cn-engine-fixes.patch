+/*
+ * Rance Quest identifies CGs by name (string) while the earlier games of the
+ * same engine generation use numeric indices. That signature is what the
+ * ChipmunkSpriteEngine/GoatGUIEngine hooks key off, so it is also the reliable
+ * way to recognise the game: the CN patches rename it in the ini (e.g. the
+ * Chinese Rance Quest has GameName="兰斯8"), which defeats the name check in
+ * apply_game_specific_hacks.
+ */
+static bool is_rance8_by_signature(struct ain *ain)
+{
+	int libno = ain_get_library(ain, "GoatGUIEngine");
+	if (libno < 0)
+		return false;
+	int fno = ain_get_library_function(ain, libno, "SetPartsCG");
+	if (fno < 0)
+		return false;
+	struct ain_hll_function *fun = &ain->libraries[libno].functions[fno];
+	return fun->nr_arguments >= 2 && fun->arguments[1].type.data == AIN_STRING;
+}
+
 void apply_game_specific_hacks(struct ain *ain)
 {
 	char *game_name = sjis2utf(config.game_name, 0);
@@ -315,4 +335,9 @@ void apply_game_specific_hacks(struct ain *ain)
 	// XXX: we don't rely on game_name because mods change it
 	if (ain_get_library(ain, "SengokuRanceFont") >= 0)
 		game_rance7_mg = true;
+
+	// Same reasoning for Rance Quest: the CN patches change GameName, so fall
+	// back to the engine API signature (CGs identified by name).
+	if (!game_rance8 && is_rance8_by_signature(ain))
+		game_rance8 = true;
 }
