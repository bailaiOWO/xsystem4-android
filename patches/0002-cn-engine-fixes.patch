+static void log_decoded_cg(const char *what, struct cg *cg)
+{
+	if (!cg)
+		return;
+	// Diagnostic: is the decoded CG real content or empty/transparent? (A
+	// sprite whose alpha is all zero draws nothing at all.)
+	size_t px = (size_t)cg->metrics.w * cg->metrics.h;
+	if (px > 4096)
+		px = 4096;
+	unsigned sum = 0, alpha0 = 0, alpha255 = 0;
+	if (cg->pixels && cg->metrics.has_pixel) {
+		const uint8_t *p = cg->pixels;
+		for (size_t i = 0; i < px; i++) {
+			sum += p[i * 4] + p[i * 4 + 1] + p[i * 4 + 2];
+			if (p[i * 4 + 3] == 0)
+				alpha0++;
+			else if (p[i * 4 + 3] == 255)
+				alpha255++;
+		}
+	}
+	NOTICE("CG %s: type=%d %dx%d bpp=%d px=%d alpha=%d | rgb_sum=%u a0=%u a255=%u of %u",
+	       what, cg->type, cg->metrics.w, cg->metrics.h, cg->metrics.bpp,
+	       cg->metrics.has_pixel, cg->metrics.has_alpha, sum, alpha0, alpha255,
+	       (unsigned)px);
+}
