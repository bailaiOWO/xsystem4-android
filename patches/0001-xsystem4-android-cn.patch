+/*
+ * Crash-safe file replacement (see xsystem4.h). Android may kill the app at
+ * any moment (low memory, swipe away, power loss); opening a save with "wb"
+ * truncated the previous one first, so a kill or a failed write in between
+ * left an empty or partial save and the player lost the slot.
+ */
+FILE *atomic_file_open(const char *path, char **tmp_path)
+{
+	size_t n = strlen(path);
+	char *tmp = xmalloc(n + 5);
+	memcpy(tmp, path, n);
+	memcpy(tmp + n, ".tmp", 5);
+	FILE *fp = file_open_utf8(tmp, "wb");
+	if (!fp) {
+		free(tmp);
+		*tmp_path = NULL;
+		return NULL;
+	}
+	*tmp_path = tmp;
+	return fp;
+}
+
+static bool atomic_sync(FILE *fp)
+{
+#ifdef _WIN32
+	return _commit(_fileno(fp)) == 0;
+#else
+	return fsync(fileno(fp)) == 0;
+#endif
+}
+
+static bool atomic_rename(const char *from, const char *to)
+{
+#ifdef _WIN32
+	wchar_t *src = utf8_to_wchar(from), *dst = utf8_to_wchar(to);
+	bool ok = MoveFileExW(src, dst, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+	free(src);
+	free(dst);
+	return ok;
+#else
+	if (rename(from, to))
+		return false;
+	// Persist the directory entry too, so the rename itself survives a crash.
+	const char *slash = strrchr(to, '/');
+	if (slash && slash > to) {
+		char *dir = strndup(to, slash - to);
+		int fd = open(dir, O_RDONLY);
+		if (fd >= 0) {
+			fsync(fd);
+			close(fd);
+		}
+		free(dir);
+	}
+	return true;
+#endif
+}
+
+bool atomic_file_commit(FILE *fp, char *tmp_path, const char *path, bool ok)
+{
+	if (!fp || !tmp_path) {
+		free(tmp_path);
+		return false;
+	}
+	if (fflush(fp) || ferror(fp))
+		ok = false;
+	if (ok && !atomic_sync(fp))
+		ok = false;
+	if (fclose(fp))
+		ok = false;
+	if (ok && !atomic_rename(tmp_path, path))
+		ok = false;
+	if (!ok) {
+		WARNING("Could not save '%s' (%s); the previous file was kept",
+				display_utf0(path), strerror(errno));
+		remove_utf8(tmp_path);
+	}
+	free(tmp_path);
+	return ok;
+}
+
+bool atomic_file_write(const char *path, const void *data, size_t size)
+{
+	char *tmp;
+	FILE *fp = atomic_file_open(path, &tmp);
+	if (!fp)
+		return false;
+	bool ok = !size || fwrite(data, size, 1, fp) == 1;
+	return atomic_file_commit(fp, tmp, path, ok);
+}
