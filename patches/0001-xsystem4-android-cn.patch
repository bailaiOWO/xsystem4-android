diff --git a/include/time_scale.h b/include/time_scale.h
new file mode 100644
index 0000000..e96c69b
--- /dev/null
+++ b/include/time_scale.h
@@ -0,0 +1,51 @@
+/* Copyright (C) 2019 Nunuhara Cabbage <nunuhara@haniwa.technology>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://gnu.org/licenses/>.
+ */
+
+/*
+ * 变速齿轮：把引擎看到的时间轴整体缩放（游戏加速/减速）。
+ *
+ * 引擎里"现在几点"和"睡一会儿"都走 SDL_GetTicks64() / SDL_GetTicks() / SDL_Delay()，
+ * 这里在头文件层把它们替换成缩放版本，所以所有既有调用点自动生效：
+ *
+ *   - 读时间：以最近一次切换倍率的时刻为基准，把真实流逝时间乘以倍率；
+ *   - 睡眠  ：按同样倍率缩短/拉长。必须一起缩放，否则游戏的帧率限制
+ *             （SDL_Delay(t + 16 - t2) 这种）会把加速效果抵消掉。
+ *
+ * 倍率为 1.0 时读时间直接透传，行为与未改动前完全一致。
+ * 只有 src/time_scale.c 需要真实的 SDL 函数，它定义 XSYSTEM4_TIME_SCALE_IMPL
+ * 来关掉下面的宏。
+ */
+
+#ifndef XSYSTEM4_TIME_SCALE_H
+#define XSYSTEM4_TIME_SCALE_H
+
+#include <SDL.h>
+
+/* 1.0 = 原速；> 1 加速；< 1 减速 */
+extern volatile double sys_time_scale;
+
+Uint64 sys_get_ticks64(void);
+Uint32 sys_get_ticks(void);
+void sys_delay(Uint32 ms);
+void sys_set_time_scale(double scale);
+
+#ifndef XSYSTEM4_TIME_SCALE_IMPL
+#define SDL_GetTicks64() sys_get_ticks64()
+#define SDL_GetTicks()   sys_get_ticks()
+#define SDL_Delay(ms)    sys_delay(ms)
+#endif
+
+#endif /* XSYSTEM4_TIME_SCALE_H */
