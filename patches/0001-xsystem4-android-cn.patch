+			struct talt_metadata *m = &atlas->metadata[j];
+			if (m->unknown1_off > fl->data_size || m->unknown1_size > fl->data_size - m->unknown1_off) continue;
+			char *name = xmalloc(m->unknown1_size + 1);
+			for (unsigned k = 0; k < m->unknown1_size; k++)
+				name[k] = fl->data[m->unknown1_off+k] ^ (fl->elna.present ? 0x55 : 0);
