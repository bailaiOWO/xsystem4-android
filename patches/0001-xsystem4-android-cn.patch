+	};
+	const SDL_MessageBoxData box = {SDL_MESSAGEBOX_INFORMATION, NULL, "xsystem4",
+		utf, SDL_arraysize(buttons), buttons, NULL};
+	int result = 0;
+	if (SDL_ShowMessageBox(&box, &result)) WARNING("Cannot show confirmation: %s", SDL_GetError());
+	free(utf);
+	return result == 1;
+}
+static bool System_GroupSave(struct string *key, struct string *file, struct string *group, int *count)
+{
