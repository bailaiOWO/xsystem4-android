new file mode 100644
index 0000000..185b15d
--- /dev/null
+++ b/src/parts/rotation.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef SYSTEM4_PARTS_ROTATION_H
+#define SYSTEM4_PARTS_ROTATION_H
+
+#include <math.h>
+
+// Screen projection of Rz * Rx(-x) * Ry, matching Flat's rotation axes.
+// The matrix is row-major; scale and translation are applied separately.
+static inline void parts_rotation_projection(float x, float y, float z, float m[4])
+{
+	const float rad = 3.14159265358979323846f / 180.0f;
+	float cx = cosf(x * rad), sx = sinf(x * rad);
+	float cy = cosf(y * rad), sy = sinf(y * rad);
+	float cz = cosf(z * rad), sz = sinf(z * rad);
+	m[0] = cz * cy + sz * sx * sy;
+	m[1] = -sz * cx;
+	m[2] = sz * cy - cz * sx * sy;
+	m[3] = cz * cx;
+}
+
+static inline int parts_rotation_back_facing(float x, float y)
+{
+	const float rad = 3.14159265358979323846f / 180.0f;
+	return cosf(x * rad) * cosf(y * rad) <= 0.00001f;
+}
+
+#endif
