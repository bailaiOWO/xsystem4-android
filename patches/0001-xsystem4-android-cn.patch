+/*
+ * Int / Float: value -> string conversions.
+ *     string Int.String(ref int)
+ *     string Float.String(ref float, int decimals)
+ */
+static struct string *Int_String(int *value)
+{
+	return integer_to_string(*value);
+}
+
+static struct string *Float_String(float *value, int decimals)
+{
+	if (decimals < 0)
+		decimals = 0;
+	if (decimals > 9)
+		decimals = 9;
+	char buf[64];
+	snprintf(buf, sizeof(buf), "%.*f", decimals, *value);
+	return cstr_to_string(buf);
+}
+
+HLL_LIBRARY(Int,
+	    HLL_EXPORT(String, Int_String)
+	    );
+
+HLL_LIBRARY(Float,
+	    HLL_EXPORT(String, Float_String)
+	    );
+
+static int String_Int(struct string **s) { return string_to_integer(*s); }
+static float String_Float(struct string **s) { return strtof((*s)->text, NULL); }
+static int String_Length(struct string **s) { return sjis_count_char((*s)->text); }
+static int String_LengthByte(struct string **s) { return (*s)->size; }
+static bool String_Empty(struct string **s) { return !(*s)->size; }
+static void String_Erase(struct string **s, int index, int length)
+{
+	if (index < 0 || length <= 0) return;
+	int count = String_Length(s);
+	if (index >= count) return;
+	if (length > count - index) length = count - index;
+	for (int i = 0; i < length; i++) string_erase(s, index);
+}
+static void String_Insert(struct string **s, int index, struct string *text)
+{
+	if (index < 0) return;
+	int count = String_Length(s);
+	if (index > count) index = count;
+	struct string *result = string_copy(*s, 0, index);
+	struct string *tail = string_copy(*s, index, count - index);
+	string_append(&result, text); string_append(&result, tail);
+	free_string(tail); free_string(*s); *s = result;
+}
+static int String_Find(struct string **s, struct string *key) { return string_find(*s, key); }
+static int String_FindLast(struct string **s, struct string *key)
+{
+	int result = -1, index = 0;
+	for (const char *p = (*s)->text; ; p = sjis_skip_char(p), index++) {
+		if ((int)strlen(p) >= key->size && !memcmp(p, key->text, key->size)) result = index;
+		if (!*p) break;
+	}
+	return result;
+}
+static bool String_Contains(struct string **s, struct string *key) { return string_find(*s, key) >= 0; }
+#include "regex.inc"
+
+/* Rance 10 strips battle-log colour tags with `\{.+?\}` and replaces
+ * `＜艾尔..＞` with the hero's name. An unsupported pattern leaves the
+ * string unchanged rather than emptying it. */
+static struct string *String_ReplaceRegex(struct string **s, struct string *regex, struct string *replacement)
+{
+	bool valid;
+	struct string *out = rx_replace_all(*s, regex, replacement, &valid);
+	if (!valid)
+		WARNING("String.ReplaceRegex: unsupported pattern \"%s\"", display_sjis0(regex->text));
+	return out;
+}
+
+static struct string *String_Replace(struct string **s, struct string *key, struct string *replacement)
+{
+	if (!key->size) return string_dup(*s);
+	struct string *result = string_ref(&EMPTY_STRING);
+	const char *start = (*s)->text, *cursor = start, *end = start + (*s)->size;
+	while (cursor < end) {
+		if (end - cursor >= key->size && !memcmp(cursor,key->text,key->size)) {
+			string_append_cstr(&result,start,cursor-start);
+			string_append(&result,replacement);
+			cursor += key->size;
+			start = cursor;
+		} else {
+			const char *next = sjis_skip_char(cursor);
+			cursor = next <= end ? next : cursor + 1;
+		}
+	}
+	string_append_cstr(&result,start,end-start);
+	return result;
+}
+static bool String_StartsWith(struct string **s, struct string *key) { return (*s)->size >= key->size && !memcmp((*s)->text, key->text, key->size); }
+static bool String_EndsWith(struct string **s, struct string *key) { return (*s)->size >= key->size && !memcmp((*s)->text + (*s)->size - key->size, key->text, key->size); }
+static struct string *String_GetPart(struct string **s, int index, int length) { return string_copy(*s, index, length); }
+static struct string *String_GetTail(struct string **s, int index) { return string_copy(*s, index, String_Length(s)); }
+static struct string *String_ChangeCase(struct string **s, bool upper)
+{
+	struct string *result = string_dup(*s);
+	for (char *p = result->text; *p; p = sjis_skip_char(p))
+		if (!SJIS_2BYTE(*p)) *p = upper ? toupper((unsigned char)*p) : tolower((unsigned char)*p);
+	return result;
+}
+static struct string *String_ToLower(struct string **s) { return String_ChangeCase(s, false); }
+static struct string *String_ToUpper(struct string **s) { return String_ChangeCase(s, true); }
+
+static struct page *String_Split(struct string **self, struct string *separators, bool contain_separator)
+{
+	struct page *out = NULL;
+	const char *start = (*self)->text, *cursor = start;
+	while (*cursor) {
+		const char *next = sjis_skip_char(cursor);
+		if (next > (*self)->text + (*self)->size) next = cursor + 1;
+		bool separator = false;
+		for (const char *s = separators->text; *s;) {
+			const char *end = sjis_skip_char(s);
+			if (end > separators->text + separators->size) end = s + 1;
+			if (end - s == next - cursor && !memcmp(s,cursor,next-cursor)) separator = true;
+			s = end;
+		}
+		if (separator) {
+			/* Omit empty fields; contain_separator only adds separator tokens. */
+			union vm_value token;
+			if (cursor > start) {
+				token.i = heap_alloc_string(make_string(start,cursor-start));
+				out = array_pushback(out,token,AIN_ARRAY_STRING,-1);
+			}
+			if (contain_separator) {
+				token.i = heap_alloc_string(make_string(cursor,next-cursor));
+				out = array_pushback(out,token,AIN_ARRAY_STRING,-1);
+			}
+			start = next;
+		}
+		cursor = next;
+	}
+	if (cursor > start) {
+		union vm_value token = {.i = heap_alloc_string(make_string(start,cursor-start))};
+		out = array_pushback(out,token,AIN_ARRAY_STRING,-1);
+	}
+	return out;
+}
+
+HLL_LIBRARY(String,
+	HLL_EXPORT(Int, String_Int), HLL_EXPORT(Float, String_Float),
+	HLL_EXPORT(Length, String_Length), HLL_EXPORT(LengthByte, String_LengthByte), HLL_EXPORT(Empty, String_Empty),
+	HLL_EXPORT(PushBack, string_push_back), HLL_EXPORT(PopBack, string_pop_back),
+	HLL_EXPORT(Erase, String_Erase), HLL_EXPORT(Insert, String_Insert),
+	HLL_EXPORT(Find, String_Find), HLL_EXPORT(FindLast, String_FindLast), HLL_EXPORT(Contains, String_Contains),
+	HLL_EXPORT(Replace, String_Replace),
+	HLL_EXPORT(ReplaceRegex, String_ReplaceRegex),
+	HLL_EXPORT(StartsWith, String_StartsWith), HLL_EXPORT(EndsWith, String_EndsWith),
+	HLL_EXPORT_SIG(GetPart, String_GetPart, "ref string,int,int"),
+	HLL_EXPORT_SIG(GetPart, String_GetTail, "ref string,int"),
+	HLL_EXPORT(ToLower, String_ToLower), HLL_EXPORT(ToUpper, String_ToUpper),
+	HLL_EXPORT(Split, String_Split)
+);
+
+/*
+ * Clipboard: backed by SDL's clipboard support.
+ *     void   Clipboard.SetText(string)
+ *     string Clipboard.GetText()
+ */
+static void Clipboard_SetText(struct string *text)
+{
+	char *utf8 = sjis2utf(text ? text->text : "", text ? text->size : 0);
+	SDL_SetClipboardText(utf8);
+	free(utf8);
+}
+
+static struct string *Clipboard_GetText(void)
+{
+	char *text = SDL_GetClipboardText();
+	if (!text)
+		return string_ref(&EMPTY_STRING);
+	char *encoded = utf2sjis(text, 0);
+	struct string *copy = cstr_to_string(encoded);
+	free(encoded);
+	SDL_free(text);
+	return copy;
+}
+
+HLL_LIBRARY(Clipboard,
+	    HLL_EXPORT(SetText, Clipboard_SetText),
+	    HLL_EXPORT(GetText, Clipboard_GetText)
+	    );
+
+/*
+ * PCInfo / InstallInfo: the game only uses these to describe the machine it
+ * runs on, so report something sensible for Android.
+ *     bool PCInfo.GetOSInfo(ref string)
+ *     bool InstallInfo.IsInstalledGame(string)
+ *     int  InstallInfo.GetInstallMediaType()
+ */
+static bool PCInfo_GetOSInfo(struct string **os_name)
+{
+	if (!os_name)
+		return false;
+	if (*os_name)
+		free_string(*os_name);
+	*os_name = cstr_to_string("Android");
+	return true;
+}
+
+HLL_LIBRARY(PCInfo,
+	    HLL_EXPORT(GetOSInfo, PCInfo_GetOSInfo)
+	    );
+
+static bool InstallInfo_IsInstalledGame(struct string *game_name)
+{
+	(void)game_name;
+	return true;
+}
+
+static int InstallInfo_GetInstallMediaType(void)
+{
+	return 0;
+}
+
+HLL_LIBRARY(InstallInfo,
+	    HLL_EXPORT(IsInstalledGame, InstallInfo_IsInstalledGame),
+	    HLL_EXPORT(GetInstallMediaType, InstallInfo_GetInstallMediaType)
+	    );
