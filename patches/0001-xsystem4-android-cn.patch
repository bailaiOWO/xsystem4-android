+static struct string *pa_checkbox_flat_name(struct parts *p, int state)
+{
+	const char *suffixes[] = {"／一般.flat", "／オン.flat", "／DOWN.flat"};
+	struct string *base = p->checkbox_checked && p->checkbox_checked_flat && p->checkbox_checked_flat->size
+		? p->checkbox_checked_flat : p->checkbox_flat;
+	if (!base || !base->size) return NULL;
+	if (asset_exists_by_name(ASSET_FLAT,base->text,NULL)) return string_ref(base);
+	struct string *name = string_ref(base);
+	if (p->checkbox_checked && base == p->checkbox_flat) {
+		char *checked = utf2gbk("／检查",0);
+		string_append_cstr(&name,checked,strlen(checked)); free(checked);
+	}
+	char *suffix = utf2gbk(suffixes[state],0);
+	string_append_cstr(&name,suffix,strlen(suffix)); free(suffix);
+	if (asset_exists_by_name(ASSET_FLAT,name->text,NULL)) return name;
+	free_string(name);
+	// Missing optional states must not erase a working drawable.
+	if (!p->checkbox_flat || !p->checkbox_flat->size) return NULL;
+	name=string_ref(p->checkbox_flat);
+	suffix=utf2gbk(suffixes[0],0);
+	string_append_cstr(&name,suffix,strlen(suffix)); free(suffix);
+	if (asset_exists_by_name(ASSET_FLAT,name->text,NULL)) return name;
+	free_string(name); return NULL;
+}
