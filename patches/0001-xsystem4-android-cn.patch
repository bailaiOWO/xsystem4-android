new file mode 100644
index 0000000..f4b3776
--- /dev/null
+++ b/src/hll/KiwiSoundNew.inc
@@ -0,0 +1,266 @@
+/* Name-based KiwiSoundEngine API (AIN 11+). SPDX-License-Identifier: GPL-2.0-or-later */
+#include <stdlib.h>
+#include <limits.h>
+#include <SDL.h>
+#include "system4/string.h"
+#include "system4/archive.h"
+#include "system4/ex.h"
+#include "id_pool.h"
+#include "mixer.h"
+#include "xsystem4.h"
+
+struct kiwi_sound {
+	struct channel *channel;
+	enum asset_type type;
+	int span;
+	bool multi, played;
+	Uint32 last_play;
+	struct channel **tails;
+	int nr_tails;
+};
+static struct id_pool kiwi_ids, kiwi_se_ids;
+static struct ex *kiwi_metadata;
+static bool kiwi_metadata_loaded;
+
+static void kiwi_init(void)
+{
+	/* Kiwi's modern group numbers are Master=0, BGM=1, SE=2,
+	 * Voice=3, foreground voice=4, background voice=5. AliceStart.ini
+	 * need not contain the legacy System40VolumeValancer setting. Without
+	 * these entries GetMixerVolume fails and the script fades BGM to zero. */
+	if (ain->version >= 11 && !config.mixer_nr_channels) {
+		const char *names[] = {"Master", "BGM", "SE", "Voice", "FrontVoice", "BackVoice"};
+		config.mixer_nr_channels = 6;
+		config.mixer_channels = xcalloc(6, sizeof(char*));
+		config.mixer_volumes = xcalloc(6, sizeof(int));
+		for (int i=0; i<6; i++) {
+			config.mixer_channels[i] = xstrdup(names[i]);
+			config.mixer_volumes[i] = config.default_volume;
+		}
+	}
+	audio_init(); id_pool_init(&kiwi_ids,0); id_pool_init(&kiwi_se_ids,0);
+}
+static void kiwi_clear_sound(struct kiwi_sound *s)
+{
+	if (!s) return;
+	if (s->channel) channel_close(s->channel);
+	for (int i=0; i<s->nr_tails; i++) channel_close(s->tails[i]);
+	free(s->tails); s->tails=NULL; s->nr_tails=0; s->channel=NULL;
+}
+static void kiwi_fini(void)
+{
+	struct id_pool *pools[]={&kiwi_ids,&kiwi_se_ids};
+	for (int p=0;p<2;p++) {
+		for (int i=0;i<pools[p]->nr_slots;i++) {
+			struct kiwi_sound *s=pools[p]->slots[i]; kiwi_clear_sound(s); free(s);
+		}
+		id_pool_delete(pools[p]);
+	}
+	if (kiwi_metadata) ex_free(kiwi_metadata);
+	kiwi_metadata = NULL; kiwi_metadata_loaded = false;
+}
+
+static struct ex_table *kiwi_sound_info(void)
+{
+	if (!kiwi_metadata_loaded) {
+		kiwi_metadata_loaded = true;
+		struct archive_data *d = asset_get_by_name(ASSET_SOUND,"timemap_sound.ex",NULL);
+		if (d) {
+			kiwi_metadata = ex_read(d->data,d->size);
+			archive_free_data(d);
+		}
+	}
+	return kiwi_metadata ? ex_get_table(kiwi_metadata,"SoundInfo") : NULL;
+}
+
+static int kiwi_info_row(struct ex_table *t, const char *name)
+{
+	if (!t) return -1;
+	int row = ex_row_at_string_key(t,name);
+	if (row >= 0) return row;
+	char *base = archive_basename(name);
+	/* Archive lookup also ignores extension, case, and slash direction. */
+	for (unsigned i=0; i<t->nr_rows; i++) {
+		struct ex_value *v = ex_table_get(t,i,0);
+		if (!v || v->type != EX_STRING) continue;
+		char *key = archive_basename(v->s->text);
+		bool equal = !strcmp(key,base);
+		free(key);
+		if (equal) { row = i; break; }
+	}
+	free(base);
+	return row;
+}
+
+static int kiwi_info_int(struct ex_table *t, int row, const char *col, int dflt)
+{
+	int c = t ? ex_col_from_name(t,col) : -1;
+	struct ex_value *v = row >= 0 && c >= 0 ? ex_table_get(t,row,c) : NULL;
+	return v && v->type == EX_INT ? v->i : dflt;
+}
+
+static int kiwi_default_group(enum asset_type type)
+{
+	return type == ASSET_BGM ? 1 : type == ASSET_VOICE ? 4 : 2;
+}
+
+static struct channel *kiwi_open(struct archive_data *data, enum asset_type type, int index, const char *name)
+{
+	struct channel *ch = channel_open_archive_data(data,type,index);
+	if (!ch || ain->version < 11) return ch;
+	struct ex_table *t = kiwi_sound_info();
+	int row = kiwi_info_row(t,name);
+	channel_set_group(ch,kiwi_info_int(t,row,"Group",kiwi_default_group(type)));
+	int frames = channel_get_sample_length(ch);
+	int begin = kiwi_info_int(t,row,"LoopBeginSample",0);
+	int end = kiwi_info_int(t,row,"LoopEndSample",0);
+	if (end > 0 && end <= frames && begin >= 0 && begin < end) {
+		channel_set_loop_start_pos(ch,begin);
+		channel_set_loop_end_pos(ch,end);
+	}
+	return ch;
+}
+static struct archive_data *kiwi_asset(struct string *name, enum asset_type *type, int *index)
+{
+	const enum asset_type types[]={ASSET_BGM,ASSET_SOUND,ASSET_VOICE};
+	for (int i=0;i<3;i++) {
+		struct archive_data *data=asset_get_by_name(types[i],name->text,index);
+		if (data) { *type=types[i]; return data; }
+	}
+	return NULL;
+}
+static bool kiwi_exists_file(struct string *name)
+{
+	return asset_exists_by_name(ASSET_BGM,name->text,NULL) ||
+		asset_exists_by_name(ASSET_SOUND,name->text,NULL) || asset_exists_by_name(ASSET_VOICE,name->text,NULL);
+}
+static struct kiwi_sound *kiwi_slot(struct id_pool *pool,int id)
+{
+	if (id<0) return NULL;
+	struct kiwi_sound *s=id_pool_get(pool,id);
+	if (!s) { s=xcalloc(1,sizeof(*s)); id_pool_set(pool,id,s); }
+	return s;
+}
+static int kiwi_free_id(struct id_pool *pool,int first,int last)
+{
+	for (int i=max(0,first);i<=last;i++) {
+		if (!id_pool_get(pool,i)) return i;
+		if (i==INT_MAX) break;
+	}
+	return -1;
+}
+static int kiwi_get_free_id(int first,int last) { return kiwi_free_id(&kiwi_ids,first,last); }
+static int kiwi_get_free_se_id(int first,int last) { return kiwi_free_id(&kiwi_se_ids,first,last); }
+static bool kiwi_exists_id(int id) { return id_pool_get(&kiwi_ids,id)!=NULL; }
+static bool kiwi_exists_se_id(int id) { return id_pool_get(&kiwi_se_ids,id)!=NULL; }
+static bool kiwi_prepare(int id,struct string *name,struct string *filter,bool streaming)
+{
+	(void)filter; (void)streaming;
+	if (id<0) return false;
+	enum asset_type type; int index=-1;
+	struct archive_data *data=kiwi_asset(name,&type,&index);
+	if (!data) return false;
+	struct channel *ch=kiwi_open(data,type,index,name->text);
+	if (!ch) return false;
+	struct kiwi_sound *s=kiwi_slot(&kiwi_ids,id); kiwi_clear_sound(s); s->channel=ch; s->type=type;
+	return true;
+}
+static bool kiwi_unprepare(int id)
+{
+	struct kiwi_sound *s=id_pool_release(&kiwi_ids,id); if (!s) return false;
+	kiwi_clear_sound(s); free(s); return true;
+}
+static bool kiwi_set_se_param(int id,int span,bool multi)
+{
+	struct kiwi_sound *s=kiwi_slot(&kiwi_se_ids,id); if (!s) return false;
+	s->span=max(0,span); s->multi=multi; return true;
+}
+static bool kiwi_play_se(int id,struct string *name)
+{
+	struct kiwi_sound *s=kiwi_slot(&kiwi_se_ids,id); if (!s) return false;
+	Uint32 now=SDL_GetTicks();
+	if (s->played && now-s->last_play<(unsigned)s->span) return true;
+	enum asset_type type; int index=-1;
+	struct archive_data *data=kiwi_asset(name,&type,&index);
+	if (!data) return false;
+	struct channel *ch=kiwi_open(data,type,index,name->text); if (!ch) return false;
+	if (!s->multi) kiwi_clear_sound(s);
+	else {
+		for (int i=0;i<s->nr_tails;) {
+			if (channel_is_playing(s->tails[i])) { i++; continue; }
+			channel_close(s->tails[i]); s->tails[i]=s->tails[--s->nr_tails];
+		}
+		if (s->channel) {
+			s->tails=xrealloc(s->tails,(s->nr_tails+1)*sizeof(*s->tails));
+			s->tails[s->nr_tails++]=s->channel;
+		}
+	}
+	s->channel=ch; s->type=type; s->last_play=now; s->played=true; return channel_play(ch);
+}
+static bool kiwi_stop_se(int id)
+{
+	struct kiwi_sound *s=id_pool_get(&kiwi_se_ids,id); if (!s) return false;
+	kiwi_clear_sound(s); s->played=false; return true;
+}
+static bool kiwi_is_play_se(int id)
+{
+	struct kiwi_sound *s=id_pool_get(&kiwi_se_ids,id); if (!s) return false;
+	if (s->channel && channel_is_playing(s->channel)) return true;
+	for (int i=0;i<s->nr_tails;i++) if (channel_is_playing(s->tails[i])) return true;
+	return false;
+}
+#define KIWI_CHANNEL_FN(name,fn) static int name(int id) { struct kiwi_sound *s=id_pool_get(&kiwi_ids,id); return s && s->channel ? fn(s->channel) : 0; }
+KIWI_CHANNEL_FN(kiwi_play,channel_play)
+KIWI_CHANNEL_FN(kiwi_stop,channel_stop)
+KIWI_CHANNEL_FN(kiwi_is_play,channel_is_playing)
+KIWI_CHANNEL_FN(kiwi_pause,channel_pause)
+KIWI_CHANNEL_FN(kiwi_restart,channel_restart)
+KIWI_CHANNEL_FN(kiwi_is_pause,channel_is_paused)
+KIWI_CHANNEL_FN(kiwi_get_pos,channel_get_pos)
+KIWI_CHANNEL_FN(kiwi_get_length,channel_get_length)
+KIWI_CHANNEL_FN(kiwi_get_loop_count,channel_get_loop_count)
+KIWI_CHANNEL_FN(kiwi_stop_fade,channel_stop_fade)
+KIWI_CHANNEL_FN(kiwi_is_fade,channel_is_fading)
+KIWI_CHANNEL_FN(kiwi_group,channel_get_group)
+#undef KIWI_CHANNEL_FN
+static bool kiwi_set_loop_count(int id,int count) { struct kiwi_sound *s=id_pool_get(&kiwi_ids,id); return s && s->channel && channel_set_loop_count(s->channel,count); }
+static bool kiwi_seek(int id,int pos) { struct kiwi_sound *s=id_pool_get(&kiwi_ids,id); return s && s->channel && channel_seek(s->channel,pos); }
+static bool kiwi_fade(int id,int time,float volume,bool stop,int type)
+{
+	(void)type; struct kiwi_sound *s=id_pool_get(&kiwi_ids,id);
+	return s && s->channel && channel_fade(s->channel,time,(int)(max(0.0f,min(1.0f,volume))*100),stop);
+}
+static int kiwi_length_file(struct string *name)
+{
+	enum asset_type type; int index=-1; struct archive_data *data=kiwi_asset(name,&type,&index);
+	if (!data) return 0; struct channel *ch=channel_open_archive_data(data,type,index);
+	if (!ch) return 0; int len=channel_get_length(ch); channel_close(ch); return len;
+}
+static bool kiwi_mixer_name(int id,struct string **out)
+{
+	const char *name=mixer_get_name(id); if (!name) return false;
+	free_string(*out); *out=cstr_to_string(name); return true;
+}
+static bool kiwi_mixer_set_name(int id,struct string *name) { return mixer_set_name(id,name->text); }
+static bool kiwi_mixer_default(int id,int *volume)
+{
+	if (id<0 || (unsigned)id>=config.mixer_nr_channels) return false; *volume=config.mixer_volumes[id]; return true;
+}
+static int kiwi_group_file(struct string *name)
+{
+	struct ex_table *t = kiwi_sound_info();
+	int row = kiwi_info_row(t,name->text);
+	int group = kiwi_info_int(t,row,"Group",-1);
+	if (group >= 0) return group;
+	const enum asset_type types[] = {ASSET_BGM,ASSET_SOUND,ASSET_VOICE};
+	for (int i=0; i<3; i++)
+		if (asset_exists_by_name(types[i],name->text,NULL)) return kiwi_default_group(types[i]);
+	return -1;
+}
+static float kiwi_group_volume(int group)
+{
+	int volume = 0;
+	mixer_get_volume(group,&volume);
+	return volume / 100.0f;
+}
+static int kiwi_milliseconds_to_samples(int ms,int rate) { return (int)((int64_t)ms*rate/1000); }
