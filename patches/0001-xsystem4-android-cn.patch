+uint32_t vm_random_seed(void)
+{
+	// Script globals can request random values before main() sets a seed.
+	// Include a sub-second clock and a sequence so cold starts and calls in
+	// the same second do not all initialize the same table.
+	static uint32_t sequence;
+	uint64_t counter = SDL_GetPerformanceCounter();
+	uint32_t seed = (uint32_t)time(NULL) ^ (uint32_t)counter
+		^ (uint32_t)(counter >> 32) ^ (++sequence * 0x9e3779b9u);
+	seed ^= seed >> 16;
+	seed *= 0x7feb352du;
+	seed ^= seed >> 15;
+	return seed | 1u;
+}
