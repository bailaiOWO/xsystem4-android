+/* PartsEngine 2 panels. SPDX-License-Identifier: GPL-2.0-or-later */
+
+void parts_panel_rebuild(struct parts_panel *panel)
+{
+	gfx_delete_texture(&panel->common.texture);
+	int w = panel->common.w, h = panel->common.h;
+	if (w <= 0 || h <= 0) return;
+	if (!panel->gradation[0] && !panel->gradation[1]
+			&& !panel->gradation[2] && !panel->gradation[3]) {
+		// The common rectangle supplies the size; a flat color needs one texel.
+		gfx_init_texture_rgba(&panel->common.texture, 1, 1, panel->color);
+		return;
+	}
+	uint8_t *alpha = xcalloc(w, h);
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			float rate = 1.0f;
+			int distances[] = {y, h - 1 - y, x, w - 1 - x};
+			for (int i = 0; i < 4; i++) {
+				if (panel->gradation[i] > 0)
+					rate = min(rate, distances[i] / (float)panel->gradation[i]);
+			}
+			alpha[(size_t)y * w + x] = panel->color.a * rate;
+		}
+	}
+	gfx_init_texture_amap(&panel->common.texture, w, h, alpha, panel->color);
+	free(alpha);
+}
+
+static struct parts_panel *parts_get_panel(int no)
+{
+	struct parts *p = parts_get(no);
+	if (p->states[0].type != PARTS_PANEL)
+		parts_state_reset(&p->states[0], PARTS_PANEL);
+	return &p->states[0].panel;
+}
