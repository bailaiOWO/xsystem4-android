+static void pa_load_part(struct pa_activity *a, struct ex_tree *tree, int parent, int depth)
+{
+	if (depth > 128) VM_ERROR("Activity layout exceeds nesting limit");
+	int no = PE_GetFreeNumber();
+	PA_AddActivityParts(a->name, tree->name, no);
+	// Ratio coordinates are relative to the game canvas (e.g. y=1 is
+	// the bottom edge), not literal pixel coordinates.
+	bool ratio = pa_number(tree,"座標を率として認識する",-1,0);
+	PE_SetPos(no, pa_number(tree,"座標",0,0) * (ratio ? config.view_width : 1),
