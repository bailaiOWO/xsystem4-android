diff --git a/src/frame_profile.c b/src/frame_profile.c
new file mode 100644
index 0000000..19f897b
--- /dev/null
+++ b/src/frame_profile.c
@@ -0,0 +1,173 @@
+/* Slow-frame profiler; see include/frame_profile.h. */
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <SDL.h>
+#include "system4.h"
+#include "system4/ain.h"
+#include "system4/utfsjis.h"
+#include "frame_profile.h"
+#include "vm.h"
+#include "xsystem4.h"
+
+#define SLOW_FRAME_MS 45
+#define HLL_TOP 3
+
+static const char *names[FP_NR_CATEGORIES] = {
+	[FP_ARCHIVE] = "archive",
+	[FP_CG_DECODE] = "cg",
+	[FP_TEX_UPLOAD] = "tex",
+	[FP_FLAT_LOAD] = "flat",
+	[FP_SOUND_OPEN] = "sound",
+};
+
+static uint64_t totals[FP_NR_CATEGORIES];
+static unsigned counts[FP_NR_CATEGORIES];
+static uint64_t slowest_ticks;
+static enum fp_category slowest_category;
+static char slowest_label[96];
+static uint64_t last_frame_end;
+
+/* Slowest individual HLL calls of the frame, by self+children time. */
+static struct { int libno, fno; uint64_t ticks; unsigned calls; } hll_top[HLL_TOP];
+static uint64_t hll_total;
+
+uint64_t fp_now(void)
+{
+	return SDL_GetPerformanceCounter();
+}
+
+static double ms(uint64_t ticks)
+{
+	return ticks * 1000.0 / SDL_GetPerformanceFrequency();
+}
+
+void fp_add(enum fp_category category, uint64_t start, const char *label)
+{
+	uint64_t spent = fp_now() - start;
+	totals[category] += spent;
+	counts[category]++;
+	if (spent > slowest_ticks) {
+		slowest_ticks = spent;
+		slowest_category = category;
+		if (label) {
+			char *display = sjis2utf_gbk(label, strlen(label));
+			strncpy(slowest_label, display, sizeof(slowest_label) - 1);
+			slowest_label[sizeof(slowest_label) - 1] = '\0';
+			free(display);
+		} else {
+			slowest_label[0] = '\0';
+		}
+	}
+}
+
+/* Frame loop entry points: they contain everything else and would always top
+ * the list. TRANS_Update is kept, since it is a candidate cost itself. */
+static bool hll_is_frame_loop(int libno, int fno)
+{
+	const char *name = ain->libraries[libno].functions[fno].name;
+	return !strcmp(name, "Update") || !strcmp(name, "Sleep")
+		|| !strcmp(name, "UpdateView") || !strcmp(name, "UpdateComponent");
+}
+
+void fp_add_hll(int libno, int fno, uint64_t start)
+{
+	if (hll_is_frame_loop(libno, fno))
+		return;
+	uint64_t spent = fp_now() - start;
+	hll_total += spent;
+	/* Merge repeated calls of the same function within the frame. */
+	for (int i = 0; i < HLL_TOP; i++) {
+		if (hll_top[i].calls && hll_top[i].libno == libno && hll_top[i].fno == fno) {
+			hll_top[i].ticks += spent;
+			hll_top[i].calls++;
+			goto sort;
+		}
+	}
+	{
+		int smallest = 0;
+		for (int i = 1; i < HLL_TOP; i++)
+			if (hll_top[i].ticks < hll_top[smallest].ticks) smallest = i;
+		if (spent <= hll_top[smallest].ticks && hll_top[smallest].calls)
+			return;
+		hll_top[smallest].libno = libno;
+		hll_top[smallest].fno = fno;
+		hll_top[smallest].ticks = spent;
+		hll_top[smallest].calls = 1;
+	}
+sort:
+	for (int i = 1; i < HLL_TOP; i++) {
+		for (int j = i; j > 0 && hll_top[j].ticks > hll_top[j - 1].ticks; j--) {
+			typeof(hll_top[0]) t = hll_top[j];
+			hll_top[j] = hll_top[j - 1];
+			hll_top[j - 1] = t;
+		}
+	}
+}
+
+static void reset(uint64_t now)
+{
+	memset(totals, 0, sizeof(totals));
+	memset(counts, 0, sizeof(counts));
+	memset(hll_top, 0, sizeof(hll_top));
+	hll_total = 0;
+	slowest_ticks = 0;
+	slowest_label[0] = '\0';
+	last_frame_end = now;
+}
+
+static void report(const char *kind, uint64_t now, int events_ms, int render_ms, int present_ms)
+{
+	if (!last_frame_end)
+		return;
+	double frame = ms(now - last_frame_end);
+	if (frame < SLOW_FRAME_MS)
+		return;
+	char buf[768];
+	int n = snprintf(buf, sizeof(buf), "%s %.0fms", kind, frame);
+	if (events_ms >= 0)
+		n += snprintf(buf + n, sizeof(buf) - n, " events=%d render=%d present=%d",
+				events_ms, render_ms, present_ms);
+	for (int i = 0; i < FP_NR_CATEGORIES && n < (int)sizeof(buf); i++) {
+		if (counts[i])
+			n += snprintf(buf + n, sizeof(buf) - n, " %s=%.1fms/%u",
+					names[i], ms(totals[i]), counts[i]);
+	}
+	if (slowest_ticks && n < (int)sizeof(buf))
+		n += snprintf(buf + n, sizeof(buf) - n, " slowest=%s %.1fms %s",
+				names[slowest_category], ms(slowest_ticks), slowest_label);
+	for (int i = 0; i < HLL_TOP && n < (int)sizeof(buf); i++) {
+		if (!hll_top[i].calls || ms(hll_top[i].ticks) < 2.0)
+			continue;
+		struct ain_library *lib = &ain->libraries[hll_top[i].libno];
+		n += snprintf(buf + n, sizeof(buf) - n, " hll=%s.%s %.1fms/%u",
+				lib->name, lib->functions[hll_top[i].fno].name,
+				ms(hll_top[i].ticks), hll_top[i].calls);
+	}
+	NOTICE("%s", buf);
+}
+
+void fp_frame_end(uint32_t events_ms, uint32_t render_ms, uint32_t present_ms)
+{
+	uint64_t now = fp_now();
+	report("SLOWFRAME", now, events_ms, render_ms, present_ms);
+	reset(now);
+}
+
+static bool in_main_loop_swap;
+
+void fp_swap(void)
+{
+	/* sact_Update reports its own swap with phase timings. */
+	if (in_main_loop_swap)
+		return;
+	uint64_t now = fp_now();
+	report("SLOWSWAP", now, -1, -1, -1);
+	reset(now);
+}
+
+void fp_main_loop_swap(bool active)
+{
+	in_main_loop_swap = active;
+}
