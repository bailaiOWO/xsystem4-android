+	iarray_write_float(w, flat->fps_rate);
+	iarray_write(w, flat->pending_seek_delta);
+	save_flat_layer(w, flat->root_state);
+	int proxies = 0;
+	for (size_t i = 0; i < flat->nr_libraries; i++)
+		if (flat->proxy_names && flat->proxy_names[i]) proxies++;
+	iarray_write(w, proxies);
+	for (size_t i = 0; i < flat->nr_libraries; i++) {
+		if (!flat->proxy_names || !flat->proxy_names[i]) continue;
+		iarray_write_string(w, flat->flat->libraries[i].name);
+		iarray_write_string(w, flat->proxy_names[i]);
+	}
 }
 
