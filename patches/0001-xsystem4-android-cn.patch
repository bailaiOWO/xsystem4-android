+void PE_SetMessageWindowTextSpeed(int no,int speed)
+{
+	struct parts *p = parts_get(no);
+	struct parts_message_window *m = parts_message_get(p);
+	speed = max(0, speed);
+	if (m->speed == speed) return;
+
+	// Count glyphs, not source bytes: tags, wrapping and multibyte characters
+	// must not move the already revealed prefix when the timeline changes.
+	bool fixed = m->source->size && m->elapsed >= m->duration;
+	size_t revealed = 0;
+	int old_last = 0, old_next = m->duration;
+	int elapsed = min(max(0, m->elapsed), m->duration);
+	for (unsigned i = 0; i < m->text.nr_lines; i++) {
+		struct parts_text_line *line = &m->text.lines[i];
+		for (int j = 0; j < line->nr_chars; j++) {
+			int at = line->chars[j].show_at;
+			if (at <= elapsed) {
+				revealed++;
+				old_last = at;
+			} else {
+				old_next = min(old_next, at);
+			}
+		}
+	}
+	m->speed = speed;
+	parts_message_rebuild(p);
+	if (fixed) {
+		m->elapsed = m->duration;
+		return;
+	}
+
+	size_t index = 0;
+	int new_last = 0, new_next = m->duration;
+	for (unsigned i = 0; i < m->text.nr_lines; i++) {
+		struct parts_text_line *line = &m->text.lines[i];
+		for (int j = 0; j < line->nr_chars; j++) {
+			int at = line->chars[j].show_at;
+			if (index++ < revealed)
+				new_last = at;
+			else
+				new_next = min(new_next, at);
+		}
+	}
+	// Retain fractional progress through the pending interval. Explicit time
+	// scopes use their rebuilt deadlines, not the base-speed ratio. Zero
+	// intervals still reveal together; an empty source leaves elapsed at zero.
+	int progress = 0;
+	if (old_next > old_last)
+		progress = (long long)(elapsed - old_last) * (new_next - new_last)
+			/ (old_next - old_last);
+	m->elapsed = new_last + min(progress, m->duration - new_last);
+}
+int PE_GetMessageWindowTextSpeed(int no) { return MW(no)->speed; }
+void PE_SetMessageWindowTextSpace(int no,int letter,int line) { struct parts_text *t=&MW(no)->text; t->ts.font_spacing=letter; t->line_space=line; parts_message_rebuild(parts_get(no)); }
+void PE_GetMessageWindowTextSpace(int no,int *letter,int *line) { struct parts_text *t=&MW(no)->text; *letter=t->ts.font_spacing; *line=t->line_space; }
