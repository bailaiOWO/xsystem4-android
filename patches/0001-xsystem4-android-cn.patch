+
+/*
+ * 内置修改器：按名字读写 AIN 全局变量。
+ *
+ * 为什么不走 SpoilerAL 那套 SSG（内存地址）：
+ *   SSG 是针对 Windows 原版进程的绝对地址（0x400000 之类），而 xsystem4 是重写
+ *   的引擎，内存布局与原版无关。但 System4 游戏的 AIN 里有**带符号名的全局变量
+ *   表**（每个游戏自带），所以直接按名字读写 VM 全局变量即可 —— 一套实现覆盖
+ *   全系列（兰斯 6/7/8/9/10、战兰、大番长……），且变量名跨次运行稳定，
+ *   查到一次就能存成预设。
+ *
+ * 线程说明：VM 跑在 SDL 原生线程，UI 在 Android 主线程。这里只放行
+ * int/bool/enum/long/float 这类 4 字节标量 —— 单次读写是原子的，最坏情况是
+ * 游戏读到上一帧的旧值（无害）。字符串、结构体、数组涉及堆引用计数，
+ * 跨线程改会破坏堆，一律只读展示、不允许写。
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "system4.h"
+#include "system4/ain.h"
+
+#include "cJSON.h"
+#include "vm.h"
+#include "vm/heap.h"
+#include "vm/page.h"
+#include "xsystem4.h"
+
+#define CHEAT_MAX_ITEMS 400
+
+/* 不区分大小写的子串匹配（不依赖 strcasestr / _GNU_SOURCE） */
+static bool contains_ci(const char *hay, const char *needle)
+{
+	if (!hay || !needle || !*needle)
+		return false;
+	for (; *hay; hay++) {
+		const char *h = hay, *n = needle;
+		while (*h && *n) {
+			char a = *h, b = *n;
+			if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+			if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+			if (a != b)
+				break;
+			h++;
+			n++;
+		}
+		if (!*n)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * 把字符串就地清洗成 JNI 能接受的 Modified UTF-8。
+ *
+ * 游戏里的变量名是 SJIS/GBK 字节，直接交给 NewStringUTF 会让 CheckJNI 检测到
+ * 非法 UTF-8 并以 SIGABRT 杀掉进程（实测闪退就是这个原因）。这里把非法字节
+ * 换成 '?'，同时把 4 字节序列（Modified UTF-8 不支持）也降级成 '?'。
+ */
+static void sanitize_for_jni(char *s)
+{
+	unsigned char *p = (unsigned char *)s;
+	unsigned char *o = p;
+
+	while (*p) {
+		unsigned char c = *p;
+		int len;
+		if (c < 0x80) {
+			len = 1;
+		} else if ((c & 0xE0) == 0xC0) {
+			len = (c < 0xC2) ? 0 : 2;   /* C0/C1 是过长编码，非法 */
+		} else if ((c & 0xF0) == 0xE0) {
+			len = 3;
+		} else {
+			len = 0;                    /* 4 字节序列或非法首字节 */
+		}
+
+		bool ok = len > 0;
+		for (int i = 1; ok && i < len; i++) {
+			if ((p[i] & 0xC0) != 0x80)
+				ok = false;
+		}
+		if (!ok) {
+			*o++ = '?';
+			p++;
+			continue;
+		}
+		for (int i = 0; i < len; i++)
+			*o++ = *p++;
+	}
+	*o = '\0';
+}
+
+/* 数值扫描的模式 */
+#define SCAN_MODE_FIRST     0   /* 首次搜索（全部变量） */
+#define SCAN_MODE_NEXT      1   /* 再次搜索（在结果里缩小） */
+#define SCAN_MODE_CHANGED   2   /* 值变化了 */
+#define SCAN_MODE_UNCHANGED 3   /* 值没变 */
+#define SCAN_MODE_INCREASED 4   /* 值增加了 */
+#define SCAN_MODE_DECREASED 5   /* 值减少了 */
+#define SCAN_MODE_LIST      6   /* 只取回当前结果（面板重新打开时用） */
+
+static bool type_editable(enum ain_data_type t)
+{
+	switch (t) {
+	case AIN_INT:
+	case AIN_FLOAT:
+	case AIN_BOOL:
+	case AIN_LONG_INT:
+	case AIN_ENUM:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* 只读展示用的简短说明 */
+static const char *type_hint(enum ain_data_type t)
+{
+	switch (t) {
+	case AIN_STRING:      return "(字符串)";
+	case AIN_STRUCT:      return "(结构体)";
+	case AIN_ARRAY_INT:
+	case AIN_ARRAY_FLOAT:
+	case AIN_ARRAY_STRING:
+	case AIN_ARRAY_STRUCT:
+	case AIN_ARRAY_BOOL:
+	case AIN_ARRAY:       return "(数组)";
+	case AIN_DELEGATE:    return "(委托)";
+	default:              return "(不可编辑)";
+	}
+}
+
+static void value_to_string(int i, char *buf, size_t size)
+{
+	union vm_value v = heap[0].page->values[i];
+	switch (ain->globals[i].type.data) {
+	case AIN_INT:
+	case AIN_BOOL:
+	case AIN_ENUM:
+	case AIN_LONG_INT:
+		snprintf(buf, size, "%d", v.i);
+		break;
+	case AIN_FLOAT:
+		snprintf(buf, size, "%g", v.f);
+		break;
+	default:
+		snprintf(buf, size, "%s", type_hint(ain->globals[i].type.data));
+		break;
+	}
+}
+
+static bool name_matches(struct ain_variable *var, const char *filter)
+{
+	if (!filter || !*filter)
+		return true;
+	if (contains_ci(var->name, filter))
+		return true;
+	/* ain v12+ 每个变量还带一个别名（name2），也一起匹配 */
+	if (var->name2 && *var->name2 && contains_ci(var->name2, filter))
+		return true;
+	return false;
+}
+
+/* 列出全局变量。返回 malloc 的 JSON 字符串，调用方负责 free。 */
+static char *cheat_list(int offset, int limit, const char *filter)
+{
+	cJSON *root = cJSON_CreateObject();
+	cJSON *items = cJSON_AddArrayToObject(root, "items");
+	int matched = 0, emitted = 0;
+
+	if (!ain || !heap[0].page) {
+		cJSON_AddBoolToObject(root, "ok", false);
+		cJSON_AddStringToObject(root, "error", "游戏还没启动");
+		goto done;
+	}
+	if (limit <= 0 || limit > CHEAT_MAX_ITEMS)
+		limit = 200;
+
+	for (int i = 0; i < ain->nr_globals; i++) {
+		if (!name_matches(&ain->globals[i], filter))
+			continue;
+		if (matched++ < offset)
+			continue;
+		if (emitted++ >= limit)
+			continue;
+
+		cJSON *o = cJSON_CreateObject();
+		char buf[64];
+		cJSON_AddNumberToObject(o, "i", i);
+		cJSON_AddStringToObject(o, "name", ain->globals[i].name ? ain->globals[i].name : "?");
+		if (ain->globals[i].name2 && *ain->globals[i].name2)
+			cJSON_AddStringToObject(o, "alias", ain->globals[i].name2);
+		char *tn = ain_strtype_d(ain, &ain->globals[i].type);
+		cJSON_AddStringToObject(o, "type", tn ? tn : "?");
+		free(tn);
+		value_to_string(i, buf, sizeof(buf));
+		cJSON_AddStringToObject(o, "value", buf);
+		cJSON_AddBoolToObject(o, "editable",
+				      type_editable(ain->globals[i].type.data));
+		cJSON_AddItemToArray(items, o);
+	}
+
+	cJSON_AddBoolToObject(root, "ok", true);
+	cJSON_AddNumberToObject(root, "total", ain->nr_globals);
+	cJSON_AddNumberToObject(root, "matched", matched);
+	cJSON_AddNumberToObject(root, "offset", offset);
+done:;
+	char *out = cJSON_PrintUnformatted(root);
+	cJSON_Delete(root);
+	return out;
+}
+
+/* 按索引写值。value 是十进制文本（int/float 都走这里）。 */
+static bool cheat_set(int index, const char *value)
+{
+	if (!ain || !heap[0].page)
+		return false;
+	if (index < 0 || index >= ain->nr_globals)
+		return false;
+
+	struct ain_variable *var = &ain->globals[index];
+	if (!type_editable(var->type.data))
+		return false;
+
+	union vm_value v = { .i = 0 };
+	char *end = NULL;
+	switch (var->type.data) {
+	case AIN_FLOAT:
+		v.f = strtof(value, &end);
+		break;
+	default:
+		v.i = (int32_t)strtol(value, &end, 10);
+		break;
+	}
+	if (end == value)
+		return false;            /* 不是合法数字 */
+
+	/* 数值类型没有析构，call_dtors 传 false 更稳妥 */
+	global_set(index, v, false);
+	NOTICE("CHEAT set %s = %s", var->name ? var->name : "?", value);
+	return true;
+}
+
+
+/* ======================================================================
+ * 数值扫描（Cheat Engine 式：首搜 -> 游戏里改变数值 -> 再搜 -> 缩小 -> 改）
+ *
+ * 和 CE 的区别：CE 扫裸内存（结果是 0x7FF... 地址），这里扫 VM 全局变量表，
+ * 所以结果是"变量名 + 类型"，跨次运行稳定，也写不错内存。
+ * 引擎侧保存上次结果，所以关掉面板再打开还能接着"再搜"。
+ * ====================================================================== */
+
+#define CHEAT_SCAN_MAX   4000    /* 首搜最多保留多少条 */
+#define CHEAT_SCAN_SHOWN 120     /* 每次回给界面多少条 */
+
+struct scan_entry {
+	int index;
+	double prev;
+};
+
+static struct scan_entry scan_results[CHEAT_SCAN_MAX];
+static int scan_count;
+static bool scan_started;
+
+static double global_value(int i)
+{
+	union vm_value v = heap[0].page->values[i];
+	if (ain->globals[i].type.data == AIN_FLOAT)
+		return (double)v.f;
+	return (double)v.i;
+}
+
+static bool value_matches(int i, double target)
+{
+	double v = global_value(i);
+	if (ain->globals[i].type.data == AIN_FLOAT)
+		return v == target;
+	return (long long)v == (long long)target;
+}
+
+/* 首次搜索：在所有数值型全局变量里找等于 target 的 */
+static void scan_start(double target)
+{
+	scan_count = 0;
+	scan_started = true;
+	for (int i = 0; i < ain->nr_globals && scan_count < CHEAT_SCAN_MAX; i++) {
+		if (!type_editable(ain->globals[i].type.data))
+			continue;
+		if (value_matches(i, target)) {
+			scan_results[scan_count].index = i;
+			scan_results[scan_count].prev = global_value(i);
+			scan_count++;
+		}
+	}
+}
+
+/* 再次搜索：只在上一批结果里筛等于 target 的 */
+static void scan_refine(double target)
+{
+	int n = 0;
+	for (int k = 0; k < scan_count; k++) {
+		int i = scan_results[k].index;
+		if (value_matches(i, target)) {
+			scan_results[n].index = i;
+			scan_results[n].prev = global_value(i);
+			n++;
+		}
+	}
+	scan_count = n;
+}
+
+/*
+ * 不带数值的筛选。同时也是刷新 prev 的地方：每次筛完都把当前值记成新基准，
+ * 所以"值变化了"这类操作可以连着点。
+ */
+static void scan_filter(int mode)
+{
+	int n = 0;
+	for (int k = 0; k < scan_count; k++) {
+		int i = scan_results[k].index;
+		double v = global_value(i);
+		double p = scan_results[k].prev;
+		bool keep;
+		switch (mode) {
+		case SCAN_MODE_CHANGED:   keep = v != p; break;
+		case SCAN_MODE_UNCHANGED: keep = v == p; break;
+		case SCAN_MODE_INCREASED: keep = v > p; break;
+		default:                  keep = v < p; break;
+		}
+		if (keep) {
+			scan_results[n].index = i;
+			scan_results[n].prev = v;
+			n++;
+		}
+	}
+	scan_count = n;
+}
+
+static char *scan_result_json(void)
+{
+	cJSON *root = cJSON_CreateObject();
+	cJSON *items = cJSON_AddArrayToObject(root, "items");
+	int shown = scan_count < CHEAT_SCAN_SHOWN ? scan_count : CHEAT_SCAN_SHOWN;
+
+	for (int k = 0; k < shown; k++) {
+		int i = scan_results[k].index;
+		char buf[64];
+		cJSON *o = cJSON_CreateObject();
+		cJSON_AddNumberToObject(o, "i", i);
+		cJSON_AddStringToObject(o, "name",
+			ain->globals[i].name ? ain->globals[i].name : "?");
+		char *tn = ain_strtype_d(ain, &ain->globals[i].type);
+		cJSON_AddStringToObject(o, "type", tn ? tn : "?");
+		free(tn);
+		value_to_string(i, buf, sizeof(buf));
+		cJSON_AddStringToObject(o, "value", buf);
+		cJSON_AddBoolToObject(o, "editable", true);
+		cJSON_AddItemToArray(items, o);
+	}
+
+	cJSON_AddBoolToObject(root, "ok", true);
+	cJSON_AddNumberToObject(root, "count", scan_count);
+	cJSON_AddNumberToObject(root, "shown", shown);
+	cJSON_AddBoolToObject(root, "started", scan_started);
+	char *out = cJSON_PrintUnformatted(root);
+	cJSON_Delete(root);
+	return out;
+}
+
+/* 统一的扫描入口；返回 malloc 的 JSON */
+static char *cheat_scan_do(const char *value, int mode)
+{
+	if (!ain || !heap[0].page) {
+		cJSON *r = cJSON_CreateObject();
+		cJSON_AddBoolToObject(r, "ok", false);
+		cJSON_AddStringToObject(r, "error", "游戏还没启动");
+		char *s = cJSON_PrintUnformatted(r);
+		cJSON_Delete(r);
+		return s;
+	}
+
+	char *end = NULL;
+	double target = value ? strtod(value, &end) : 0;
+	bool has_value = value && end && end != value;
+
+	switch (mode) {
+	case SCAN_MODE_FIRST:
+		if (!has_value) goto bad_value;
+		scan_start(target);
+		break;
+	case SCAN_MODE_LIST:
+		break;
+	case SCAN_MODE_NEXT:
+		if (!has_value) goto bad_value;
+		scan_refine(target);
+		break;
+	default:
+		scan_filter(mode);
+		break;
+	}
+	return scan_result_json();
+
+bad_value:;
+	cJSON *r = cJSON_CreateObject();
+	cJSON_AddBoolToObject(r, "ok", false);
+	cJSON_AddStringToObject(r, "error", "请输入一个数值");
+	char *s = cJSON_PrintUnformatted(r);
+	cJSON_Delete(r);
+	return s;
+}
+
+#ifdef __ANDROID__
+#include <jni.h>
+
+/* 全局变量总数（游戏未启动时为 0） */
+JNIEXPORT jint JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeCheatCount(
+	JNIEnv *env, jobject thiz)
+{
+	(void)env;
+	(void)thiz;
+	return (ain && heap[0].page) ? ain->nr_globals : 0;
+}
+
+/* 列出/搜索全局变量，返回 JSON 文本 */
+JNIEXPORT jstring JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeCheatList(
+	JNIEnv *env, jobject thiz, jint offset, jint limit, jstring filter)
+{
+	(void)thiz;
+	const char *f = filter ? (*env)->GetStringUTFChars(env, filter, NULL) : NULL;
+	char *json = cheat_list(offset, limit, f);
+	if (f)
+		(*env)->ReleaseStringUTFChars(env, filter, f);
+	if (json)
+		sanitize_for_jni(json);
+	jstring ret = (*env)->NewStringUTF(env, json ? json : "{\"ok\":false}");
+	free(json);
+	return ret;
+}
+
+/* 按索引设值；value 为十进制文本 */
+JNIEXPORT jboolean JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeCheatSet(
+	JNIEnv *env, jobject thiz, jint index, jstring value)
+{
+	(void)thiz;
+	if (!value)
+		return JNI_FALSE;
+	const char *v = (*env)->GetStringUTFChars(env, value, NULL);
+	bool ok = cheat_set(index, v);
+	(*env)->ReleaseStringUTFChars(env, value, v);
+	return ok ? JNI_TRUE : JNI_FALSE;
+}
+/* 数值扫描：mode 见上面的 SCAN_MODE_* 定义 */
+JNIEXPORT jstring JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeCheatScan(
+	JNIEnv *env, jobject thiz, jstring value, jint mode)
+{
+	(void)thiz;
+	const char *v = value ? (*env)->GetStringUTFChars(env, value, NULL) : NULL;
+	char *json = cheat_scan_do(v, (int)mode);
+	if (v)
+		(*env)->ReleaseStringUTFChars(env, value, v);
+	if (json)
+		sanitize_for_jni(json);
+	jstring ret = (*env)->NewStringUTF(env, json ? json : "{\"ok\":false}");
+	free(json);
+	return ret;
+}
+
+/* 清空扫描状态（界面上的"重新开始"） */
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeCheatResetScan(
