+/* A card's many construction operations repeatedly read the same border,
+ * portrait and badge CGs. Cache immutable source textures, never the composed
+ * card, so changing its stats still produces the correct result. */
+static struct construction_source { struct string *name; Texture texture; unsigned used; } construction_sources[96];
+static unsigned construction_clock;
+static size_t construction_bytes;
+static void construction_source_drop(int i)
+{
+	struct construction_source *s=&construction_sources[i];
+	construction_bytes-=(size_t)s->texture.w*s->texture.h*4;
+	gfx_delete_texture(&s->texture);
+	if (s->name) free_string(s->name);
+	memset(s,0,sizeof(*s));
+}
+void parts_construction_cache_clear(void)
+{
+	for (int i=0;i<96;i++) construction_source_drop(i);
+}
+static Texture *construction_source(struct string *name)
+{
+	int slot=0;
+	for (int i=0;i<96;i++) {
+		struct construction_source *s=&construction_sources[i];
+		if (s->name && !strcmp(s->name->text,name->text)) { s->used=++construction_clock; return &s->texture; }
+		if (s->used < construction_sources[slot].used) slot=i;
+	}
+	struct cg *cg=asset_cg_load_by_name(name->text,NULL);
+	if (!cg) return NULL;
+	construction_source_drop(slot);
+	struct construction_source *s=&construction_sources[slot];
+	s->name=string_dup(name); s->used=++construction_clock;
+	gfx_init_texture_with_cg(&s->texture,cg); cg_free(cg);
+	construction_bytes+=(size_t)s->texture.w*s->texture.h*4;
+	while (construction_bytes>64u*1024*1024) {
+		int oldest=-1;
+		for (int i=0;i<96;i++)
+			if (i!=slot && construction_sources[i].name &&
+				(oldest<0 || construction_sources[i].used<construction_sources[oldest].used)) oldest=i;
+		if (oldest<0) break;
+		construction_source_drop(oldest);
+	}
+	return &s->texture;
+}
 
