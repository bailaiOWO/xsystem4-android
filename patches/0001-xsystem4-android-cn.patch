+bool RE_plugin_load_light_scattering(struct RE_plugin *plugin, const char *filename)
+{
+	struct archive_data *entry = archive_get_by_name(plugin->aar, filename);
+	size_t size = 0;
+	uint8_t *owned = NULL;
+	const uint8_t *data;
+	if (entry) {
+		data = entry->data;
+		size = entry->size;
+	} else {
+		char *path = gamedir_path(filename);
+		owned = file_read(path, &size);
+		free(path);
+		data = owned;
+	}
+	// Original LS0: NUL-terminated magic, version, fog type, then 18 floats.
+	// Missing optional settings retain the script's default parameters.
+	bool ok = false;
+	if (!data || size < 12 + 18 * 4 || memcmp(data, "LS0\0", 4)
+			|| LittleEndian_getDW(data, 4) != 0)
+		goto out;
+	float values[18];
+	for (int i = 0; i < 18; i++) {
+		uint32_t bits = LittleEndian_getDW(data, 12 + i * 4);
+		memcpy(&values[i], &bits, sizeof(float));
+		if (!isfinite(values[i]))
+			goto out;
+	}
+	if (!RE_plugin_set_fog_type(plugin, LittleEndian_getDW(data, 8)))
+		goto out;
+	plugin->fog_near = values[0];
+	plugin->fog_far = values[1];
+	glm_vec3_copy(values + 2, plugin->fog_color);
+	plugin->ls_beta_r = values[5];
+	plugin->ls_beta_m = values[6];
+	plugin->ls_g = values[7];
+	plugin->ls_distance = values[8];
+	glm_vec3_copy(values + 9, plugin->ls_light_dir);
+	plugin->ls_light_dir[2] = -plugin->ls_light_dir[2];
+	glm_vec3_copy(values + 12, plugin->ls_light_color);
+	glm_vec3_copy(values + 15, plugin->ls_sun_color);
+	ok = true;
+out:
+	if (entry)
+		archive_free_data(entry);
+	free(owned);
+	return ok;
+}
