diff --git a/include/frame_profile.h b/include/frame_profile.h
new file mode 100644
index 0000000..e8ff439
--- /dev/null
+++ b/include/frame_profile.h
@@ -0,0 +1,36 @@
+/* Slow-frame profiler: attributes long frames to asset and GPU work.
+ *
+ * Instrumented sections add their wall time to per-frame counters; the
+ * frame loop logs a breakdown when a frame exceeds the threshold. Sections
+ * may nest (a Flat load includes its CG decodes and texture uploads).
+ */
+
+#ifndef SYSTEM4_FRAME_PROFILE_H
+#define SYSTEM4_FRAME_PROFILE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum fp_category {
+	FP_ARCHIVE,
+	FP_CG_DECODE,
+	FP_TEX_UPLOAD,
+	FP_FLAT_LOAD,
+	FP_SOUND_OPEN,
+	FP_NR_CATEGORIES
+};
+
+uint64_t fp_now(void);
+/* label may be NULL; it names the slowest item of the frame. */
+void fp_add(enum fp_category category, uint64_t start, const char *label);
+/* Records time spent in one HLL library call (frame loop calls excluded). */
+void fp_add_hll(int libno, int fno, uint64_t start);
+/* Called once per presented engine frame with the frame loop's own phases. */
+void fp_frame_end(uint32_t events_ms, uint32_t render_ms, uint32_t present_ms);
+/* Called at every buffer swap; closes frames presented outside the main loop
+ * (transition effects, movies), which otherwise merge into one long frame. */
+void fp_swap(void);
+/* Marks swaps made by the main frame loop, which reports its own frames. */
+void fp_main_loop_swap(bool active);
+
+#endif /* SYSTEM4_FRAME_PROFILE_H */
