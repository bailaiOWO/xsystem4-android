+	for (int a = 0; a < MAX_ARCHIVES && manager->archives[a]; a++) {
+		struct afa_archive *ar = manager->archives[a];
+		for (unsigned i = 0; i < ar->nr_files; i++) {
+			struct string *title = string_dup(ar->files[i].name);
+			char *dot = strrchr(title->text, '.');
+			if (dot) { *dot = 0; title->size = dot - title->text; }
+			bool match = mode == 1 ? !strncmp(title->text, query, query_len)
+				: mode == 2 ? (query_len <= (size_t)title->size &&
+					!strcmp(title->text + title->size - query_len, query))
+				: strstr(title->text, query) != NULL;
