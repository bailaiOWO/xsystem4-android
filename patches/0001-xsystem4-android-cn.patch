+static void pa_load_numeral(int no, struct ex_tree *state, int index)
+{
+	struct string *cg = pa_string(state,"ＣＧ名");
+	int mode = pa_number(state,"表示类型",-1,0);
+	if (mode == 2) {
+		PE_SetNumeralFont(no,pa_number(state,"字体类型",-1,0),pa_number(state,"字体尺寸",-1,16),
+			pa_number(state,"字体色",0,255),pa_number(state,"字体色",1,255),pa_number(state,"字体色",2,255),
+			pa_number(state,"字体粗度",-1,0),pa_number(state,"字体镶边色",0,0),
+			pa_number(state,"字体镶边色",1,0),pa_number(state,"字体镶边色",2,0),pa_number(state,"字体镶边",-1,0),index);
+	} else if (mode == 1 && cg->size) {
+		int w[12];
+		for (int i=0;i<12;i++) w[i]=pa_number(state,"幅リスト",i,0);
+		PE_SetNumeralLinkedCGNumberWidthWidthList(no,cg,w[0],w[1],w[2],w[3],w[4],w[5],
+			w[6],w[7],w[8],w[9],w[10],w[11],index);
+	} else if (cg->size) PE_SetNumeralCG(no,cg,index);
+	PE_SetNumeralSpace(no,pa_number(state,"字间距",-1,0),index);
+	PE_SetNumeralShowComma(no,pa_number(state,"コンマ表示",-1,0),index);
+	PE_SetNumeralLength(no,pa_number(state,"ゼロパディング",-1,1) ? pa_number(state,"桁数",-1,0) : 0,index);
+	PE_SetNumeralNumber(no,pa_number(state,"数值",-1,0),index);
+}
+
+static void pa_load_construction(int no, struct ex_tree *state, int index)
+{
+	PE_ClearPartsConstructionProcess(no,index);
+	struct ex_tree *list = pa_child(state,"手順リスト");
+	if (!list || list->is_leaf) return;
+	for (unsigned i=0;i<list->nr_children;i++) {
+		struct ex_tree *step = &list->children[i];
+		union vm_value ints[34] = {0}, floats[2] = {0};
+		ints[0].i=no; ints[1].i=index;
+		ints[2].i=pa_number(step,"コマンド",-1,0);
+		ints[3].i=pa_number(step,"补间类型",-1,0);
+		for(int j=0;j<4;j++) ints[4+j].i=pa_number(step,"原矩形",j,0);
+		for(int j=0;j<6;j++) ints[8+j].i=pa_number(step,"先矩形",j,0);
+		for(int j=0;j<4;j++) {
+			ints[14+j].i=pa_number(step,"色１",j,0);
+			ints[18+j].i=pa_number(step,"色２",j,0);
+		}
+		ints[22].i=pa_number(step,"文字间距",-1,0);
+		ints[23].i=pa_number(step,"行间距",-1,0);
+		ints[24].i=pa_number(step,"字体类型",-1,0);
+		ints[25].i=pa_number(step,"字体尺寸",-1,16);
+		for(int j=0;j<3;j++) {
+			ints[26+j].i=pa_number(step,"字体色",j,255);
+			ints[29+j].i=pa_number(step,"字体镶边色",j,0);
+		}
+		ints[32].i=pa_number(step,"全体",-1,0);
+		ints[33].i=pa_number(step,"ブラー",-1,0);
+		floats[0].f=pa_number(step,"字体粗度",-1,0);
+		floats[1].f=pa_number(step,"字体镶边",-1,0);
+		PartsEngine_add_construction_process(ints,floats,pa_string(step,"文本"),pa_string(step,"ＣＧ名"));
+	}
+	PE_BuildPartsConstructionProcess(no,index);
+}
