+static void save_flat_layer(struct iarray_writer *w, struct flat_layer_state *s)
+{
+	iarray_write(w, s != NULL);
+	if (!s) return;
+	iarray_write(w, s->current_frame);
+	iarray_write(w, s->stopped);
+	iarray_write(w, s->suppress_advance);
+	iarray_write(w, s->jump_target);
+	iarray_write(w, s->nr_timelines);
+	for (size_t i = 0; i < s->nr_timelines; i++) {
+		iarray_write(w, s->last_script_keys[i]);
+		save_flat_layer(w, s->children[i]);
+	}
+}
+
+static struct flat_layer_state *load_flat_layer(struct iarray_reader *r, int depth)
+{
+	if (!iarray_read(r) || r->error) return NULL;
+	if (depth > 128) { r->error = 1; return NULL; }
+	int frame = iarray_read(r), stopped = iarray_read(r);
+	int suppress = iarray_read(r), jump = iarray_read(r), count = iarray_read(r);
+	if (r->error || count < 0 || (unsigned)count > (r->size - r->pos) / 2) {
+		r->error = 1; return NULL;
+	}
+	struct flat_layer_state *s = flat_layer_state_new(count);
+	s->current_frame = frame; s->stopped = stopped;
+	s->suppress_advance = suppress; s->jump_target = jump;
+	for (int i = 0; i < count && !r->error; i++) {
+		s->last_script_keys[i] = iarray_read(r);
+		s->children[i] = load_flat_layer(r, depth + 1);
+	}
+	if (r->error) { flat_layer_state_free(s); return NULL; }
+	return s;
+}
+
+static bool flat_layer_matches(struct flat *f, struct flat_layer_state *s,
+		struct flat_timeline *timelines, size_t count)
+{
+	if (!s || s->nr_timelines != count) return false;
+	for (size_t i = 0; i < count; i++) {
+		if (!s->children[i]) continue;
+		int index = parts_flat_find_library(f, timelines[i].library_name->text);
+		if (index < 0 || f->libraries[index].type != FLAT_LIB_TIMELINE) return false;
+		struct flat_library *lib = &f->libraries[index];
+		if (!flat_layer_matches(f, s->children[i], lib->timeline.timelines,
+				lib->timeline.nr_timelines)) return false;
+	}
+	return true;
+}
+
