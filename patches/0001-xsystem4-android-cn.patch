diff --git a/src/hll/MainEXFileNew.inc b/src/hll/MainEXFileNew.inc
new file mode 100644
index 0000000..7093ddd
--- /dev/null
+++ b/src/hll/MainEXFileNew.inc
@@ -0,0 +1,227 @@
+/* Name-based MainEXFile ABI used by AIN 11+. Included after the legacy API.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+static struct ex **ex_readers;
+static int nr_ex_readers;
+
+static struct ex *MainEXNew_Reader(int id)
+{
+	if (!id) return ex;
+	return id > 0 && id <= nr_ex_readers ? ex_readers[id - 1] : NULL;
+}
+
+static int MainEXNew_AddEXReader(struct string *filename)
+{
+	char *path = gamedir_path(filename->text);
+	struct ex *reader = ex_read_file(path);
+	free(path);
+	if (!reader) return -1;
+	ex_readers = xrealloc(ex_readers, sizeof(*ex_readers) * (nr_ex_readers + 1));
+	ex_readers[nr_ex_readers++] = reader;
+	return nr_ex_readers;
+}
+
+static void MainEXNew_EraseEXReader(int id)
+{
+	if (id > 0 && id <= nr_ex_readers && ex_readers[id - 1]) {
+		ex_free(ex_readers[id - 1]);
+		ex_readers[id - 1] = NULL;
+	}
+}
+
+static void MainEXNew_Fini(void)
+{
+	for (int i = 1; i <= nr_ex_readers; i++) MainEXNew_EraseEXReader(i);
+	free(ex_readers); ex_readers = NULL; nr_ex_readers = 0;
+}
+
+static struct ex_value *MainEXNew_Value(struct string *name, int id)
+{
+	struct ex *reader = MainEXNew_Reader(id);
+	if (!reader) return NULL;
+	struct ex_value *value = ex_get(reader, name->text);
+	if (value) return value;
+	char *alt = ex_key_sjis_digits_to_gbk(name->text);
+	if (alt) {
+		value = ex_get(reader, alt);
+		free(alt);
+	}
+	return value;
+}
+
+static struct ex_value *MainEXNew_Element(struct string *name, int index, int id)
+{
+	struct ex_value *v = MainEXNew_Value(name, id);
+	return v && v->type == EX_LIST && index >= 0 ? ex_list_get(v->list, index) : NULL;
+}
+
+static struct ex_table *MainEXNew_Table(struct string *name, int id)
+{
+	struct ex_value *v = MainEXNew_Value(name, id);
+	return v && v->type == EX_TABLE ? v->t : NULL;
+}
+
+static struct ex_value *MainEXNew_Cell(struct string *name, int row, int col, int id)
+{
+	struct ex_table *t = MainEXNew_Table(name, id);
+	return t && row >= 0 && col >= 0 ? ex_table_get(t, row, col) : NULL;
+}
+
+static int MainEXNew_Row(struct string *name, int id)
+{
+	struct ex_table *t = MainEXNew_Table(name, id);
+	return t ? t->nr_rows : 0;
+}
+static int MainEXNew_Col(struct string *name, int id)
+{
+	struct ex_value *v = MainEXNew_Value(name, id);
+	if (v && v->type == EX_LIST) return v->list->nr_items;
+	return v && v->type == EX_TABLE ? v->t->nr_columns : 0;
+}
+static int MainEXNew_Type(struct string *name, int id) { struct ex_value *v = MainEXNew_Value(name, id); return v ? v->type : 0; }
+static int MainEXNew_AType(struct string *name, int index, int id) { struct ex_value *v = MainEXNew_Element(name, index, id); return v ? v->type : 0; }
+static int MainEXNew_A2Type(struct string *name, int row, int col, int id) { struct ex_value *v = MainEXNew_Cell(name, row, col, id); return v ? v->type : 0; }
+static bool MainEXNew_Exists(struct string *name, int id) { return MainEXNew_Value(name, id) != NULL; }
+static bool MainEXNew_AExists(struct string *name, int index, int id) { return MainEXNew_Element(name, index, id) != NULL; }
+static bool MainEXNew_A2Exists(struct string *name, int row, int col, int id) { return MainEXNew_Cell(name, row, col, id) != NULL; }
+
+/* Return a retained string: libffi releases the caller's fallback argument
+ * before placing the result in a fresh heap slot. */
+static struct string *MainEXNew_StringValue(struct ex_value *v, struct string *fallback)
+{
+	return string_ref(v && v->type == EX_STRING ? v->s : fallback);
+}
+
+static int MainEXNew_Int(struct string *name, int fallback, int id) { struct ex_value *v = MainEXNew_Value(name, id); return v && v->type == EX_INT ? v->i : fallback; }
+static float MainEXNew_Float(struct string *name, float fallback, int id) { struct ex_value *v = MainEXNew_Value(name, id); return v && v->type == EX_FLOAT ? v->f : fallback; }
+static struct string *MainEXNew_String(struct string *name, struct string *fallback, int id)
+{
+	struct ex_value *value = MainEXNew_Value(name, id);
+	/* Bounded, byte-exact quest diagnostics: display conversion would hide
+	 * mixed GBK/SJIS digits in the queried path. */
+	if (ain->version >= 12 && name->size >= 8 && !memcmp(name->text,"\xc8\xce\xce\xf1\xca\xfd\xbe\xdd",8)
+		&& name->size >= 4 && !memcmp(name->text + name->size - 4,"\xb9\xca\xca\xc2",4)) {
+		static unsigned count;
+		if (count++ < 128) {
+			char path[1025], result[513];
+			static const char hex[] = "0123456789abcdef";
+			int n = name->size < 512 ? name->size : 512;
+			for (int i=0;i<n;i++) { unsigned char c=name->text[i]; path[2*i]=hex[c>>4]; path[2*i+1]=hex[c&15]; }
+			path[2*n]=0;
+			struct string *s = value && value->type == EX_STRING ? value->s : fallback;
+			n = s->size < 256 ? s->size : 256;
+			for (int i=0;i<n;i++) { unsigned char c=s->text[i]; result[2*i]=hex[c>>4]; result[2*i+1]=hex[c&15]; }
+			result[2*n]=0;
+			NOTICE("R10EX reader=%d type=%d pathhex=%s resulthex=%s",id,value?value->type:0,path,result);
+		}
+	}
+	return MainEXNew_StringValue(value, fallback);
+}
+static int MainEXNew_AInt(struct string *name, int index, int fallback, int id) { struct ex_value *v = MainEXNew_Element(name, index, id); return v && v->type == EX_INT ? v->i : fallback; }
+static float MainEXNew_AFloat(struct string *name, int index, float fallback, int id) { struct ex_value *v = MainEXNew_Element(name, index, id); return v && v->type == EX_FLOAT ? v->f : fallback; }
+static struct string *MainEXNew_AString(struct string *name, int index, struct string *fallback, int id) { return MainEXNew_StringValue(MainEXNew_Element(name, index, id), fallback); }
+static int MainEXNew_A2Int(struct string *name, int row, int col, int fallback, int id) { struct ex_value *v = MainEXNew_Cell(name, row, col, id); return v && v->type == EX_INT ? v->i : fallback; }
+static float MainEXNew_A2Float(struct string *name, int row, int col, float fallback, int id) { struct ex_value *v = MainEXNew_Cell(name, row, col, id); return v && v->type == EX_FLOAT ? v->f : fallback; }
+static struct string *MainEXNew_A2String(struct string *name, int row, int col, struct string *fallback, int id) { return MainEXNew_StringValue(MainEXNew_Cell(name, row, col, id), fallback); }
+
+static int MainEXNew_GetRowAtIntKey(struct string *name, int key, int id) { struct ex_table *t = MainEXNew_Table(name, id); return t ? ex_row_at_int_key(t, key) : -1; }
+static int MainEXNew_GetRowAtStringKey(struct string *name, struct string *key, int id) { struct ex_table *t = MainEXNew_Table(name, id); return t ? ex_row_at_string_key_cn(t, key->text) : -1; }
+static int MainEXNew_GetColAtFormatName(struct string *name, struct string *field, int id) { struct ex_table *t = MainEXNew_Table(name, id); return t ? ex_col_from_name(t, field->text) : -1; }
+
+static struct ex_tree *MainEXNew_Tree(struct string *name, int id)
+{
+	struct ex_value *v = MainEXNew_Value(name, id);
+	return v && v->type == EX_TREE && !v->tree->is_leaf ? v->tree : NULL;
+}
+static int MainEXNew_NameCount(struct string *name, int id, bool leaf)
+{
+	struct ex_tree *tree = MainEXNew_Tree(name, id);
+	int count = 0;
+	if (tree) for (unsigned i = 0; i < tree->nr_children; i++) if (tree->children[i].is_leaf == leaf) count++;
+	return count;
+}
+static int MainEXNew_GetNodeNameCount(struct string *name, int id) { return MainEXNew_NameCount(name, id, false); }
+static int MainEXNew_GetEXNameCount(struct string *name, int id) { return MainEXNew_NameCount(name, id, true); }
+static bool MainEXNew_GetName(struct string *name, int index, struct string **output, int id, bool leaf)
+{
+	struct ex_tree *tree = MainEXNew_Tree(name, id);
+	if (!tree || index < 0) return false;
+	for (unsigned i = 0; i < tree->nr_children; i++) {
+		struct ex_tree *child = &tree->children[i];
+		if (child->is_leaf != leaf) continue;
+		if (index-- == 0) {
+			struct string *result = string_ref(leaf ? child->leaf.name : child->name);
+			free_string(*output); *output = result;
+			return true;
+		}
+	}
+	return false;
+}
+static bool MainEXNew_GetNodeName(struct string *name, int index, struct string **output, int id) { return MainEXNew_GetName(name, index, output, id, false); }
+static bool MainEXNew_GetEXName(struct string *name, int index, struct string **output, int id) { return MainEXNew_GetName(name, index, output, id, true); }
+
+static bool MainEXNew_GetNameList(struct string *name, struct page **output, int id, bool leaf)
+{
+	struct ex_tree *tree = MainEXNew_Tree(name, id);
+	if (!tree) return false;
+	union vm_value count = { .i = MainEXNew_NameCount(name, id, leaf) };
+	struct page *list = alloc_array(1, &count, AIN_ARRAY_STRING, -1, false);
+	int index = 0;
+	for (unsigned i = 0; i < tree->nr_children; i++) {
+		struct ex_tree *child = &tree->children[i];
+		if (child->is_leaf != leaf) continue;
+		heap_string_assign(list->values[index++].i, leaf ? child->leaf.name : child->name);
+	}
+	if (*output) { delete_page_vars(*output); free_page(*output); }
+	*output = list;
+	return true;
+}
+static bool MainEXNew_GetNodeNameList(struct string *name, struct page **output, int id) { return MainEXNew_GetNameList(name, output, id, false); }
+static bool MainEXNew_GetEXNameList(struct string *name, struct page **output, int id) { return MainEXNew_GetNameList(name, output, id, true); }
+
+/* Every Rance 10 save stores an EX "image" (MainEXFile.Save) and restores it
+ * on load. The image holds EX data added at run time through AddEX/AddEXText,
+ * which only the editors call; game EX data is read-only. An empty image is
+ * therefore a complete snapshot. Failing here made each save call
+ * system.Error("メインＥＸの保存失败"). */
+static bool MainEXNew_Save(struct page **image)
+{
+	if (*image) {
+		delete_page_vars(*image);
+		free_page(*image);
+		*image = NULL;
+	}
+	return true;
+}
+static bool MainEXNew_Load(struct page **image) { (void)image; return true; }
