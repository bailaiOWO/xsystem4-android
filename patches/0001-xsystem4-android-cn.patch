new file mode 100644
index 0000000..0db1c69
--- /dev/null
+++ b/src/hll/MsgSkipAdv.inc
@@ -0,0 +1,136 @@
+/* ADV steps have no MSG instruction number. Keep their identity and version
+ * separate from the legacy MsgSkip bitset. SPDX-License-Identifier: GPL-2.0-or-later */
+struct adv_skip_flags {
+	struct adv_skip_flags *next;
+	struct string *name;
+	int version;
+	uint32_t size;
+	uint8_t *bits;
+};
+static struct adv_skip_flags *adv_skip_buckets[1024];
+static char *adv_skip_path;
+static bool adv_skip_dirty;
+
+static void msgskip_adv_clear(void)
+{
+	for (int i = 0; i < 1024; i++) {
+		struct adv_skip_flags *p = adv_skip_buckets[i];
+		while (p) {
+			struct adv_skip_flags *next = p->next;
+			free_string(p->name); free(p->bits); free(p); p = next;
+		}
+		adv_skip_buckets[i] = NULL;
+	}
+	free(adv_skip_path); adv_skip_path = NULL; adv_skip_dirty = false;
+}
+
+static struct adv_skip_flags *adv_skip_find(struct string *name, int version, bool create)
+{
+	uint32_t hash = (uint32_t)version ^ 2166136261u;
+	for (int i = 0; i < name->size; i++) hash = (hash ^ (uint8_t)name->text[i]) * 16777619u;
+	unsigned bucket = hash % 1024;
+	for (struct adv_skip_flags *p = adv_skip_buckets[bucket]; p; p = p->next)
+		if (p->version == version && !strcmp(p->name->text, name->text)) return p;
+	if (!create) return NULL;
+	struct adv_skip_flags *p = xcalloc(1, sizeof(*p));
+	p->name = string_dup(name); p->version = version;
+	p->next = adv_skip_buckets[bucket]; adv_skip_buckets[bucket] = p;
+	return p;
+}
+
+static void MsgSkip_SetAdvFlag(struct string *name, int version, int step)
+{
+	if (!name || !name->size || step < 0 || step >= 0x1000000) return;
+	struct adv_skip_flags *p = adv_skip_find(name, version, true);
+	uint32_t byte = (unsigned)step / 8;
+	if (byte >= p->size) {
+		uint32_t size = (byte + 256) & ~255u;
+		p->bits = xrealloc(p->bits, size);
+		memset(p->bits + p->size, 0, size - p->size);
+		p->size = size;
+	}
+	uint8_t mask = 0x80 >> (step & 7);
+	if (!(p->bits[byte] & mask)) { p->bits[byte] |= mask; adv_skip_dirty = true; }
+}
+
+bool msgskip_is_adv_read(struct string *name, int version, int step)
+{
+	if (!name || !name->size || step < 0) return false;
+	struct adv_skip_flags *p = adv_skip_find(name, version, false);
+	return p && (unsigned)step / 8 < p->size && (p->bits[(unsigned)step / 8] & (0x80 >> (step & 7)));
+}
+
+static int MsgSkip_GetAdvFlag(struct string *name, int version, int step)
+{
+	return msgskip_is_adv_read(name, version, step);
+}
+
+static void msgskip_adv_save(void)
+{
+	if (!adv_skip_dirty || !adv_skip_path) return;
+	size_t size = 12;
+	uint32_t count = 0;
+	for (int i = 0; i < 1024; i++)
+		for (struct adv_skip_flags *p = adv_skip_buckets[i]; p; p = p->next) {
+			size += 12 + p->name->size + p->size; count++;
+		}
+	uint8_t *data = xmalloc(size);
+	memcpy(data, "XMSA\1\0\0\0", 8);
+	LittleEndian_putDW(data, 8, count);
+	size_t at = 12;
+	for (int i = 0; i < 1024; i++)
+		for (struct adv_skip_flags *p = adv_skip_buckets[i]; p; p = p->next) {
+			LittleEndian_putDW(data, at, p->name->size);
+			LittleEndian_putDW(data, at + 4, p->version);
+			LittleEndian_putDW(data, at + 8, p->size); at += 12;
+			memcpy(data + at, p->name->text, p->name->size); at += p->name->size;
+			memcpy(data + at, p->bits, p->size); at += p->size;
+		}
+	if (atomic_file_write(adv_skip_path, data, size)) adv_skip_dirty = false;
+	else WARNING("Cannot save ADV read flags: %s", display_utf0(adv_skip_path));
+	free(data);
+}
+
+static bool msgskip_adv_read(const uint8_t *data, size_t size)
+{
+	if (size < 12 || memcmp(data, "XMSA\1\0\0\0", 8)) return false;
+	uint32_t count = LittleEndian_getDW(data, 8);
+	if (count > (size - 12) / 12) return false;
+	/* Validate the complete file before mutating flags. */
+	size_t at = 12;
+	for (uint32_t i = 0; i < count; i++) {
+		if (size - at < 12) return false;
+		uint32_t name = LittleEndian_getDW(data, at), bits = LittleEndian_getDW(data, at + 8);
+		at += 12;
+		if (!name || name > size - at || bits > size - at - name || bits > 0x200000
+				|| memchr(data + at, 0, name)) return false;
+		at += name + bits;
+	}
+	if (at != size) return false;
+	at = 12;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t len = LittleEndian_getDW(data, at), bits = LittleEndian_getDW(data, at + 8);
+		int version = LittleEndian_getDW(data, at + 4); at += 12;
+		struct string *name = make_string((const char *)data + at, len); at += len;
+		struct adv_skip_flags *p = adv_skip_find(name, version, true); free_string(name);
+		if (bits > p->size) {
+			p->bits = xrealloc(p->bits, bits);
+			memset(p->bits + p->size, 0, bits - p->size); p->size = bits;
+		}
+		for (uint32_t j = 0; j < bits; j++) p->bits[j] |= data[at + j];
+		at += bits;
+	}
+	return true;
+}
+
+static void msgskip_adv_init(const char *path)
+{
+	adv_skip_path = xmalloc(strlen(path) + 5);
+	sprintf(adv_skip_path, "%s.adv", path);
+	size_t size;
+	uint8_t *data = file_read(adv_skip_path, &size);
+	if (data) {
+		if (!msgskip_adv_read(data, size)) WARNING("Invalid ADV read flags: %s", display_utf0(adv_skip_path));
+		free(data);
+	}
+}
