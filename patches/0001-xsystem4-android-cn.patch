diff --git a/include/apeg.h b/include/apeg.h
new file mode 100644
index 0000000..e381a3c
--- /dev/null
+++ b/include/apeg.h
@@ -0,0 +1,36 @@
+/* AliceSoft APEG movies (Rance 10 Movie\NAME.apeg).
+ *
+ * Container (little endian, chunks of 4-byte tag + u32 payload size):
+ *   APEG  header: u32 frame-rate code, u16 width, u16 height,
+ *         64-byte intra and non-intra quantiser matrices,
+ *         u32 duration (ms), u32 key-frame count, then (u32 ms, u32 offset)
+ *   TMNL  zlib-compressed thumbnail
+ *   SOND  Ogg Vorbis sound track
+ *   IPIC/PPIC/BPIC  video pictures (u32 presentation time in ms + an
+ *         MPEG-1-like bitstream without start codes)
+ *
+ * The AliceSoft-specific picture stream is decoded using the implementation
+ * ported from TomorrowX6/re-xsystem4. Video presentation follows our existing
+ * audio-backed movie clock and is composited through the PartsEngine texture.
+ */
+#ifndef SYSTEM4_APEG_H
+#define SYSTEM4_APEG_H
+
+#include <stdbool.h>
+
+struct apeg_player;
+struct texture;
+
+struct apeg_player *apeg_open(const char *game_path, int mixer_no);
+void apeg_close(struct apeg_player *p);
+int apeg_width(struct apeg_player *p);
+int apeg_height(struct apeg_player *p);
+int apeg_duration(struct apeg_player *p);
+bool apeg_play(struct apeg_player *p, int msec);
+void apeg_seek(struct apeg_player *p, int msec);
+int apeg_position(struct apeg_player *p);
+bool apeg_is_end(struct apeg_player *p);
+// Updates the target only when a new frame is due; the target remains caller-owned.
+bool apeg_draw(struct apeg_player *p, struct texture *target);
+
+#endif /* SYSTEM4_APEG_H */
