+	size_t bytes = (size_t)cg->metrics.w * cg->metrics.h * 4;
+	struct decoded_cg_entry *slot;
+	for (;;) {
+		slot = NULL;
+		struct decoded_cg_entry *oldest = NULL;
+		for (unsigned i = 0; i < 32; i++) {
+			struct decoded_cg_entry *entry = &decoded_cg_cache[i];
+			if (!entry->name) slot = entry;
+			else if (!oldest || entry->used < oldest->used) oldest = entry;
+		}
+		if (slot && decoded_cg_bytes + bytes <= DECODED_CG_LIMIT) break;
+		decoded_cg_remove(oldest);
+	}
+	*slot = (struct decoded_cg_entry){strdup(name), id, decoded_cg_copy(cg, bytes), bytes, ++decoded_cg_clock};
+	decoded_cg_bytes += bytes;
