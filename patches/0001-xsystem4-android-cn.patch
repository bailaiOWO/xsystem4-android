diff --git a/src/hll/ADVLogList.inc b/src/hll/ADVLogList.inc
new file mode 100644
index 0000000..3512c07
--- /dev/null
+++ b/src/hll/ADVLogList.inc
@@ -0,0 +1,169 @@
+/* Dialogue history used by the AFL backlog. SPDX-License-Identifier: GPL-2.0-or-later */
+#include "iarray.h"
+
+struct adv_log_page {
+	struct string **text, **voice, **filter;
+	int nr_text, nr_voice;
+};
+static struct adv_log_page *adv_log;
+static int adv_log_count;
+static bool adv_log_enabled = true, adv_log_new_page = true;
+/*
+ * One entry per displayed line. message::detail::Message appends text to the
+ * current line and message::detail::R (AddNewLine) ends it. The backlog joins
+ * a page's entries with "\n" itself (CBackLogUnit@CreateLog), and its own
+ * registration helper (Ａ＿剧情回顾登录) reports any entry that contains a line
+ * break as an error. Storing "\n" in the entries doubled every line in the
+ * backlog: only 13 of its 24 ruled lines were used and the last one was cut.
+ */
+static bool adv_log_line_open;
+
+static void adv_log_free_page(struct adv_log_page *p)
+{
+	for (int i=0;i<p->nr_text;i++) free_string(p->text[i]);
+	for (int i=0;i<p->nr_voice;i++) { free_string(p->voice[i]); free_string(p->filter[i]); }
+	free(p->text); free(p->voice); free(p->filter);
+}
+static void ADVLog_Clear(void)
+{
+	for (int i=0;i<adv_log_count;i++) adv_log_free_page(&adv_log[i]);
+	free(adv_log); adv_log=NULL; adv_log_count=0; adv_log_new_page=true; adv_log_line_open=false;
+}
+static struct adv_log_page *adv_log_current(void)
+{
+	if (!adv_log_count || adv_log_new_page) {
+		if (adv_log_count==512) {
+			adv_log_free_page(adv_log);
+			memmove(adv_log,adv_log+1,--adv_log_count*sizeof(*adv_log));
+		}
+		adv_log=xrealloc(adv_log,(adv_log_count+1)*sizeof(*adv_log));
+		adv_log[adv_log_count++]=(struct adv_log_page){0}; adv_log_new_page=false;
+		adv_log_line_open=false;
+	}
+	return &adv_log[adv_log_count-1];
+}
+static void ADVLog_AddText(struct string *text, struct string *window)
+{
+	(void)window;
+	if (!adv_log_enabled || !text->size) return;
+	struct adv_log_page *p=adv_log_current();
+	if (adv_log_line_open && p->nr_text) {
+		// More text for the same line (names, variables, colour runs).
+		string_append(&p->text[p->nr_text-1],text);
+		return;
+	}
+	p->text=xrealloc(p->text,(p->nr_text+1)*sizeof(*p->text));
+	p->text[p->nr_text++]=string_dup(text);
+	adv_log_line_open=true;
+}
+static void ADVLog_AddNewLine(void) { if (adv_log_enabled) adv_log_line_open=false; }
+static void ADVLog_AddNewPage(void) { if (adv_log_enabled) { adv_log_new_page=true; adv_log_line_open=false; } }
+static void ADVLog_AddVoice(struct string *name, struct string *filter)
+{
+	if (!adv_log_enabled || !name->size) return;
+	struct adv_log_page *p=adv_log_current();
+	p->voice=xrealloc(p->voice,(p->nr_voice+1)*sizeof(*p->voice));
+	p->filter=xrealloc(p->filter,(p->nr_voice+1)*sizeof(*p->filter));
+	p->voice[p->nr_voice]=string_dup(name); p->filter[p->nr_voice++]=string_dup(filter);
+}
+static void ADVLog_SetEnable(bool value) { adv_log_enabled=value; }
+static bool ADVLog_IsEnable(void) { return adv_log_enabled; }
+static int ADVLog_GetNumofADVLog(void) { return adv_log_count; }
+static struct adv_log_page *adv_log_at(int n) { return n>=0 && n<adv_log_count ? &adv_log[n] : NULL; }
+static int ADVLog_GetNumofADVLogText(int n) { struct adv_log_page *p=adv_log_at(n); return p ? p->nr_text : 0; }
+static int ADVLog_GetNumofADVLogVoice(int n) { struct adv_log_page *p=adv_log_at(n); return p ? p->nr_voice : 0; }
+static struct string *ADVLog_GetADVLogText(int n,int i) { struct adv_log_page *p=adv_log_at(n); return string_ref(p && i>=0 && i<p->nr_text ? p->text[i] : &EMPTY_STRING); }
+static struct string *ADVLog_GetADVLogVoice(int n,int i) { struct adv_log_page *p=adv_log_at(n); return string_ref(p && i>=0 && i<p->nr_voice ? p->voice[i] : &EMPTY_STRING); }
+static struct string *ADVLog_GetADVLogVoiceFilter(int n,int i) { struct adv_log_page *p=adv_log_at(n); return string_ref(p && i>=0 && i<p->nr_voice ? p->filter[i] : &EMPTY_STRING); }
+static bool ADVLog_Save(struct page **buffer)
+{
+	struct iarray_writer w; iarray_init_writer(&w,"XLOG");
+	iarray_write(&w,2); iarray_write(&w,adv_log_enabled); iarray_write(&w,adv_log_new_page);
+	iarray_write(&w,adv_log_line_open); iarray_write(&w,adv_log_count);
+	for (int i=0;i<adv_log_count;i++) {
+		struct adv_log_page *p=&adv_log[i];
+		iarray_write(&w,p->nr_text);
+		for (int j=0;j<p->nr_text;j++) iarray_write_string(&w,p->text[j]);
+		iarray_write(&w,p->nr_voice);
+		for (int j=0;j<p->nr_voice;j++) { iarray_write_string(&w,p->voice[j]); iarray_write_string(&w,p->filter[j]); }
+	}
+	if (*buffer) { delete_page_vars(*buffer); free_page(*buffer); }
+	*buffer=iarray_to_page(&w); iarray_free_writer(&w); return true;
+}
+/*
+ * Version 1 logs (saved before the fix) hold one entry per AddText call with
+ * every R appended as "\n". Rebuild the page's lines from them; returns
+ * whether the page's last line was ended by R. '\n' is never a trail byte of
+ * SJIS or GBK, so splitting on the byte is safe.
+ */
+static bool adv_log_split_lines(struct adv_log_page *p)
+{
+	struct string *all=string_dup(&EMPTY_STRING);
+	for (int i=0;i<p->nr_text;i++) { string_append(&all,p->text[i]); free_string(p->text[i]); }
+	bool ended=!all->size || all->text[all->size-1]=='\n';
+	p->nr_text=0;
+	for (int start=0,i=0;i<=all->size;i++) {
+		if (i<all->size && all->text[i]!='\n') continue;
+		if (i>start) {
+			p->text=xrealloc(p->text,(p->nr_text+1)*sizeof(*p->text));
+			p->text[p->nr_text++]=make_string(all->text+start,i-start);
+		}
+		start=i+1;
+	}
+	free_string(all);
+	return ended;
+}
+static bool ADVLog_Load(struct page **buffer)
+{
+	if (!*buffer || !(*buffer)->nr_vars) {
+		ADVLog_Clear(); return true; // Older builds stored no log.
+	}
+	struct iarray_reader r;
+	if (!iarray_init_reader(&r,*buffer,"XLOG")) return false;
+	int version=iarray_read(&r);
+	if (version!=1 && version!=2) return false;
+	bool enabled=iarray_read(&r), new_page=iarray_read(&r);
+	bool line_open=version>=2 && iarray_read(&r);
+	int count=iarray_read(&r);
+	if (r.error || r.pos>r.size || count<0 || count>512 || (unsigned)count>(r.size-r.pos)/2) return false;
+	struct adv_log_page *staged=xcalloc(count,sizeof(*staged));
+	for (int i=0;i<count;i++) {
+		struct adv_log_page *p=&staged[i];
+		int text=iarray_read(&r);
+		if (r.error || r.pos>r.size || text<0 || (unsigned)text>r.size-r.pos) goto invalid;
+		p->text=xcalloc(text,sizeof(*p->text));
+		for (int j=0;j<text;j++) {
+			p->text[p->nr_text++]=iarray_read_string(&r);
+			if (r.error) goto invalid;
+		}
+		int voice=iarray_read(&r);
+		if (r.error || r.pos>r.size || voice<0 || (unsigned)voice>(r.size-r.pos)/2) goto invalid;
+		p->voice=xcalloc(voice,sizeof(*p->voice)); p->filter=xcalloc(voice,sizeof(*p->filter));
+		for (int j=0;j<voice;j++) {
+			p->voice[j]=iarray_read_string(&r); p->filter[j]=iarray_read_string(&r); p->nr_voice++;
+			if (r.error) goto invalid;
+		}
+	}
+	if (version==1) {
+		bool ended=true;
+		for (int i=0;i<count;i++) ended=adv_log_split_lines(&staged[i]);
+		line_open=count && !new_page && !ended;
+	}
+	ADVLog_Clear();
+	adv_log=staged; adv_log_count=count; adv_log_enabled=enabled; adv_log_new_page=new_page;
+	adv_log_line_open=line_open;
+	return true;
+invalid:
+	for (int i=0;i<count;i++) adv_log_free_page(&staged[i]);
+	free(staged); return false;
+}
+HLL_LIBRARY(AnteaterADVLogList,
+	HLL_EXPORT(_ModuleFini, ADVLog_Clear),
+	HLL_EXPORT(Clear, ADVLog_Clear), HLL_EXPORT(AddText, ADVLog_AddText),
+	HLL_EXPORT(AddNewLine, ADVLog_AddNewLine), HLL_EXPORT(AddNewPage, ADVLog_AddNewPage),
+	HLL_EXPORT(AddVoice, ADVLog_AddVoice), HLL_EXPORT(SetEnable, ADVLog_SetEnable), HLL_EXPORT(IsEnable, ADVLog_IsEnable),
+	HLL_EXPORT(GetNumofADVLog, ADVLog_GetNumofADVLog), HLL_EXPORT(GetNumofADVLogText, ADVLog_GetNumofADVLogText),
+	HLL_EXPORT(GetADVLogText, ADVLog_GetADVLogText), HLL_EXPORT(GetNumofADVLogVoice, ADVLog_GetNumofADVLogVoice),
+	HLL_EXPORT(GetADVLogVoice, ADVLog_GetADVLogVoice), HLL_EXPORT(GetADVLogVoiceFilter, ADVLog_GetADVLogVoiceFilter),
+	HLL_EXPORT(Save, ADVLog_Save), HLL_EXPORT(Load, ADVLog_Load)
+);
