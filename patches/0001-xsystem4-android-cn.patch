+struct lambda_capture_info {
+	bool ready;
+	int nr_indices;
+	int *indices;
+};
+static struct lambda_capture_info *lambda_captures;
+static int nr_lambda_captures;
+
+static void clear_lambda_captures(void)
+{
+	for (int i=0;i<nr_lambda_captures;i++) free(lambda_captures[i].indices);
+	free(lambda_captures);
+	lambda_captures=NULL; nr_lambda_captures=0;
+}
+
+static const struct lambda_capture_info *get_lambda_captures(int fun)
+{
+	if (!lambda_captures) {
+		nr_lambda_captures=ain->nr_functions;
+		lambda_captures=xcalloc(nr_lambda_captures,sizeof(*lambda_captures));
+	}
+	struct lambda_capture_info *info=&lambda_captures[fun];
+	if (info->ready) return info;
+	// Bytecode is immutable for this AIN. Analyze each lambda once instead
+	// of scanning its entire body whenever a timer creates the callback.
+	unsigned nested_functions=0;
+	for (size_t ip=ain->functions[fun].address;ip+2<=ain->code_size;) {
+		int op=get_opcode(ip);
+		if (op<0 || op>=NR_OPCODES) break;
+		int width=instruction_width(op);
+		if (ip+width>ain->code_size) break;
+		if (op==ENDFUNC && LittleEndian_getDW(ain->code,ip+2)==fun) break;
+		if (op==FUNC) nested_functions++;
+		if (op==ENDFUNC && nested_functions) nested_functions--;
+		if (op==X_GETENV && !nested_functions) {
+			if (ip+8>ain->code_size || get_opcode(ip+2)!=PUSH)
+				VM_ERROR("Unsupported closure capture expression");
+			int index=LittleEndian_getDW(ain->code,ip+4);
+			bool found=false;
+			for (int i=0;i<info->nr_indices;i++) found |= info->indices[i]==index;
+			if (!found) {
+				info->indices=xrealloc(info->indices,(info->nr_indices+1)*sizeof(int));
+				info->indices[info->nr_indices++]=index;
+			}
+		}
+		ip+=width;
+	}
+	info->ready=true;
+	return info;
+}
+
+static int capture_delegate_environment(int obj, int fun)
+{
+	if (ain->version < 11 || !call_stack_ptr || !strstr(ain->functions[fun].name,"<lambda : ")) return -1;
+	struct page *source = local_page();
+	const struct lambda_capture_info *info=get_lambda_captures(fun);
+	if (!info->nr_indices) return -1;
+	for (int i=0;i<info->nr_indices;i++)
+		if (info->indices[i]<0 || info->indices[i]>=source->nr_vars)
+			VM_ERROR("Invalid closure capture index: %d",info->indices[i]);
+	struct page *env = alloc_page(CLOSURE_PAGE, source->index, source->nr_vars);
+	env->local.struct_ptr = obj;
+	env->local.struct_seq = heap_get_seq(obj);
+	env->local.parent_page = local_page_slot();
+	env->local.parent_seq = heap_get_seq(env->local.parent_page);
+	for (int i=0;i<source->nr_vars;i++) {
+		enum ain_data_type type = variable_type(source,i,NULL,NULL);
+		bool used=false;
+		for (int j=0;j<info->nr_indices;j++) used |= info->indices[j]==i;
+		env->values[i] = used ? vm_copy(source->values[i],type) : variable_initval(type);
+	}
+	return heap_alloc_page(env);
+}
+
+static int delegate_return_width(enum ain_data_type type)
+{
+	switch (type) {
+	case AIN_VOID: return 0;
+	case AIN_IFACE:
+	case AIN_REF_INT:
+	case AIN_REF_FLOAT:
+	case AIN_REF_BOOL:
+	case AIN_REF_LONG_INT:
+	case AIN_REF_ENUM: return 2;
+	default: return 1;
+	}
+}
