+
+/* APEG decoder ported from TomorrowX6/re-xsystem4, commit
+ * 683a119d0ab2b23e0440c6f5e84e2141653e5503 (src/movie_plmpeg.c
+ * and include/apeg_vlc.h). The APEG picture algorithms and VLC tables
+ * are retained; container ownership and scheduling are independent.
+ * https://github.com/TomorrowX6/re-xsystem4
+ */
+
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "system4.h"
+#include "system4/little_endian.h"
+
+/* The sole pl_mpeg implementation; ordinary MPEG playback uses its public API. */
+#define PL_MPEG_IMPLEMENTATION
+#include "apeg_decoder.h"
+#include "apeg_vlc.h"
+
+struct apeg_keyframe {
+	uint32_t time_ms;
+	uint32_t file_offset;
+};
+
+struct apeg_decoder {
+	FILE *fp;
+	long file_size;
+	long first_chunk_offset;
+	long sound_offset;
+	size_t sound_size;
+	int width;
+	int height;
+	int end_time_ms;
+	uint32_t keyframe_count;
+	struct apeg_keyframe *keyframes;
+	plm_buffer_t *bitbuf;
+	plm_video_t *vdec;
+	plm_frame_t *pending_frame;
+	bool has_ref;
+	bool has_both_refs;
+	bool eof;
+	bool seek_frame_due;
+};
+
+static void apeg_decode_block(plm_video_t *self, int block)
+{
+	int n = 0;
+	uint8_t *quant_matrix;
+	int quantizer_scale = self->quantizer_scale;
+
+	if (self->macroblock_intra) {
+		int predictor;
+		int plane_index = (block > 3) ? (block - 3) : 0;
+		predictor = self->dc_predictor[plane_index];
+
+		int size = plm_buffer_read_vlc(self->buffer,
+			block < 4 ? APEG_VLC_DC_LUMA : APEG_VLC_DC_CHROMA);
+		if (size < 0)
+			return;
+
+		if (size > 0) {
+			int val = plm_buffer_read(self->buffer, size);
+			if ((val & (1 << (size - 1))) == 0) {
+				val -= (1 << size) - 1;
+			}
+			predictor += val;
+			self->dc_predictor[plane_index] = predictor;
+		}
+		self->block_data[0] = predictor << (3 + 5);
+		quant_matrix = self->intra_quant_matrix;
+		n = 1;
+	} else {
+		quant_matrix = self->non_intra_quant_matrix;
+	}
+
+	int coeff = 0;
+	while (TRUE) {
+		int run_coeff = plm_buffer_read_vlc(self->buffer,
+			n == 0 ? APEG_VLC_DCT_FIRST : APEG_VLC_DCT_NEXT);
+		if (run_coeff == -3) {
+			break;
+		}
+		if (run_coeff == -4) {
+			return;
+		}
+
+		int run;
+		if (run_coeff == -2) {
+			run = plm_buffer_read(self->buffer, 6);
+			coeff = plm_buffer_read(self->buffer, 8);
+			if (coeff == 0) {
+				coeff = plm_buffer_read(self->buffer, 8);
+			} else if (coeff == 128) {
+				coeff = plm_buffer_read(self->buffer, 8) - 256;
+			} else if (coeff > 128) {
+				coeff -= 256;
+			}
+		} else {
+			if (run_coeff == -1) {
+				run = 0;
+				coeff = 1;
+			} else {
+				run = run_coeff >> 8;
+				coeff = run_coeff & 0xff;
+			}
+			if (plm_buffer_read(self->buffer, 1)) {
+				coeff = -coeff;
+			}
+		}
+
+		n += run;
+		if (n >= 64) {
+			break;
+		}
+
+		int de_zig_zagged = PLM_VIDEO_ZIG_ZAG[n];
+		n++;
+
+		coeff <<= 1;
+		if (!self->macroblock_intra) {
+			coeff += (coeff < 0) ? -1 : 1;
+		}
+		coeff = (coeff * quantizer_scale * quant_matrix[de_zig_zagged]) >> 4;
+		if ((coeff & 1) == 0) {
+			coeff -= coeff > 0 ? 1 : -1;
+		}
+		if (coeff > 2047) {
+			coeff = 2047;
+		} else if (coeff < -2048) {
+			coeff = -2048;
+		}
+
+		self->block_data[de_zig_zagged] = coeff * PLM_VIDEO_PREMULTIPLIER_MATRIX[de_zig_zagged];
+	}
+
+	if (n == 1) {
+		int val = (self->block_data[0] + 128) >> 8;
+		int clamped = plm_clamp(val);
+		uint8_t *d;
+		int scan;
+		if (block < 4) {
+			scan = self->luma_width - 8;
+			d = self->frame_current.y.data
+				+ ((self->mb_row << 4) + ((block & 2) << 2)) * self->luma_width
+				+ (self->mb_col << 4) + ((block & 1) << 3);
+		} else {
+			scan = self->chroma_width - 8;
+			uint8_t *plane = (block == 4) ? self->frame_current.cb.data : self->frame_current.cr.data;
+			d = plane + (self->mb_row << 3) * self->chroma_width + (self->mb_col << 3);
+		}
+		for (int sy = 0; sy < 8; sy++) {
+			for (int sx = 0; sx < 8; sx++) {
+				if (self->macroblock_intra) {
+					*d = clamped;
+				} else {
+					int s = *d + val;
+					*d = plm_clamp(s);
+				}
+				d++;
+			}
+			d += scan;
+		}
+		self->block_data[0] = 0;
+		return;
+	}
+
+	plm_video_idct(self->block_data);
+
+	uint8_t *d;
+	int scan;
+	if (block < 4) {
+		scan = self->luma_width - 8;
+		d = self->frame_current.y.data
+			+ ((self->mb_row << 4) + ((block & 2) << 2)) * self->luma_width
+			+ (self->mb_col << 4) + ((block & 1) << 3);
+	} else {
+		scan = self->chroma_width - 8;
+		uint8_t *plane = (block == 4) ? self->frame_current.cb.data : self->frame_current.cr.data;
+		d = plane + (self->mb_row << 3) * self->chroma_width + (self->mb_col << 3);
+	}
+
+	int *s = self->block_data;
+	if (self->macroblock_intra) {
+		for (int sy = 0; sy < 8; sy++) {
+			for (int sx = 0; sx < 8; sx++) {
+				*d++ = plm_clamp(*s);
+				*s++ = 0;
+			}
+			d += scan;
+		}
+	} else {
+		for (int sy = 0; sy < 8; sy++) {
+			for (int sx = 0; sx < 8; sx++) {
+				int val = *d + *s;
+				*d++ = plm_clamp(val);
+				*s++ = 0;
+			}
+			d += scan;
+		}
+	}
+}
+
+static int apeg_decode_motion_vector(plm_buffer_t *buf, int r_size, int motion)
+{
+	int m_code = plm_buffer_read_vlc(buf, APEG_VLC_MOTION);
+	if (m_code <= 0) {
+		return motion;
+	}
+	int sign = plm_buffer_read(buf, 1);
+	int r = (r_size > 0) ? plm_buffer_read(buf, r_size) : 0;
+	int d = ((m_code - 1) << r_size) + r + 1;
+	if (sign) {
+		d = -d;
+	}
+	motion += d;
+	int max_val = (16 << r_size) - 1;
+	int min_val = -(16 << r_size);
+	int range = 32 << r_size;
+	if (motion > max_val)
+		motion -= range;
+	else if (motion < min_val)
+		motion += range;
+	return motion;
+}
+
+static void apeg_decode_picture(plm_video_t *self, int pic_type)
+{
+	self->picture_type = pic_type;
+	self->quantizer_scale = 1;
+	if (pic_type == PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
+		self->motion_forward.full_px = plm_buffer_read(self->buffer, 1);
+		self->motion_forward.r_size = plm_buffer_read(self->buffer, 3);
+		plm_buffer_skip(self->buffer, 4);
+	} else if (pic_type == PLM_VIDEO_PICTURE_TYPE_B) {
+		self->motion_forward.full_px = plm_buffer_read(self->buffer, 1);
+		self->motion_forward.r_size = plm_buffer_read(self->buffer, 3);
+		self->motion_backward.full_px = plm_buffer_read(self->buffer, 1);
+		self->motion_backward.r_size = plm_buffer_read(self->buffer, 3);
+	}
+
+	self->dc_predictor[0] = 128;
+	self->dc_predictor[1] = 128;
+	self->dc_predictor[2] = 128;
+	self->motion_forward.h = 0;
+	self->motion_forward.v = 0;
+	self->motion_backward.h = 0;
+	self->motion_backward.v = 0;
+	memset(self->block_data, 0, sizeof(self->block_data));
+
+	if (pic_type == PLM_VIDEO_PICTURE_TYPE_INTRA) {
+		for (int ma = 0; ma < self->mb_size; ma++) {
+			self->mb_row = ma / self->mb_width;
+			self->mb_col = ma % self->mb_width;
+			self->macroblock_address = ma;
+			self->macroblock_type = 0x01;
+			self->macroblock_intra = 1;
+			if (plm_buffer_read(self->buffer, 1) != 0) {
+				self->quantizer_scale = plm_buffer_read(self->buffer, 5);
+			}
+			for (int b = 0; b < 6; b++) {
+				apeg_decode_block(self, b);
+			}
+		}
+		return;
+	}
+
+	int ma = 0;
+	while (ma < self->mb_size) {
+		self->mb_row = ma / self->mb_width;
+		self->mb_col = ma % self->mb_width;
+		self->macroblock_address = ma;
+
+		int mb_type = plm_buffer_read_vlc(self->buffer,
+			pic_type == PLM_VIDEO_PICTURE_TYPE_PREDICTIVE ? APEG_VLC_MB_TYPE_P : APEG_VLC_MB_TYPE_B);
+		if (mb_type < 0)
+			return;
+
+		self->macroblock_type = mb_type;
+		self->macroblock_intra = (mb_type & 0x01);
+
+		if (self->macroblock_intra) {
+			self->motion_forward.h = 0;
+			self->motion_forward.v = 0;
+			self->motion_backward.h = 0;
+			self->motion_backward.v = 0;
+			self->motion_forward.is_set = FALSE;
+			self->motion_backward.is_set = FALSE;
+		} else {
+			self->dc_predictor[0] = 128;
+			self->dc_predictor[1] = 128;
+			self->dc_predictor[2] = 128;
+			self->motion_forward.is_set = (mb_type & 0x08) != 0;
+			self->motion_backward.is_set = (mb_type & 0x04) != 0;
+
+			if (self->motion_forward.is_set) {
+				self->motion_forward.h = apeg_decode_motion_vector(self->buffer, self->motion_forward.r_size, self->motion_forward.h);
+				self->motion_forward.v = apeg_decode_motion_vector(self->buffer, self->motion_forward.r_size, self->motion_forward.v);
+			} else if (pic_type == PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
+				self->motion_forward.h = 0;
+				self->motion_forward.v = 0;
+				self->motion_forward.is_set = TRUE;
+			}
+
+			if (self->motion_backward.is_set) {
+				self->motion_backward.h = apeg_decode_motion_vector(self->buffer, self->motion_backward.r_size, self->motion_backward.h);
+				self->motion_backward.v = apeg_decode_motion_vector(self->buffer, self->motion_backward.r_size, self->motion_backward.v);
+			}
+
+			plm_video_predict_macroblock(self);
+		}
+
+		int cbp = 0;
+		if (self->macroblock_intra) {
+			cbp = 0x3f;
+		} else if (mb_type & 0x02) {
+			cbp = plm_buffer_read_vlc(self->buffer, APEG_VLC_CBP);
+			if (cbp < 0)
+				return;
+		}
+
+		if (mb_type & 0x10) {
+			self->quantizer_scale = plm_buffer_read(self->buffer, 5);
+		}
+
+		int skip = 0;
+		while (TRUE) {
+			int v = plm_buffer_read_vlc(self->buffer, APEG_VLC_SKIP);
+			if (v == -1) {
+				skip += 35;
+			} else if (v >= 0) {
+				skip += v;
+				break;
+			} else {
+				return;
+			}
+		}
+
+		for (int b = 0, mask = 0x20; b < 6; b++, mask >>= 1) {
+			if (cbp & mask) {
+				apeg_decode_block(self, b);
+			}
+		}
+
+		if (skip > 0) {
+			self->dc_predictor[0] = 128;
+			self->dc_predictor[1] = 128;
+			self->dc_predictor[2] = 128;
+			if (pic_type == PLM_VIDEO_PICTURE_TYPE_PREDICTIVE) {
+				self->motion_forward.h = 0;
+				self->motion_forward.v = 0;
+				self->motion_forward.is_set = TRUE;
+				self->motion_backward.is_set = FALSE;
+			}
+			for (int s = 0; s < skip && ma + 1 < self->mb_size; s++) {
+				ma++;
+				self->mb_row = ma / self->mb_width;
+				self->mb_col = ma % self->mb_width;
+				self->macroblock_address = ma;
+				plm_video_predict_macroblock(self);
+			}
+		}
+
+		ma++;
+	}
+}
+
+/* Display order is the donor's I/P reference rotation followed by B pictures.
+ * Only compressed picture data is buffered; the three YCbCr frames are reused. */
+static plm_frame_t *apeg_decode_next_frame(struct apeg_decoder *apeg, int skip_b_before_ms)
+{
+	if (apeg->eof)
+		return NULL;
+	while (!apeg->eof) {
+		uint8_t chdr[8];
+		long chunk_pos = ftell(apeg->fp);
+		if (chunk_pos < 0)
+			break;
+		if (chunk_pos == apeg->file_size) {
+			apeg->eof = true;
+			if (apeg->has_ref) {
+				apeg->has_ref = false;
+				return &apeg->vdec->frame_backward;
+			}
+			return NULL;
+		}
+		if (fread(chdr, 1, sizeof(chdr), apeg->fp) != sizeof(chdr))
+			break;
+		uint32_t csz = LittleEndian_getDW(chdr, 4);
+		if ((uint64_t)chunk_pos + 8 + csz > (uint64_t)apeg->file_size)
+			break;
+		bool is_ipic = !memcmp(chdr, "IPIC", 4);
+		bool is_ppic = !memcmp(chdr, "PPIC", 4);
+		bool is_bpic = !memcmp(chdr, "BPIC", 4);
+		if (!is_ipic && !is_ppic && !is_bpic) {
+			if (fseek(apeg->fp, (long)csz, SEEK_CUR) != 0)
+				break;
+			continue;
+		}
+		if (csz <= 4 || (is_ppic && !apeg->has_ref))
+			break;
+		uint8_t ts_buf[4];
+		if (fread(ts_buf, 1, sizeof(ts_buf), apeg->fp) != sizeof(ts_buf))
+			break;
+		uint32_t chunk_ts = LittleEndian_getDW(ts_buf, 0);
+		uint32_t payload_sz = csz - 4;
+		if (chunk_ts > INT_MAX)
+			break;
+		if (is_bpic && (!apeg->has_both_refs || (int)chunk_ts < skip_b_before_ms)) {
+			if (fseek(apeg->fp, (long)payload_sz, SEEK_CUR) != 0)
+				break;
+			continue;
+		}
+
+		/* Read directly into the reusable bit buffer, without a second copy. */
+		if ((uint64_t)payload_sz + 8 > SIZE_MAX)
+			break;
+		size_t needed = (size_t)payload_sz + 8;
+		if (needed > apeg->bitbuf->capacity) {
+			size_t capacity = needed <= SIZE_MAX / 2 ? needed * 2 : needed;
+			apeg->bitbuf->bytes = xrealloc(apeg->bitbuf->bytes, capacity);
+			apeg->bitbuf->capacity = capacity;
+		}
+		if (fread(apeg->bitbuf->bytes, 1, payload_sz, apeg->fp) != payload_sz)
+			break;
+		memset(apeg->bitbuf->bytes + payload_sz, 0, 8);
+		apeg->bitbuf->length = needed;
+		apeg->bitbuf->bit_index = 0;
+		apeg->bitbuf->has_ended = FALSE;
+
+		if (is_ipic || is_ppic) {
+			plm_frame_t frame_temp = apeg->vdec->frame_forward;
+			apeg->vdec->frame_forward = apeg->vdec->frame_backward;
+			apeg_decode_picture(apeg->vdec, is_ipic ? PLM_VIDEO_PICTURE_TYPE_INTRA : PLM_VIDEO_PICTURE_TYPE_PREDICTIVE);
+			apeg->vdec->frame_current.time = (double)chunk_ts / 1000.0;
+			apeg->vdec->frame_backward = apeg->vdec->frame_current;
+			apeg->vdec->frame_current = frame_temp;
+			if (apeg->has_ref) {
+				apeg->has_both_refs = true;
+				return &apeg->vdec->frame_forward;
+			}
+			apeg->has_ref = true;
+		} else {
+			apeg_decode_picture(apeg->vdec, PLM_VIDEO_PICTURE_TYPE_B);
+			apeg->vdec->frame_current.time = (double)chunk_ts / 1000.0;
+			return &apeg->vdec->frame_current;
+		}
+	}
+	apeg->eof = true;
+	WARNING("APEG: invalid or unreadable picture chunk");
+	return NULL;
+}
+
+void apeg_decoder_close(struct apeg_decoder *apeg)
+{
+	if (!apeg)
+		return;
+	if (apeg->vdec)
+		plm_video_destroy(apeg->vdec);
+	else if (apeg->bitbuf)
+		plm_buffer_destroy(apeg->bitbuf);
+	free(apeg->keyframes);
+	if (apeg->fp)
+		fclose(apeg->fp);
+	free(apeg);
+}
+
+struct apeg_decoder *apeg_decoder_open(FILE *fp)
+{
+	if (!fp)
+		return NULL;
+	struct apeg_decoder *apeg = xcalloc(1, sizeof(*apeg));
+	apeg->fp = fp;
+	uint8_t *hdr = NULL;
+	if (fseek(fp, 0, SEEK_END) != 0 || (apeg->file_size = ftell(fp)) < 0
+		|| fseek(fp, 0, SEEK_SET) != 0)
+		goto fail;
+	uint8_t pre[8];
+	if (fread(pre, 1, sizeof(pre), fp) != sizeof(pre) || memcmp(pre, "APEG", 4))
+		goto fail;
+	uint32_t hdr_size = LittleEndian_getDW(pre, 4);
+	if (hdr_size < 0x90 || hdr_size > 16 * 1024 * 1024
+		|| (uint64_t)hdr_size + 8 > (uint64_t)apeg->file_size)
+		goto fail;
+	hdr = xmalloc(hdr_size);
+	if (fread(hdr, 1, hdr_size, fp) != hdr_size)
+		goto fail;
+	apeg->width = LittleEndian_getW(hdr, 0x04);
+	apeg->height = LittleEndian_getW(hdr, 0x06);
+	uint32_t duration = LittleEndian_getDW(hdr, 0x88);
+	if (apeg->width <= 0 || apeg->width > 4096 || apeg->height <= 0
+		|| apeg->height > 4096 || duration == 0 || duration > INT_MAX)
+		goto fail;
+	apeg->end_time_ms = (int)duration;
+	apeg->keyframe_count = LittleEndian_getDW(hdr, 0x8c);
+	if (apeg->keyframe_count > (hdr_size - 0x90) / 8)
+		goto fail;
+	if (apeg->keyframe_count) {
+		apeg->keyframes = xcalloc(apeg->keyframe_count, sizeof(*apeg->keyframes));
+		for (uint32_t i = 0; i < apeg->keyframe_count; i++) {
+			struct apeg_keyframe *kf = &apeg->keyframes[i];
+			kf->time_ms = LittleEndian_getDW(hdr, 0x90 + i * 8);
+			kf->file_offset = LittleEndian_getDW(hdr, 0x94 + i * 8);
+			if (kf->time_ms > duration || (i && kf->time_ms < apeg->keyframes[i - 1].time_ms)
+				|| (uint64_t)kf->file_offset + 12 > (uint64_t)apeg->file_size)
+				goto fail;
+		}
+	}
+
+	/* Locate SOND without loading it, then leave fp at the first I picture. */
+	for (;;) {
+		long chunk_pos = ftell(fp);
+		uint8_t chdr[8];
+		if (chunk_pos < 0 || fread(chdr, 1, sizeof(chdr), fp) != sizeof(chdr))
+			goto fail;
+		uint32_t csz = LittleEndian_getDW(chdr, 4);
+		if ((uint64_t)chunk_pos + 8 + csz > (uint64_t)apeg->file_size)
+			goto fail;
+		if (!memcmp(chdr, "IPIC", 4) || !memcmp(chdr, "PPIC", 4) || !memcmp(chdr, "BPIC", 4)) {
+			if (memcmp(chdr, "IPIC", 4) || csz <= 4 || fseek(fp, chunk_pos, SEEK_SET) != 0)
+				goto fail;
+			apeg->first_chunk_offset = chunk_pos;
+			break;
+		}
+		if (!memcmp(chdr, "SOND", 4) && csz && !apeg->sound_size) {
+			apeg->sound_offset = chunk_pos + 8;
+			apeg->sound_size = csz;
+		}
+		if (fseek(fp, (long)csz, SEEK_CUR) != 0)
+			goto fail;
+	}
+	for (uint32_t i = 0; i < apeg->keyframe_count; i++) {
+		if (apeg->keyframes[i].file_offset < (uint64_t)apeg->first_chunk_offset)
+			goto fail;
+	}
+
+	apeg->bitbuf = plm_buffer_create_with_capacity(64 * 1024);
+	apeg->vdec = plm_video_create_with_buffer(apeg->bitbuf, TRUE);
+	plm_video_t *vdec = apeg->vdec;
+	vdec->width = apeg->width;
+	vdec->height = apeg->height;
+	vdec->mb_width = (apeg->width + 15) >> 4;
+	vdec->mb_height = (apeg->height + 15) >> 4;
+	vdec->mb_size = vdec->mb_width * vdec->mb_height;
+	vdec->luma_width = vdec->mb_width << 4;
+	vdec->luma_height = vdec->mb_height << 4;
+	vdec->chroma_width = vdec->mb_width << 3;
+	vdec->chroma_height = vdec->mb_height << 3;
+	size_t frame_data_size = (size_t)vdec->mb_size * 384;
+	vdec->frames_data = xcalloc(3, frame_data_size);
+	plm_video_init_frame(vdec, &vdec->frame_current, vdec->frames_data);
+	plm_video_init_frame(vdec, &vdec->frame_forward, vdec->frames_data + frame_data_size);
+	plm_video_init_frame(vdec, &vdec->frame_backward, vdec->frames_data + frame_data_size * 2);
+	memcpy(vdec->intra_quant_matrix, hdr + 0x08, 64);
+	memcpy(vdec->non_intra_quant_matrix, hdr + 0x48, 64);
+	vdec->has_sequence_header = TRUE;
+	free(hdr);
+	return apeg;
+
+fail:
+	WARNING("APEG: invalid header or unreadable movie file");
+	free(hdr);
+	apeg_decoder_close(apeg);
+	return NULL;
+}
+
+int apeg_decoder_width(struct apeg_decoder *apeg) { return apeg->width; }
+int apeg_decoder_height(struct apeg_decoder *apeg) { return apeg->height; }
+int apeg_decoder_duration(struct apeg_decoder *apeg) { return apeg->end_time_ms; }
+
+unsigned char *apeg_decoder_read_sound(struct apeg_decoder *apeg, size_t *size)
+{
+	*size = 0;
+	if (!apeg->sound_size)
+		return NULL;
+	fpos_t pos;
+	if (fgetpos(apeg->fp, &pos) != 0)
+		return NULL;
+	unsigned char *data = malloc(apeg->sound_size);
+	if (!data)
+		return NULL;
+	bool ok = fseek(apeg->fp, apeg->sound_offset, SEEK_SET) == 0
+		&& fread(data, 1, apeg->sound_size, apeg->fp) == apeg->sound_size;
+	if (fsetpos(apeg->fp, &pos) != 0) {
+		WARNING("APEG: cannot restore video cursor after reading sound");
+		apeg->pending_frame = NULL;
+		apeg->eof = true;
+		ok = false;
+	}
+	if (!ok) {
+		free(data);
+		return NULL;
+	}
+	*size = apeg->sound_size;
+	return data;
+}
+
+bool apeg_decoder_seek(struct apeg_decoder *apeg, int msec)
+{
+	if (msec < 0)
+		msec = 0;
+	if (msec > apeg->end_time_ms)
+		msec = apeg->end_time_ms;
+	long offset = apeg->first_chunk_offset;
+	for (uint32_t i = 0; i < apeg->keyframe_count; i++) {
+		if (apeg->keyframes[i].time_ms > (uint32_t)msec)
+			break;
+		offset = (long)apeg->keyframes[i].file_offset;
+	}
+	apeg->pending_frame = NULL;
+	apeg->seek_frame_due = false;
+	if (fseek(apeg->fp, offset, SEEK_SET) != 0) {
+		apeg->eof = true;
+		return false;
+	}
+	apeg->has_ref = false;
+	apeg->has_both_refs = false;
+	apeg->eof = false;
+	int skip_b_before_ms = msec - 33;
+	plm_frame_t *frame = apeg_decode_next_frame(apeg, skip_b_before_ms);
+	while (frame && frame->time * 1000.0 + 16.0 < (double)msec && !apeg->eof) {
+		plm_frame_t *next = apeg_decode_next_frame(apeg, skip_b_before_ms);
+		if (!next)
+			break;
+		frame = next;
+	}
+	apeg->pending_frame = frame;
+	apeg->seek_frame_due = frame != NULL;
+	return frame != NULL;
+}
+
+plm_frame_t *apeg_decoder_frame(struct apeg_decoder *apeg, int msec)
+{
+	if (msec < 0)
+		msec = 0;
+	if (msec > apeg->end_time_ms)
+		msec = apeg->end_time_ms;
+	if (!apeg->pending_frame)
+		apeg->pending_frame = apeg_decode_next_frame(apeg, msec - 33);
+	plm_frame_t *frame = apeg->pending_frame;
+	if (!frame || (!apeg->seek_frame_due && frame->time > (double)msec / 1000.0))
+		return NULL;
+	/* Match the donor's 35 ms catch-up window and old-B-picture skipping.
+	 * Only the final candidate reaches the renderer, so each update uploads
+	 * at most one YCbCr frame. */
+	while (frame->time + 0.035 < (double)msec / 1000.0 && !apeg->eof) {
+		plm_frame_t *next = apeg_decode_next_frame(apeg, msec - 33);
+		if (!next)
+			break;
+		frame = next;
+	}
+	if (!apeg->seek_frame_due && frame->time > (double)msec / 1000.0) {
+		apeg->pending_frame = frame;
+		return NULL;
+	}
+	apeg->pending_frame = NULL;
+	apeg->seek_frame_due = false;
+	return frame;
+}
