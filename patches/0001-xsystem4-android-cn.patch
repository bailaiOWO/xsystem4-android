+}
+
+static void csd_serialize(struct ht_slot *slot, void *data)
+{
+	struct buffer *out = data;
+	struct csd_datum *d = slot->value;
+	buffer_write_int32(out, strlen(slot->key));
+	buffer_write_int32(out, d->type);
+	buffer_write_int32(out, d->type == CSD_STRING ? d->value.s->size : 4);
+	buffer_write_cstring(out, slot->key);
+	if (d->type == CSD_STRING)
+		buffer_write_bytes(out, (uint8_t*)d->value.s->text, d->value.s->size);
+	else if (d->type == CSD_FLOAT)
+		buffer_write_float(out, d->value.f);
+	else
+		buffer_write_int32(out, d->value.i);
+	uint32_t count = LittleEndian_getDW(out->buf, 8);
+	buffer_write_int32_at(out, 8, count + 1);
+}
+
+static bool csd_save(void)
+{
+	if (!save_path) return true;
+	struct buffer out;
+	buffer_init(&out, NULL, 0);
+	// A port-specific sidecar preserves the PC engine's unrelated file format.
+	buffer_write_bytes(&out, (const uint8_t*)"XCSData\1", 8);
+	buffer_write_int32(&out, 0);
+	ht_foreach(csd_table(), csd_serialize, &out);
+	bool ok = atomic_file_write(save_path, out.buf, out.index);
+	free(out.buf);
+	if (!ok)
+		WARNING("Could not write CommonSystemData sidecar");
+	return ok;
