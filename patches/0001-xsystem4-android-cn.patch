+/* Parsed timelines and uploaded images are immutable. Animation state and CG
+ * replacements belong to each instance. Retain unused resources in a bounded
+ * LRU, so reopening menus does not decode and upload every button again. */
+struct flat_resource {
+	struct flat_resource *next;
+	struct string *name;
+	struct flat *flat;
+	Texture *textures;
+	struct flat_stop_motion_frames *stop_motion_frames;
+	size_t nr_libraries, bytes;
+	unsigned refs, used;
+};
+static struct flat_resource *flat_resources;
+static size_t flat_cache_bytes;
+static unsigned flat_cache_clock;
+
+static void flat_cache_trim(size_t limit)
+{
+	while (flat_cache_bytes > limit) {
+		struct flat_resource **oldest = NULL;
+		for (struct flat_resource **p=&flat_resources; *p; p=&(*p)->next)
+			if (!(*p)->refs && (!oldest || (*p)->used < (*oldest)->used)) oldest=p;
+		if (!oldest) break; // Active resources are never evicted.
+		struct flat_resource *r=*oldest; *oldest=r->next;
+		for (size_t i=0;i<r->nr_libraries;i++) {
+			gfx_delete_texture(&r->textures[i]);
+			free(r->stop_motion_frames[i].lib_indices);
+		}
+		free(r->textures); free(r->stop_motion_frames);
+		flat_free(r->flat); free_string(r->name);
+		flat_cache_bytes-=r->bytes; free(r);
+	}
+}
+void parts_flat_cache_clear(void) { flat_cache_trim(0); }
+
+static void flat_resource_acquire(struct parts_flat *f, struct flat_resource *r)
+{
+	f->resource=r; r->refs++; r->used=++flat_cache_clock;
+	f->flat=r->flat; f->nr_libraries=r->nr_libraries;
+	f->textures=xmalloc(r->nr_libraries*sizeof(*f->textures));
+	memcpy(f->textures,r->textures,r->nr_libraries*sizeof(*f->textures));
+	f->stop_motion_frames=r->stop_motion_frames;
+}
 
