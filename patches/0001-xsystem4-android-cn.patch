+static void PA_RefreshCheckBox(int number)
+{
+	struct parts *p = parts_get(number);
+	struct parts *linked;
+	PARTS_LIST_FOREACH(linked) {
+		if (linked->check_show_link == number)
+			parts_set_check_link_hidden(linked, !p->checkbox_checked);
+	}
+	for (int i=0;i<PARTS_NR_STATES;i++) {
+		struct string *name=pa_checkbox_flat_name(p,i);
+		if (name) {
+			PE_SetPartsFlat(number,name,i+1); free_string(name);
+		} else {
+			struct string *cg=p->checkbox_checked && p->checkbox_checked_cg && p->checkbox_checked_cg->size
+				? p->checkbox_checked_cg : p->checkbox_cg;
+			if (cg && cg->size) PE_SetPartsCG(number,cg,0,i+1);
+			else pa_checkbox_default(p,i);
+		}
+	}
+	PE_SetComponentType(number,1,1);
+	parts_dirty(p);
+}
+void PE_CheckBoxChecked(int number, bool checked)
+{
+	struct parts *p = parts_get(number);
+	if (checked) {
+		struct parts *group;
+		PARTS_LIST_FOREACH(group) {
+			if (!PA_IsRadioButtonBoxExistGUI(group->no,number)) continue;
+			for (int i=0;i<group->nr_radio_children;i++) {
+				struct parts *other=parts_try_get(group->radio_children[i]);
+				if (other && other!=p && other->checkbox_checked) {
+					other->checkbox_checked=false; PA_RefreshCheckBox(other->no);
+				}
+			}
+		}
+	}
+	if (p->checkbox_checked == checked) return;
+	p->checkbox_checked = checked;
+	PA_RefreshCheckBox(number);
+}
+static bool PA_IsCheckBoxChecked(int number) { return parts_get(number)->checkbox_checked; }
+void parts_checkbox_click(struct parts *p)
+{
+	bool radio = false;
+	bool was_checked = p->checkbox_checked;
+	struct parts *group;
+	PARTS_LIST_FOREACH(group) {
+		if (PA_IsRadioButtonBoxExistGUI(group->no, p->no)) { radio = true; break; }
+	}
+	PE_CheckBoxChecked(p->no, radio || !p->checkbox_checked);
+	if (was_checked != p->checkbox_checked) {
+		parts_msg_push(p, PARTS_MSG_CHANGED_FLAG, "b", p->checkbox_checked);
+		PARTS_LIST_FOREACH(group) {
+			if (PA_IsRadioButtonBoxExistGUI(group->no, p->no))
+				parts_msg_push(group, PARTS_MSG_CHANGED, "");
+		}
+	}
+}
