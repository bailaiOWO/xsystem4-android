diff --git a/src/parts/message_window.inc b/src/parts/message_window.inc
new file mode 100644
index 0000000..1534ee6
--- /dev/null
+++ b/src/parts/message_window.inc
@@ -0,0 +1,297 @@
+/* Native message windows used by PartsEngine 2. SPDX-License-Identifier: GPL-2.0-or-later
+ * Included in text.c to share the glyph renderer and its lifetime rules.
+ */
+#include <limits.h>
+#include <stdio.h>
+#include "parts.h"
+#include "message_window.h"
+
+struct parts_message_window *parts_message_get(struct parts *parts)
+{
+	if (!parts->message) {
+		parts->message = xcalloc(1, sizeof(*parts->message));
+		struct parts_state initial = {0};
+		parts_state_reset(&initial, PARTS_TEXT);
+		parts->message->text = initial.text;
+		parts->message->source = string_ref(&EMPTY_STRING);
+		parts->message->origin_mode = 1;
+		parts->message->speed = 23;
+		parts->message->inactive_color = (SDL_Color){255,255,255,255};
+	}
+	if (parts->component_type_override != 8 && parts->component_type_override != 2)
+		parts->component_type_override = 11; // modern MessageWindow component = 10
+	return parts->message;
+}
+
+void parts_message_free(struct parts_message_window *m)
+{
+	if (!m) return;
+	parts_text_free(&m->text);
+	parts_state_reset(&m->keywait, PARTS_UNINITIALIZED);
+	free_string(m->source);
+	free(m->read_spans);
+	free(m);
+}
+
+bool parts_message_update(struct parts_message_window *m, int passed_time)
+{
+	bool dirty = false;
+	if (passed_time > 0 && m->elapsed < m->duration) {
+		m->elapsed += min(passed_time, m->duration - m->elapsed);
+		dirty = true;
+	}
+	if (m->keywait_show) {
+		if (m->keywait.type == PARTS_FLAT)
+			dirty |= parts_flat_update(&m->keywait.flat, passed_time);
+		else if (m->keywait.type == PARTS_ANIMATION) {
+			struct parts_animation *a = &m->keywait.anim;
+			if (a->nr_frames && a->frame_time && passed_time > 0) {
+				a->elapsed += passed_time;
+				a->current_frame = (a->current_frame + a->elapsed/a->frame_time) % a->nr_frames;
+				a->elapsed %= a->frame_time;
+				a->common.texture = a->frames[a->current_frame];
+				dirty = true;
+			}
+		}
+	}
+	return dirty;
+}
+
+static bool message_font_tag(struct text_style *ts, const char *tag)
+{
+	char key[24]; float value;
+	if (sscanf(tag, "font %23[^=]=%f", key, &value) != 2) return false;
+	if (!strcmp(key, "type")) ts->face = value;
+	else if (!strcmp(key, "size")) ts->size = max(1, value);
+	else if (!strcmp(key, "r")) ts->color.r = value;
+	else if (!strcmp(key, "g")) ts->color.g = value;
+	else if (!strcmp(key, "b")) ts->color.b = value;
+	else if (!strcmp(key, "er")) ts->edge_color.r = value;
+	else if (!strcmp(key, "eg")) ts->edge_color.g = value;
+	else if (!strcmp(key, "eb")) ts->edge_color.b = value;
+	else if (!strcmp(key, "bold")) { ts->bold_width = value; ts->weight = value * 1000; }
+	else if (!strcmp(key, "edge")) text_style_set_edge_width(ts, value);
+	else if (!strcmp(key, "tracking")) ts->font_spacing = value;
+	else return false;
+	ts->font_size = NULL;
+	return true;
+}
+
+void parts_message_rebuild(struct parts *parts)
+{
+	struct parts_message_window *m = parts->message;
+	struct parts_text *t = &m->text;
+	struct text_style base = t->ts, styles[32];
+	int speeds[32], line_spaces[32], style_depth = 0, speed_depth = 0;
+	int base_line_space = t->line_space, line_space = base_line_space;
+	int interval = m->speed, duration = 0, read_span = 0;
+	parts_text_free(t);
+	memset(&t->common, 0, sizeof(t->common));
+	t->lines = xcalloc(1, sizeof(*t->lines));
+	t->nr_lines = 1;
+	for (const char *p = m->source->text; *p;) {
+		if (parts->component_type_override != 8 && p[0] == '$' && p[1] == '{') {
+			const char *end = strchr(p+2, '}');
+			if (end && end-p < 128) {
+				char tag[128]; memcpy(tag, p+2, end-p-2); tag[end-p-2] = 0;
+				bool handled = false; int ms;
+				if (sscanf(tag, "time %d", &ms) == 1 && speed_depth < 32) {
+					speeds[speed_depth++] = interval; interval = max(0, ms); handled = true;
+				} else if (!strcmp(tag, "/time")) {
+					interval = speed_depth ? speeds[--speed_depth] : m->speed; handled = true;
+				} else if (!strcmp(tag, "/font")) {
+					if (style_depth) { --style_depth; t->ts = styles[style_depth]; line_space = line_spaces[style_depth]; }
+					else { t->ts = base; line_space = base_line_space; }
+					handled = true;
+				} else if (style_depth < 32) {
+					struct text_style changed = t->ts;
+					int leading;
+					if (sscanf(tag, "font leading=%d", &leading) == 1) {
+						styles[style_depth] = t->ts; line_spaces[style_depth++] = line_space;
+						line_space = leading; handled = true;
+					} else if (message_font_tag(&changed, tag)) {
+						styles[style_depth] = t->ts; line_spaces[style_depth++] = line_space;
+						t->ts = changed; handled = true;
+					}
+				}
+				if (handled) { p = end + 1; continue; }
+			}
+		}
+		if (*p == '\r') { p++; continue; }
+		t->lines[t->nr_lines-1].extra_line_space = line_space - base_line_space;
+		if (*p == '\n') { p = parts_text_append_char(t,p); continue; }
+		char ch[4]; extract_sjis_char(p,ch);
+		struct parts_text_line *line = &t->lines[t->nr_lines-1];
+		if (m->area.w > 0 && line->nr_chars && line->width + gfx_size_char(&t->ts,ch) > m->area.w)
+			parts_text_append_char(t, "\n");
+		int offset = p - m->source->text;
+		while (read_span < m->nr_read_spans && offset >= m->read_spans[read_span].end)
+			read_span++;
+		SDL_Color original_color = t->ts.color;
+		if (read_span < m->nr_read_spans && offset >= m->read_spans[read_span].begin)
+			t->ts.color = m->read_spans[read_span].color;
+		p = parts_text_append_char(t,p);
+		t->ts.color = original_color;
+		line = &t->lines[t->nr_lines-1];
+		duration += min(interval, INT_MAX - duration);
+		line->chars[line->nr_chars-1].show_at = duration;
+	}
+	t->ts = base;
+	int width = 0, height = 0;
+	for (unsigned i=0; i<t->nr_lines; i++) {
+		width = max(width, (int)ceilf(t->lines[i].width));
+		height += t->lines[i].height + (i ? t->line_space + t->lines[i-1].extra_line_space : 0);
+	}
+	t->common.w = width; t->common.h = height;
+	m->duration = duration;
+	parts_dirty(parts);
+}
+
+#define MW(no) parts_message_get(parts_get(no))
+void PE_SetMessageWindowActive(int no, bool active) { MW(no)->active=active; parts_dirty(parts_get(no)); }
+void PE_SetMessageWindowInactiveMultipleColor(int no,int r,int g,int b) { MW(no)->inactive_color=(SDL_Color){r,g,b,255}; parts_dirty(parts_get(no)); }
+int PE_GetMessageWindowInactiveMultipleColorR(int no) { return MW(no)->inactive_color.r; }
+int PE_GetMessageWindowInactiveMultipleColorG(int no) { return MW(no)->inactive_color.g; }
+int PE_GetMessageWindowInactiveMultipleColorB(int no) { return MW(no)->inactive_color.b; }
+void PE_SetMessageWindowCGName(int no,struct string *name) { MW(no); PE_SetPartsCG(no,name,0,1); }
+struct string *PE_GetMessageWindowCGName(int no) { struct parts *p=parts_get(no); return string_ref(p->states[0].type==PARTS_CG && p->states[0].cg.name ? p->states[0].cg.name : &EMPTY_STRING); }
+void PE_SetMessageWindowFlatName(int no,struct string *name) { MW(no); PE_SetPartsFlat(no,name,1); }
+struct string *PE_GetMessageWindowFlatName(int no) { struct parts *p=parts_get(no); return string_ref(p->states[0].type==PARTS_FLAT && p->states[0].flat.name ? p->states[0].flat.name : &EMPTY_STRING); }
+void PE_SetMessageWindowFlatShowWaitFrameNumber(int no,int frame) { MW(no)->flat_wait_frame=frame; }
+int PE_GetMessageWindowFlatShowWaitFrameNumber(int no) { return MW(no)->flat_wait_frame; }
+bool PE_IsOverMessageWindowFlatShowWaitFrame(int no) { return parts_get(no)->states[0].type!=PARTS_FLAT || PE_GetPartsFlatCurrentFrameNumber(no,1)>=MW(no)->flat_wait_frame; }
+bool PE_BackMessageWindowFlatBeginFrame(int no)
+{
+	// Scripts also reset windows with a static CG frame. The generic Flat
