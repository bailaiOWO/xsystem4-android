+bool PE_create_parts_movie(int parts_no, struct string *filename, possibly_unused int sound_id,
+		int sound_group, int r, int g, int b, int state)
+{
+	if (!parts_state_valid(state - 1))
+		return false;
+	struct parts *parts = parts_get(parts_no);
+	// Re-creating a movie must release the previous sprite and player.
+	parts_state_reset(&parts->states[state - 1], PARTS_UNINITIALIZED);
+	struct apeg_player *player = apeg_open(filename->text, sound_group);
+	if (!player)
+		return false;
+	if (!PE_init_parts_movie(parts_no, apeg_width(player), apeg_height(player), r, g, b, state)) {
+		apeg_close(player);
+		return false;
+	}
+	parts->states[state - 1].movie.player = player;
+	return true;
+}
+
+static struct apeg_player *parts_movie_player(int parts_no, int state)
+{
+	struct parts *parts = parts_try_get(parts_no);
+	if (!parts || !parts_state_valid(state - 1) || parts->states[state - 1].type != PARTS_MOVIE)
+		return NULL;
+	return parts->states[state - 1].movie.player;
+}
+
+bool PE_release_parts_movie(int parts_no, int state)
+{
+	struct parts *parts = parts_try_get(parts_no);
+	if (!parts || !parts_state_valid(state - 1) || parts->states[state - 1].type != PARTS_MOVIE)
+		return false;
+	parts_state_reset(&parts->states[state - 1], PARTS_UNINITIALIZED);
+	parts_dirty(parts);
+	return true;
