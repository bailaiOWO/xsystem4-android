+
+volatile double sys_time_scale = 1.0;
+
+/* 当前倍率的生效基准：真实时间 X 对应缩放时间 Y */
+static volatile Uint64 scale_base_real;
+static volatile Uint64 scale_base_scaled;
+
+Uint64 sys_get_ticks64(void)
+{
+	Uint64 real = SDL_GetTicks64();
+	Uint64 base_real = scale_base_real;
+
+	if (base_real == 0) {
+		/* 第一次被调用：以当前时刻建立基准 */
+		scale_base_real = real;
+		scale_base_scaled = real;
+		return real;
+	}
+
+	/*
+	 * 不要在这里为 1.0 倍率开"直接返回 real"的捷径：时间轴一旦被缩放偏移过
+	 * （base_scaled != base_real），切回 1x 时那样会瞬间跳回真实时间，
+	 * 游戏里表现为换挡时画面猛跳一帧。统一走公式即可——基准未偏移时
+	 * 公式结果就等于 real，等价且连续。
+	 */
+	return scale_base_scaled + (Uint64)((real - base_real) * sys_time_scale);
+}
+
+Uint32 sys_get_ticks(void)
+{
+	return (Uint32)sys_get_ticks64();
+}
+
+void sys_delay(Uint32 ms)
+{
+	/*
+	 * 引擎里大量使用 SDL_Delay(t + 16 - now) 做帧率限制。时间被缩放后，
+	 * 已经流逝的"游戏时间"很容易超过 16ms，这个表达式就变成负数，
+	 * 经 Uint32 回绕成接近 2^32 的天文数字 —— SDL_Delay 会真的睡几十天，
+	 * 表现就是"一变速游戏就卡死、点不动"。回绕值都大于 2^31，据此识别。
+	 */
+	if (ms > 0x80000000u)
+		ms = 0;
+
+	double scale = sys_time_scale;
+	if (ms > 0 && scale != 1.0) {
+		double scaled = ms / scale;
+		if (scaled < 1.0)
+			scaled = 1.0;
+		ms = (Uint32)(scaled + 0.5);
+	}
+	SDL_Delay(ms);
+}
+
+void sys_set_time_scale(double scale)
+{
+	if (!(scale > 0.0))
+		scale = 1.0;
+	if (scale < 0.1)
+		scale = 0.1;
+	if (scale > 20.0)
+		scale = 20.0;
+
+	/*
+	 * 换挡时把基准挪到"此刻"，让时间轴保持连续：
+	 * 已流逝的部分按旧倍率算，之后的部分按新倍率算，不会跳帧。
+	 */
+	Uint64 real = SDL_GetTicks64();
+	Uint64 scaled = sys_get_ticks64();
+	scale_base_real = real;
+	scale_base_scaled = scaled;
+	sys_time_scale = scale;
+
+	NOTICE("TIMESCALE %.2fx (ticks=%llu)", scale, (unsigned long long)scaled);
+}
+
+#ifdef __ANDROID__
+#include <jni.h>
+
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeSetGameSpeed(
+	JNIEnv *env, jobject thiz, jint percent)
+{
+	(void)env;
+	(void)thiz;
+	sys_set_time_scale((double)percent / 100.0);
+}
+#endif
diff --git a/src/trace_log.c b/src/trace_log.c
new file mode 100644
index 0000000..6636db1
--- /dev/null
+++ b/src/trace_log.c
@@ -0,0 +1,398 @@
+/* Persistent gameplay trace for diagnosing reports after the fact.
+ *
+ * Logcat is cleared when the tablet reboots, which lost the only record of
+ * a Rance 10 session where quests ended at once without story, battles or
+ * rewards. This keeps a small, always-on record of the quest, story, skip
+ * and save flow beside the game's SaveData folder.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <SDL.h>
+
+#include "system4.h"
+#include "system4/ain.h"
+#include "system4/file.h"
+#include "system4/string.h"
+#include "system4/utfsjis.h"
+
+#define VM_PRIVATE
+#include "vm.h"
+#include "vm/heap.h"
+#include "vm/page.h"
+#include "xsystem4.h"
+#include "trace_log.h"
+
+#define TRACE_MAX_BYTES (1024 * 1024)
+
+static FILE *trace_file;
+static bool trace_unavailable;
+static long trace_size;
+static char last_line[512];
+static unsigned repeats;
+
+static char *trace_path(const char *suffix)
+{
+	/* The game folder (parent of SaveData) is where users already look for
+	 * saves; the emulator home may be private app storage. */
+	const char *base = config.save_dir;
+	size_t len = 0;
+	if (base) {
+		const char *slash = strrchr(base, '/');
+		len = slash ? (size_t)(slash - base) : 0;
+	}
+	if (!len) {
+		base = config.home_dir;
+		len = base ? strlen(base) : 0;
+	}
+	if (!len)
+		return NULL;
+	const char *name = "/xsystem4-trace.txt";
+	char *path = xmalloc(len + strlen(name) + strlen(suffix) + 1);
+	memcpy(path, base, len);
+	strcpy(path + len, name);
+	strcat(path, suffix);
+	return path;
+}
+
+static bool trace_open(void)
+{
+	if (trace_file)
+		return true;
+	if (trace_unavailable)
+		return false;
+	char *path = trace_path("");
+	trace_file = path ? file_open_utf8(path, "ab") : NULL;
+	free(path);
+	if (!trace_file) {
+		trace_unavailable = true;
+		return false;
+	}
+	fseek(trace_file, 0, SEEK_END);
+	trace_size = ftell(trace_file);
+	return true;
+}
+
+static void trace_rotate(void)
+{
+	fclose(trace_file);
+	trace_file = NULL;
+	char *path = trace_path(""), *old = trace_path(".1");
+	if (path && old) {
+		remove(old);
+		rename(path, old);
+	}
+	free(path);
+	free(old);
+	trace_size = 0;
+}
+
+static void trace_write(const char *line)
+{
+	time_t now = time(NULL);
+	struct tm *tm = localtime(&now);
+	if (repeats) {
+		int n = fprintf(trace_file, "                (repeated %u more times)\n", repeats);
+		if (n > 0) trace_size += n;
+		repeats = 0;
+	}
+	int n = fprintf(trace_file, "%02d-%02d %02d:%02d:%02d %s\n",
+			tm ? tm->tm_mon + 1 : 0, tm ? tm->tm_mday : 0,
+			tm ? tm->tm_hour : 0, tm ? tm->tm_min : 0, tm ? tm->tm_sec : 0, line);
+	if (n > 0) trace_size += n;
+	fflush(trace_file);
+	if (trace_size > TRACE_MAX_BYTES)
+		trace_rotate();
+}
+
+void trace_log(const char *fmt, ...)
+{
+	char line[sizeof(last_line)];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (!strcmp(line, last_line)) {
+		repeats++;
+		return;
+	}
+	strcpy(last_line, line);
+	if (!trace_open())
+		return;
+	static bool session_marked;
+	if (!session_marked) {
+		session_marked = true;
+		trace_write("=== session start ===");
+	}
+	trace_write(line);
+}
+
+/* Quest, story, skip-mode and save entry points of the Rance 10 script.
+ * Names are the AIN's raw (GBK) bytes. */
+static const char *const traced_prefixes[] = {
+	"QuestScenes::",
+	"QuestEventProcess@Run",
+	"QuestEventProcess::Run",
+	"SceneQuestMap@Run",
+	"SceneAdvQuest@Run",
+	"Scenes::RunAdv",
+	"SceneAdv@Run",
+	"SnapShotSaveManager::Save",
+	"SnapShotSaveManager::Load",
+	"GameChapter1@Run",
+	"backscene::detail::CBackSceneView@",
+	"gamesave::detail::\xb4\xe6\xb5\xb5\x8cg\xd0\xd0", // 存档実行*
+};
+static const char *const traced_names[] = {
+	"SceneQuestSceneSet@Run",
+	"SceneQuestSceneSet@RunStacked",
+	"SceneQuestSceneSet@RunRegisteredQuest",
+	"SceneQuestSceneSet@ShowDialog",
+	"SceneQuestSceneSet@ProcessPostEvent",
+	"SceneQuestResult@Run",
+	"SceneQuestConfirmDialog@Run",
+	"SceneYakata@RunQuest",
+	"SceneBattle@Run",
+	"SceneGameOver@OnFinish",
+	"\xa3\xd3\xa3\xdf\xd2\xd1\xb6\xc1\xbf\xec\xbd\xf8", // Ｓ＿已读快进
+	"\xa3\xc1\xa3\xdf\xd2\xd1\xb6\xc1\xbf\xec\xbd\xf8\xc4\xa3\xca\xbd\xbd\xe2\xb3\xfd", // Ａ＿已读快进模式解除
+	"message::detail::\xbf\xec\xbd\xf8\xc4\xa3\xca\xbd\xc9\xe8\xb6\xa8", // 快进模式设定
+	"SceneQuestMap@CreateSelection",
+	"SceneQuestMap@OnClickSelection",
+	"SceneQuestMap@DebugForceExit",
+	"SceneQuestMap@Exit",
+	"BattleSceneSet@Open",
+	"\xa3\xd3\xa3\xdf\xb3\xa1\xbe\xb0\xbb\xd8\xb9\xcb", // Ｓ＿场景回顾
+	"backscene::detail::GetNumofADVScene",
+	"activity::detail::IsExistFile",
+	"\xa3\xd0\xa3\xdf\xa5\xa2\xa5\xaf\xa5\xc6\xa5\xa3\xa5\xd3\xa5\xc6\xa5\xa3\x8c" "g\xd0\xd0", // activity run
+	"SceneQuestSelect@GetResult",
+};
+
+/* The release script's DialogScenes::RunTestDialog is an empty function, yet
+ * every caller is an abnormal branch that silently abandons content:
+ *   SceneQuestMap@DebugForceExit  "no selections" / "no route": the quest
+ *                                 ends as finished, with no result screen;
+ *   SceneQuestSceneSet@ShowDialog "任务[%s]没有数据": the quest never runs;
+ *   SceneAdvQuest@Run             "无数据。任务完成。";
+ *   BattleSceneSet@Open           "敌方生成失败！": the battle is skipped.
+ * Tell the player at once, so they can load a save before progressing. */
+#define TRACE_ALERT 2
+static const char *const alert_names[] = {
+	"DialogScenes::RunTestDialog",
+};
+
+/* The base-camp quest list once returned "" for a confirmed choice, so the
+ * turn passed with "任务[]は登录されていません". Cause: a stale delegate
+ * entry released the closure of RunIScene's postEvent, so GetResult never ran
+ * (fixed in delegate_get). Record the list and the selected index of `this`
+ * on entry and exit of every step that touches them, to confirm the fix. */
+#define TRACE_DUMP_THIS 3
+static const char *const dump_names[] = {
+	"QuestList@Load",
+	"SceneQuestSelectBaseCamp@LoadQuestList",
+	"SceneQuestSelectBaseCamp@GetResult",
+	"SceneQuestSelectBaseCamp@<lambda : SceneQuestSelectBaseCamp@0(ref SceneStack)(43, 37)>",
+};
+
+/* Lambdas are not matched by the lists above (UI callbacks run every
+ * frame); these run only on a player's action. */
+static const char *const lambda_prefixes[] = {
+	"AdvShortcutButton@<lambda : AdvShortcutButton@Init()", // shortcut buttons
+};
+
+static struct ain *traced_ain;
+static unsigned char *traced;
+
+static void trace_init_functions(void)
+{
+	free(traced);
+	traced = xcalloc(ain->nr_functions ? ain->nr_functions : 1, 1);
+	traced_ain = ain;
+	if (ain->version < 11)
+		return;
+	for (int i = 0; i < ain->nr_functions; i++) {
+		const char *name = ain->functions[i].name;
+		bool dump = false;
+		for (size_t j = 0; name && j < sizeof(dump_names) / sizeof(*dump_names); j++)
+			if (!strcmp(name, dump_names[j]))
+				dump = true;
+		if (dump) {
+			traced[i] = TRACE_DUMP_THIS;
+			continue;
+		}
+		for (size_t j = 0; name && j < sizeof(lambda_prefixes) / sizeof(*lambda_prefixes); j++)
+			if (!strncmp(name, lambda_prefixes[j], strlen(lambda_prefixes[j])))
+				traced[i] = 1;
+		if (!name || strstr(name, "<lambda"))
+			continue;
+		for (size_t j = 0; j < sizeof(traced_names) / sizeof(*traced_names); j++)
+			if (!strcmp(name, traced_names[j]))
+				traced[i] = 1;
+		for (size_t j = 0; j < sizeof(traced_prefixes) / sizeof(*traced_prefixes); j++)
+			if (!strncmp(name, traced_prefixes[j], strlen(traced_prefixes[j])))
+				traced[i] = 1;
+		for (size_t j = 0; j < sizeof(alert_names) / sizeof(*alert_names); j++)
+			if (!strcmp(name, alert_names[j]))
+				traced[i] = TRACE_ALERT;
+	}
+}
+
+bool trace_function_enabled(int fno)
+{
+	if (traced_ain != ain)
+		trace_init_functions();
+	return fno >= 0 && fno < ain->nr_functions && traced[fno];
+}
+
+static int append_value(char *buf, int n, int size, int type, union vm_value v)
+{
+	if (n >= size - 1)
+		return n;
+	int r;
+	switch (type) {
+	case AIN_INT:
+	case AIN_BOOL:
+	case AIN_LONG_INT:
+	case AIN_ENUM:
+	case AIN_ENUM2:
+		r = snprintf(buf + n, size - n, " %d", v.i);
+		break;
+	case AIN_FLOAT:
+		r = snprintf(buf + n, size - n, " %g", v.f);
+		break;
+	case AIN_STRING: {
+		struct string *s = heap_index_valid(v.i) ? heap_get_string(v.i) : NULL;
+		r = snprintf(buf + n, size - n, " \"%.96s\"", s ? s->text : "?");
+		break;
+	}
+	default:
+		r = snprintf(buf + n, size - n, " <t%d>", type);
+		break;
+	}
+	return r < 0 ? n : n + r < size ? n + r : size - 1;
+}
+
+static void trace_alert(struct ain_function *f, struct page *locals)
+{
+	struct string *msg = NULL;
+	if (locals && f->nr_args >= 1 && f->vars[0].type.data == AIN_STRING
+			&& heap_index_valid(locals->values[0].i))
+		msg = heap_get_string(locals->values[0].i);
+	char *reason = msg ? sjis2utf(msg->text, msg->size) : xstrdup("(no message)");
+	char text[1024];
+	snprintf(text, sizeof(text),
+		"游戏脚本进入了异常分支（原版不提示，会直接跳过）：\n\n%s\n\n"
+		"刚才的任务、剧情或战斗可能已被跳过且没有奖励。"
+		"建议先不要存档，读取之前的存档。\n\n"
+		"详情已记录在游戏目录的 xsystem4-trace.txt。",
+		reason);
+	free(reason);
+	NOTICE("R10ALERT %s", text);
+	SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_WARNING, "xsystem4", text, NULL);
+}
+
+/* One array value: slot, its heap reference count and allocation sequence,
+ * element count, storage type tag, and up to 8 string elements the same way. */
+static int append_array(char *buf, int n, int size, int slot)
+{
+	if (n >= size - 1)
+		return n;
+	int r;
+	if (slot == -1 || !page_index_valid(slot)) {
+		r = snprintf(buf + n, size - n, " arr=%d", slot);
+		return r < 0 ? n : n + r < size ? n + r : size - 1;
+	}
+	struct page *p = heap_get_page(slot);
+	r = snprintf(buf + n, size - n, " arr=%d(r%d,s%u) n=%d type=%d rank=%d [", slot,
+			heap[slot].ref, heap[slot].seq, p ? p->nr_vars : -1,
+			p ? (int)p->a_type : -1, p ? p->array.rank : -1);
+	n = r < 0 ? n : n + r < size ? n + r : size - 1;
+	for (int i = 0; p && p->type == ARRAY_PAGE && p->a_type == AIN_ARRAY_STRING
+			&& i < p->nr_vars && i < 8 && n < size - 1; i++) {
+		int s = p->values[i].i;
+		bool ok = s >= 0 && (size_t)s < heap_size && heap[s].ref > 0 && heap[s].type == VM_STRING;
+		r = snprintf(buf + n, size - n, "%s%d(r%d,s%u)\"%.24s\"", i ? " " : "", s,
+				ok ? heap[s].ref : -1, ok ? heap[s].seq : 0,
+				ok ? heap[s].s->text : "<freed>");
+		n = r < 0 ? n : n + r < size ? n + r : size - 1;
+	}
+	r = snprintf(buf + n, size - n, "]");
+	return r < 0 ? n : n + r < size ? n + r : size - 1;
+}
+
+/* Integer and array members of the active method's `this`. */
+static void trace_dump_this(const char *when, int fno)
+{
+	int self = call_stack[call_stack_ptr - 1].struct_page;
+	char buf[480];
+	int n = snprintf(buf, sizeof(buf), "  %s this=%d", when, self);
+	struct page *p = page_index_valid(self) ? heap_get_page(self) : NULL;
+	if (p && p->type == STRUCT_PAGE && p->index >= 0 && p->index < ain->nr_structures) {
+		struct ain_struct *s = &ain->structures[p->index];
+		for (int i = 0; i < p->nr_vars && i < s->nr_members && n < (int)sizeof(buf) - 1; i++) {
+			int type = s->members[i].type.data;
+			int r = 0;
+			if (type == AIN_INT || type == AIN_BOOL || type == AIN_ENUM)
+				r = snprintf(buf + n, sizeof(buf) - n, " m%d=%d", i, p->values[i].i);
+			else if (type == AIN_ARRAY || type == AIN_ARRAY_STRING) {
+				r = snprintf(buf + n, sizeof(buf) - n, " m%d:", i);
+				n = r < 0 ? n : n + r < (int)sizeof(buf) ? n + r : (int)sizeof(buf) - 1;
+				n = append_array(buf, n, sizeof(buf), p->values[i].i);
+				continue;
+			}
+			n = r < 0 ? n : n + r < (int)sizeof(buf) ? n + r : (int)sizeof(buf) - 1;
+		}
+	}
+	(void)fno;
+	trace_log("%s", buf);
+}
+
+void trace_function_call(int fno)
+{
+	struct ain_function *f = &ain->functions[fno];
+	struct page *locals = heap_get_page(call_stack[call_stack_ptr - 1].page_slot);
+	char buf[480];
+	int n = snprintf(buf, sizeof(buf), "CALL %s", f->name);
+	if (n < 0 || n >= (int)sizeof(buf))
+		n = sizeof(buf) - 1;
+	for (int i = 0; locals && i < f->nr_args && i < 4; i++)
+		n = append_value(buf, n, sizeof(buf), f->vars[i].type.data, locals->values[i]);
+	trace_log("%s", buf);
+	if (traced[fno] == TRACE_ALERT)
+		trace_alert(f, locals);
+	/* CALLMETHOD sets `this` after the arguments: see trace_method_entered. */
+	if (traced[fno] == TRACE_DUMP_THIS && call_stack[call_stack_ptr - 1].struct_page != -1)
+		trace_dump_this("enter", fno);
+}
+
+void trace_method_entered(int fno)
+{
+	if (trace_function_enabled(fno) && traced[fno] == TRACE_DUMP_THIS)
+		trace_dump_this("enter", fno);
+}
+
+void trace_function_return(int fno)
+{
+	struct ain_function *f = &ain->functions[fno];
+	char buf[480];
+	int n = snprintf(buf, sizeof(buf), "RET  %s", f->name);
+	if (n < 0 || n >= (int)sizeof(buf))
+		n = sizeof(buf) - 1;
+	switch (f->return_type.data) {
+	case AIN_INT: case AIN_BOOL: case AIN_LONG_INT: case AIN_ENUM: case AIN_ENUM2:
+	case AIN_FLOAT: case AIN_STRING:
+		if (stack_ptr > 0)
+			n = append_value(buf, n, sizeof(buf), f->return_type.data, stack_peek(0));
+		break;
+	default:
+		break;
+	}
+	trace_log("%s", buf);
+	if (traced[fno] == TRACE_DUMP_THIS)
+		trace_dump_this("leave", fno);
+}
