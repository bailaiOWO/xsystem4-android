new file mode 100644
index 0000000..071b7c2
--- /dev/null
+++ b/src/hll/ArrayGeneric.c
@@ -0,0 +1,846 @@
+/* Generic Array ABI for AIN v11+. See android-build/rance10-offline-results.md.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#define VM_PRIVATE
+#include <limits.h>
+#include <string.h>
+#include <stdlib.h>
+#include "system4.h"
+#include "system4/ain.h"
+#include "system4/string.h"
+#include "vm.h"
+#include "vm/heap.h"
+#include "vm/page.h"
+
+bool generic_delegate_function_supported(struct ain_hll_function *f)
+{
+	if (!f->nr_arguments || f->arguments[0].type.data != AIN_REF_DELEGATE) return false;
+	if (f->nr_arguments == 1)
+		return !strcmp(f->name, "Clear") || !strcmp(f->name, "Numof") || !strcmp(f->name, "Empty");
+	if (f->nr_arguments != 2 || f->arguments[1].type.data != AIN_HLL_FUNC) return false;
+	return !strcmp(f->name, "Set") || !strcmp(f->name, "Add") || !strcmp(f->name, "Exist") || !strcmp(f->name, "Erase");
+}
+
+void generic_delegate_call(struct ain_hll_function *f)
+{
+	if (!generic_delegate_function_supported(f)) VM_ERROR("Unsupported Delegate.%s", f->name);
+	bool callback = f->nr_arguments == 2;
+	if (stack_ptr < (callback ? 3 : 1)) VM_ERROR("Delegate argument underflow");
+	int function = callback ? stack_pop().i : -1;
+	int object = callback ? stack_pop().i : -1;
+	int slot = stack_pop().i;
+	struct page *p = heap_get_delegate_page(slot);
+	if (callback && (function < 0 || function >= ain->nr_functions || (object != -1 && !page_index_valid(object))))
+		VM_ERROR("Invalid Delegate callback: %d/%d", object, function);
+	if (!strcmp(f->name, "Set")) {
+		heap_set_page(slot, NULL);
+		if (p) free_page(p);
+		heap_set_page(slot, delegate_new_from_method(object, function));
+	} else if (!strcmp(f->name, "Add")) heap_set_page(slot, delegate_append(p, object, function));
+	else if (!strcmp(f->name, "Clear")) heap_set_page(slot, delegate_clear(p));
+	else if (!strcmp(f->name, "Erase")) delegate_erase(p, object, function);
+	else if (!strcmp(f->name, "Exist")) stack_push(delegate_contains(p, object, function));
+	else stack_push(!strcmp(f->name, "Empty") ? !delegate_numof(p) : delegate_numof(p));
+}
+
+/* These calls are interpreted at the VM boundary. A generic value is a VM
+ * value, not a native pointer; a scalar reference is TWO VM stack slots.
+ * Keeping them out of libffi also avoids binding predicate overloads to
+ * implementations with incompatible C prototypes. */
+bool generic_array_function_supported(struct ain_hll_function *f)
+{
+	if (!f->nr_arguments || f->arguments[0].type.data != AIN_REF_ARRAY)
+		return false;
+	const char *n = f->name;
+	int argc = f->nr_arguments;
+	if (argc == 2 && f->arguments[1].type.data == AIN_HLL_FUNC)
+		return !strcmp(n, "BinarySearch") || !strcmp(n, "LowerBound") || !strcmp(n, "UpperBound")
+			|| !strcmp(n, "Find") || !strcmp(n, "FindLast") || !strcmp(n, "IsExist") || !strcmp(n, "Where")
+			|| !strcmp(n, "Any") || !strcmp(n, "All") || !strcmp(n, "Numof")
+			|| !strcmp(n, "Sort") || !strcmp(n, "QuickSort")
+			|| !strcmp(n, "Erase") || !strcmp(n, "EraseAll") || !strcmp(n, "Remain")
+			|| !strcmp(n, "First") || !strcmp(n, "Last") || !strcmp(n, "Min") || !strcmp(n, "Max");
+	if ((!strcmp(n, "Find") || !strcmp(n, "FindLast")) && argc == 4 && f->arguments[1].type.data == AIN_INT && f->arguments[2].type.data == AIN_INT
+		&& (f->arguments[3].type.data == AIN_HLL_FUNC || f->arguments[3].type.data == AIN_HLL_PARAM))
+		return !strcmp(n, "Find") || !strcmp(n, "FindLast");
+	for (int i = 1; i < argc; i++) {
+		int t = f->arguments[i].type.data;
+		if (t != AIN_INT && t != AIN_REF_ARRAY && t != AIN_HLL_PARAM)
+			return false;
+	}
+	if (!strcmp(n, "Alloc"))
+		return argc == 5 && f->arguments[1].type.data == AIN_INT
+			&& f->arguments[2].type.data == AIN_INT
+			&& f->arguments[3].type.data == AIN_INT
+			&& f->arguments[4].type.data == AIN_INT;
+	if (!strcmp(n, "At"))
+		return argc == 2 && f->arguments[1].type.data == AIN_INT;
+	if (!strcmp(n, "Copy"))
+		return (argc == 2 && f->arguments[1].type.data == AIN_REF_ARRAY)
+			|| (argc == 3 && f->arguments[1].type.data == AIN_INT && f->arguments[2].type.data == AIN_REF_ARRAY)
+			|| (argc == 4 && f->arguments[1].type.data == AIN_REF_ARRAY && f->arguments[2].type.data == AIN_INT && f->arguments[3].type.data == AIN_INT)
+			|| (argc == 5 && f->arguments[1].type.data == AIN_INT && f->arguments[2].type.data == AIN_REF_ARRAY && f->arguments[3].type.data == AIN_INT && f->arguments[4].type.data == AIN_INT);
+	if (!strcmp(n, "Duplicate") || !strcmp(n, "Concat"))
+		return argc == 2 && f->arguments[1].type.data == AIN_REF_ARRAY;
+	if (!strcmp(n, "First") || !strcmp(n, "Last") || !strcmp(n, "Numof")
+		|| !strcmp(n, "Empty") || !strcmp(n, "Any") || !strcmp(n, "Free")
+		|| !strcmp(n, "Reverse") || !strcmp(n, "PopBack") || !strcmp(n, "EmplaceBack")
+		|| !strcmp(n, "Unique") || !strcmp(n, "Sort") || !strcmp(n, "QuickSort") || !strcmp(n, "ShallowCopy")
+		|| !strcmp(n, "AscSort") || !strcmp(n, "DescSort") || !strcmp(n, "Min") || !strcmp(n, "Max"))
+		return argc == 1;
+	if (!strcmp(n, "Erase"))
+		return argc == 2 && (f->arguments[1].type.data == AIN_INT || f->arguments[1].type.data == AIN_REF_ARRAY);
+	if (!strcmp(n, "Realloc") || !strcmp(n, "Shuffle"))
+		return argc == 2 && f->arguments[1].type.data == AIN_INT;
+	if (!strcmp(n, "PushBack") || !strcmp(n, "Fill"))
+		return (argc == 2 && f->arguments[1].type.data == AIN_HLL_PARAM)
+			|| (!strcmp(n, "Fill") && argc == 4 && f->arguments[1].type.data == AIN_INT
+				&& f->arguments[2].type.data == AIN_INT && f->arguments[3].type.data == AIN_HLL_PARAM);
+	if (!strcmp(n, "Insert"))
+		return argc == 3 && f->arguments[1].type.data == AIN_INT
+			&& f->arguments[2].type.data == AIN_HLL_PARAM;
+	if (!strcmp(n, "Find") || !strcmp(n, "FindLast") || !strcmp(n, "IsExist")
+		|| !strcmp(n, "LowerBound") || !strcmp(n, "UpperBound") || !strcmp(n, "BinarySearch"))
+		return argc == 2 && f->arguments[1].type.data == AIN_HLL_PARAM;
+	return false;
+}
+
+static enum ain_data_type generic_array_storage_type(int type)
+{
+	switch (type) {
+	case AIN_INT: case AIN_ENUM: return AIN_ARRAY_INT;
+	case AIN_FLOAT: return AIN_ARRAY_FLOAT;
+	case AIN_BOOL: return AIN_ARRAY_BOOL;
+	case AIN_STRING: return AIN_ARRAY_STRING;
+	case AIN_STRUCT: return AIN_ARRAY_STRUCT;
+	case AIN_REF_STRUCT: return AIN_REF_STRUCT;
+	case AIN_ARRAY: return AIN_ARRAY;
+	/* Structs, interfaces and nested arrays need their complete AIN type
+	 * metadata. Do not invent integer storage for these. */
+	default: VM_ERROR("Array element type %d is not implemented", type);
+	}
+}
+
+static const struct ain_type *generic_array_owner_element_type(int slot, int owner_slot)
+{
+	if (!page_index_valid(owner_slot) || !heap[owner_slot].page) return NULL;
+	struct page *owner = heap[owner_slot].page;
+	struct ain_variable *vars = NULL;
+	int count = 0;
+	if (owner->type == GLOBAL_PAGE) { vars = ain->globals; count = ain->nr_globals; }
+	else if ((owner->type == LOCAL_PAGE || owner->type == CLOSURE_PAGE)
+			&& owner->index >= 0 && owner->index < ain->nr_functions) {
+		vars = ain->functions[owner->index].vars; count = ain->functions[owner->index].nr_vars;
+	} else if (owner->type == STRUCT_PAGE && owner->index >= 0 && owner->index < ain->nr_structures) {
+		vars = ain->structures[owner->index].members; count = ain->structures[owner->index].nr_members;
+	}
+	for (int v = 0; vars && v < count && v < owner->nr_vars; v++) {
+		struct ain_type *t = &vars[v].type;
+		if ((t->data == AIN_ARRAY || t->data == AIN_REF_ARRAY)
+				&& owner->values[v].i == slot && t->array_type)
+			return t->array_type;
+	}
+	return NULL;
+}
+
+static const struct ain_type *generic_array_element_type(int slot)
+{
+	/* Empty arrays used by a method normally belong to its locals or `this`.
+	 * Check active owners before walking unrelated live objects. Use current
+	 * declarations, not a cache tied to heap slots which can be recycled. */
+	for (int i = call_stack_ptr - 1; i >= 0; i--) {
+		const struct ain_type *type = generic_array_owner_element_type(slot, call_stack[i].page_slot);
+		if (type) return type;
+		type = generic_array_owner_element_type(slot, call_stack[i].struct_page);
+		if (type) return type;
+	}
+	const struct ain_type *type = generic_array_owner_element_type(slot, 0);
+	if (type) return type;
+	/* Aliases whose owner is outside the active frames retain the full lookup. */
+	for (size_t i = 0; i < heap_size; i++) {
+		type = generic_array_owner_element_type(slot, i);
+		if (type) return type;
+	}
+	return NULL;
+}
+
+static int generic_array_struct_type(int slot)
+{
+	/* Allocated arrays already preserve their declared element type. Most
+	 * battle UI operations use these; only null arrays need an owner lookup. */
+	struct page *p = heap_get_page(slot);
+	if (p && p->type == ARRAY_PAGE && p->array.struct_type >= 0)
+		return p->array.struct_type;
+	const struct ain_type *type = generic_array_element_type(slot);
+	if (type && type->struc >= 0) return type->struc;
+	return p ? p->array.struct_type : -1;
+}
+
+static struct page *generic_array_page(int slot)
+{
+	if (slot <= 0 || !page_index_valid(slot))
+		VM_ERROR("Invalid generic Array slot: %d", slot);
+	struct page *p = heap_get_page(slot);
+	if (p && (p->type != ARRAY_PAGE || p->array.rank < 1))
+		VM_ERROR("Generic Array requires an array page");
+	return p;
+}
+
+static void generic_array_clear(int slot)
+{
+	/* Clear the heap entry first: element destructors may call back into VM. */
+	struct page *p = generic_array_page(slot);
+	heap_set_page(slot, NULL);
+	if (p) {
+		delete_page_vars(p);
+		free_page(p);
+	}
+}
+
+static bool generic_array_erase_values(int slot, int source_slot, int type)
+{
+	switch (type) {
+	case AIN_INT: case AIN_ENUM: case AIN_BOOL: case AIN_FLOAT:
+	case AIN_STRING: case AIN_REF_STRUCT: case AIN_IFACE:
+		break;
+	default:
+		VM_ERROR("Unsupported element type %d in Array.Erase(array)", type);
+	}
+	struct page *page = generic_array_page(slot);
+	struct page *source = generic_array_page(source_slot);
+	int stride = type == AIN_IFACE ? 2 : 1;
+	struct page *arrays[] = { page, source };
+	for (int i = 0; i < 2; i++) {
+		struct page *p = arrays[i];
+		if (!p) continue;
+		int stored = p->a_type == AIN_IFACE ? AIN_IFACE : array_type(p->a_type);
+		int expected = type == AIN_ENUM ? AIN_INT : type;
+		if (p->array.rank != 1 || p->nr_vars % stride
+				|| (stored != expected && !(type == AIN_REF_STRUCT && stored == AIN_STRUCT)))
+			VM_ERROR("Array.Erase source/destination element type mismatch");
+	}
+	int len = page ? page->nr_vars / stride : 0;
+	int source_len = source ? source->nr_vars / stride : 0;
+	if (!len || !source_len) return false;
+
+	/* Read both borrowed arrays before changing either one. This also makes
+	 * Erase(self, self) safe, and compares string contents rather than slots. */
+	bool *remove = xcalloc(len, sizeof(*remove));
+	int count = 0;
+	for (int i = 0; i < len; i++) {
+		for (int j = 0; j < source_len; j++) {
+			union vm_value *a = page->values + i * stride;
+			union vm_value *b = source->values + j * stride;
+			bool equal;
+			if (type == AIN_STRING) equal = !strcmp(heap_get_string(a->i)->text, heap_get_string(b->i)->text);
+			else if (type == AIN_FLOAT) equal = a->f == b->f;
+			else equal = a->i == b->i && (stride == 1 || a[1].i == b[1].i);
+			if (equal) { remove[i] = true; count++; break; }
+		}
+	}
+	if (!count) { free(remove); return false; }
+
+	/* Publish the surviving elements before finalizing removed objects:
+	 * their destructors may call back into the VM and inspect the array. */
+	union vm_value *removed = xmalloc((size_t)count * stride * sizeof(*removed));
+	int kept = 0, deleted = 0;
+	for (int i = 0; i < len; i++) {
+		union vm_value *dst = remove[i] ? removed + deleted++ * stride : page->values + kept++ * stride;
+		memmove(dst, page->values + i * stride, stride * sizeof(*dst));
+	}
+	page->nr_vars = kept * stride;
+	enum ain_data_type stored = stride == 2 ? AIN_IFACE : array_type(page->a_type);
+	for (int i = 0; i < count; i++) variable_fini(removed[i * stride], stored, true);
+	free(removed);
+	free(remove);
+	return true;
+}
+
+static int generic_array_predicate(int slot, int index, int function, int object)
+{
+	if (function < 0 || function >= ain->nr_functions) VM_ERROR("Invalid Array predicate");
+	struct ain_function *f = &ain->functions[function];
+	int t = f->nr_args ? f->vars[0].type.data : AIN_VOID;
+	struct page *p = generic_array_page(slot);
+	if (t == AIN_REF_INT || t == AIN_REF_FLOAT || t == AIN_REF_BOOL || t == AIN_REF_ENUM || t == AIN_REF_LONG_INT) {
+		if (f->nr_args != 2) VM_ERROR("Invalid scalar Array predicate signature");
+		stack_push(slot); stack_push(index);
+	} else if (t == AIN_IFACE) {
+		if (f->nr_args != 2 || p->a_type != AIN_IFACE) VM_ERROR("Invalid interface Array predicate signature");
+		stack_push(p->values[index*2]); stack_push(p->values[index*2+1]);
+	} else {
+		if (f->nr_args != 1) VM_ERROR("Invalid Array predicate signature");
+		union vm_value v = p->values[index];
+		if (t == AIN_STRING || t == AIN_STRUCT || t == AIN_ARRAY) v = vm_copy(v, t);
+		stack_push(v);
+	}
+	int base = stack_ptr - f->nr_args;
+	vm_call(function, object);
+	if (stack_ptr != base + 1) VM_ERROR("Array predicate returned invalid stack layout");
+	return stack_pop().i;
+}
+
+static bool generic_array_less(int slot, int lhs, int rhs, int function, int object)
+{
+	if (function < 0 || function >= ain->nr_functions) VM_ERROR("Invalid Array comparator");
+	struct ain_function *f = &ain->functions[function];
+	int base = stack_ptr, arg = 0;
+	int indices[2] = {lhs, rhs};
+	for (int i = 0; i < 2; i++) {
+		if (arg >= f->nr_args) VM_ERROR("Invalid Array comparator signature");
+		int t = f->vars[arg].type.data;
+		if (t == AIN_REF_INT || t == AIN_REF_FLOAT || t == AIN_REF_BOOL || t == AIN_REF_ENUM || t == AIN_REF_LONG_INT) {
+			stack_push(slot); stack_push(indices[i]); arg += 2;
+		} else if (t == AIN_IFACE) {
+			struct page *p = generic_array_page(slot);
+			if (p->a_type != AIN_IFACE || arg + 1 >= f->nr_args) VM_ERROR("Invalid interface comparator");
+			stack_push(p->values[indices[i]*2]); stack_push(p->values[indices[i]*2+1]); arg += 2;
+		} else {
+			union vm_value v = generic_array_page(slot)->values[indices[i]];
+			if (t == AIN_STRING || t == AIN_STRUCT || t == AIN_ARRAY) v = vm_copy(v, t);
+			stack_push(v); arg++;
+		}
+	}
+	if (arg != f->nr_args) VM_ERROR("Invalid Array comparator arity");
+	vm_call(function, object);
+	if (stack_ptr != base + 1) VM_ERROR("Array comparator returned invalid stack layout");
+	int result = stack_pop().i;
+	return f->return_type.data == AIN_BOOL ? result != 0 : result < 0;
+}
+
+static void generic_array_reference(int slot, int index, int type);
+
+static void generic_array_callback_call(struct ain_hll_function *f)
+{
+	if (stack_ptr < f->nr_arguments + 1) VM_ERROR("Array callback argument underflow");
+	int function = stack_pop().i, object = stack_pop().i;
+	int begin = 0, end = -1;
+	if (f->nr_arguments == 4) { end = stack_pop().i; begin = stack_pop().i; }
+	int slot = stack_pop().i;
+	struct page *p = generic_array_page(slot);
+	if (p && p->array.rank > 1)
+		VM_ERROR("Array.%s callback requires leaf elements", f->name);
+	int len = p ? p->nr_vars : 0;
+	int element_type = hll_call_type_param;
+	int stride = element_type == AIN_IFACE ? 2 : 1;
+	if (stride == 2 && p && (p->a_type != AIN_IFACE || len % 2)) VM_ERROR("Invalid interface array");
+	len /= stride;
+	if (f->nr_arguments != 4) end = len;
+	if (begin < 0 || end < begin || end > len) VM_ERROR("Array.Find range out of bounds");
+	const char *n = f->name;
+	if (!strcmp(n, "Min") || !strcmp(n, "Max")) {
+		int best = len ? 0 : -1;
+		for (int i = 1; i < len; i++) {
+			if (generic_array_less(slot, !strcmp(n,"Min") ? i : best, !strcmp(n,"Min") ? best : i, function, object)) best = i;
+			p = generic_array_page(slot);
+			if (!p || p->nr_vars != len * stride) VM_ERROR("Array comparator changed array size");
+		}
+		generic_array_reference(slot, best, element_type); return;
+	}
+	if (!strcmp(n, "Erase") || !strcmp(n, "EraseAll") || !strcmp(n, "Remain")) {
+		bool removed = false;
+		for (int i = 0; i < len;) {
+			bool match = generic_array_predicate(slot, i, function, object) != 0;
+			p = generic_array_page(slot);
+			if (!p || p->nr_vars != len * stride) VM_ERROR("Array erase predicate changed array size");
+			if (!strcmp(n, "Remain")) match = !match;
+			if (!match) { i++; continue; }
+			bool success;
+			if (stride == 2) {
+				if (p->values[i*2].i != -1) heap_unref(p->values[i*2].i);
+				memmove(p->values+i*2,p->values+(i+1)*2,(len-i-1)*2*sizeof(union vm_value));
+				p->nr_vars -= 2;
+			} else p = array_erase(p, i, &success);
+			heap_set_page(slot, p);
+			len--; removed = true;
+			if (!strcmp(n, "Erase")) break;
+		}
+		if (!strcmp(n, "Remain")) { heap_ref(slot); stack_push(slot); }
+		else stack_push(removed);
+		return;
+	}
+	if (!strcmp(n, "Sort") || !strcmp(n, "QuickSort")) {
+		/* Stable merge sort keeps all heap references in the owning array
+		 * while callbacks execute, and avoids quadratic card-list sorting. */
+		union vm_value *buffer = len ? xmalloc((size_t)len * stride * sizeof(*buffer)) : NULL;
+		for (size_t width = 1; width < (size_t)len; width *= 2) {
+			for (size_t start = 0; start < (size_t)len; start += width * 2) {
+				size_t mid = start + width < (size_t)len ? start + width : len;
+				size_t end = start + width * 2 < (size_t)len ? start + width * 2 : len;
+				size_t left = start, right = mid;
+				for (size_t out = start; out < end; out++) {
+					bool take_left = right == end || (left < mid && !generic_array_less(slot, right, left, function, object));
+					p = generic_array_page(slot);
+					if (!p || p->nr_vars != len * stride) VM_ERROR("Array comparator changed array size");
+					size_t chosen = take_left ? left++ : right++;
+					memcpy(buffer+out*stride,p->values+chosen*stride,stride*sizeof(*buffer));
+				}
+			}
+			memcpy(p->values, buffer, (size_t)len * stride * sizeof(*buffer));
+		}
+		free(buffer);
+		heap_ref(slot); stack_push(slot);
+		return;
+	}
+	if (!strcmp(n, "Any") || !strcmp(n, "All") || !strcmp(n, "Numof")) {
+		int count = 0;
+		for (int i = 0; i < len; i++) {
+			bool match = generic_array_predicate(slot, i, function, object) != 0;
+			count += match;
+			if ((!strcmp(n, "Any") && match) || (!strcmp(n, "All") && !match)) {
+				stack_push(!strcmp(n, "Any"));
+				return;
+			}
+		}
+		stack_push(!strcmp(n, "Numof") ? count : !strcmp(n, "All"));
+		return;
+	}
+	if (!strcmp(n, "Where")) {
+		int type = hll_call_type_param;
+		if (type == AIN_IFACE_WRAP)
+			VM_ERROR("Interface Array.Where is not implemented");
+		enum ain_data_type storage = stride == 2 ? AIN_IFACE : generic_array_storage_type(type);
+		int struc = p ? p->array.struct_type : generic_array_struct_type(slot);
+		struct page *selected = NULL;
+		for (int i = 0; i < len; i++) {
+			if (!generic_array_predicate(slot, i, function, object)) continue;
+			p = generic_array_page(slot);
+			if (!p || p->nr_vars != len * stride) VM_ERROR("Array.Where predicate changed array size");
+			if (stride == 2) {
+				int size = selected ? selected->nr_vars : 0;
+				if (!selected) { selected = alloc_page(ARRAY_PAGE,AIN_IFACE,2); selected->array.rank=1; selected->array.struct_type=struc; }
+				else { selected = xrealloc(selected,sizeof(*selected)+(size+2)*sizeof(union vm_value)); selected->nr_vars += 2; }
+				selected->values[size]=p->values[i*2];selected->values[size+1]=p->values[i*2+1];
+				if (selected->values[size].i != -1) heap_ref(selected->values[size].i);
+				continue;
+			}
+			union vm_value v = p->values[i];
+			if (type == AIN_REF_STRUCT) { if (v.i != -1) heap_ref(v.i); }
+			else v = vm_copy(v, type);
+			selected = array_pushback(selected, v, storage, struc);
+		}
+		stack_push(heap_alloc_page(selected));
+		return;
+	}
+	int result = -1;
+	if (!strcmp(n, "BinarySearch") || !strcmp(n, "LowerBound") || !strcmp(n, "UpperBound")) {
+		int lo = 0, hi = len;
+		while (lo < hi) {
+			int mid = lo + (hi - lo) / 2;
+			int cmp = generic_array_predicate(slot, mid, function, object);
+			if (cmp < 0 || (cmp == 0 && !strcmp(n, "UpperBound"))) lo = mid + 1;
+			else hi = mid;
+		}
+		result = lo;
+		if (!strcmp(n, "BinarySearch") && (lo == len || generic_array_predicate(slot, lo, function, object))) result = -1;
+	} else {
+		bool backwards = !strcmp(n, "FindLast") || !strcmp(n, "Last");
+		for (int i = backwards ? end - 1 : begin; i >= begin && i < end; i += backwards ? -1 : 1)
+			if (generic_array_predicate(slot, i, function, object)) { result = i; break; }
+	}
+	if (!strcmp(n, "First") || !strcmp(n, "Last")) generic_array_reference(slot, result, element_type);
+	else stack_push(!strcmp(n, "IsExist") ? result >= 0 : result);
+}
+
+static void generic_iface_resize(int slot, int count)
+{
+	if (count < 0 || count > INT_MAX / 2) VM_ERROR("Interface array size overflow");
+	struct page *old = generic_array_page(slot);
+	if (old && old->a_type != AIN_IFACE) VM_ERROR("Invalid interface array storage");
+	struct page *p = alloc_page(ARRAY_PAGE, AIN_IFACE, count * 2);
+	p->array.rank = 1;
+	p->array.struct_type = old ? old->array.struct_type : -1;
+	for (int i = 0; i < count * 2; i += 2) p->values[i].i = -1;
+	int moved = old ? (old->nr_vars < p->nr_vars ? old->nr_vars : p->nr_vars) : 0;
+	for (int i = 0; i < moved; i++) {
+		p->values[i] = old->values[i];
+		old->values[i].i = (i & 1) ? 0 : -1;
+	}
+	heap_set_page(slot, p);
+	if (old) { delete_page_vars(old); free_page(old); }
+}
+
+static void generic_iface_call(struct ain_hll_function *f)
+{
+	union vm_value args[5][2] = {{{0}}};
+	int slots = f->nr_arguments;
+	for (int i = 0; i < f->nr_arguments; i++)
+		if (f->arguments[i].type.data == AIN_HLL_PARAM) slots++;
+	if (stack_ptr < slots) VM_ERROR("Interface array argument underflow");
+	for (int i = f->nr_arguments - 1; i >= 0; i--) {
+		if (f->arguments[i].type.data == AIN_HLL_PARAM) args[i][1] = stack_pop();
+		args[i][0] = stack_pop();
+	}
+	int slot = args[0][0].i;
+	struct page *p = generic_array_page(slot);
+	if (p && (p->a_type != AIN_IFACE || (p->nr_vars & 1))) VM_ERROR("Invalid interface array");
+	int len = p ? p->nr_vars / 2 : 0;
+	const char *n = f->name;
+	if (!strcmp(n, "Numof") || !strcmp(n, "Empty") || !strcmp(n, "Any")) {
+		stack_push(!strcmp(n, "Numof") ? len : !strcmp(n, "Empty") ? !len : !!len);
+	} else if (!strcmp(n, "Free")) generic_array_clear(slot);
+	else if (!strcmp(n, "Alloc") || !strcmp(n, "Realloc")) {
+		if (!strcmp(n, "Alloc")) {
+			for (int i = 2; i < 5; i++) if (args[i][0].i != -1) VM_ERROR("Interface array requires one dimension");
+			generic_array_clear(slot);
+		}
+		generic_iface_resize(slot, args[1][0].i);
+	} else if (!strcmp(n, "At") || !strcmp(n, "First") || !strcmp(n, "Last") || !strcmp(n, "EmplaceBack")) {
+		int index = !strcmp(n, "At") ? args[1][0].i : !strcmp(n, "First") ? 0 : len - 1;
+		if (!strcmp(n, "EmplaceBack")) { generic_iface_resize(slot, len + 1); p = heap_get_page(slot); index = len; len++; }
+		bool valid = index >= 0 && index < len;
+		int object = valid ? p->values[index * 2].i : -1;
+		if (object != -1) heap_ref(object);
+		stack_push(object);
+		stack_push(valid ? p->values[index * 2 + 1].i : 0);
+	} else if (!strcmp(n, "PushBack") || !strcmp(n, "Insert")) {
+		int vi = !strcmp(n, "Insert") ? 2 : 1;
+		int index = vi == 2 ? args[1][0].i : len;
+		if (index < 0 || index > len) VM_ERROR("Interface array insert out of bounds");
+		if (args[vi][0].i != -1) heap_ref(args[vi][0].i);
+		generic_iface_resize(slot, len + 1); p = heap_get_page(slot);
+		memmove(p->values + (index + 1) * 2, p->values + index * 2, (len - index) * 2 * sizeof(union vm_value));
+		p->values[index * 2] = args[vi][0]; p->values[index * 2 + 1] = args[vi][1];
+	} else if (!strcmp(n, "PopBack") || !strcmp(n, "Erase")) {
+		int index = !strcmp(n, "Erase") ? args[1][0].i : len - 1;
+		bool valid = index >= 0 && index < len;
+		if (valid) {
+			union vm_value removed = p->values[index * 2];
+			memmove(p->values + index * 2, p->values + (index + 1) * 2, (len - index - 1) * 2 * sizeof(union vm_value));
+			p->values[(len - 1) * 2].i = -1;
+			generic_iface_resize(slot, len - 1);
+			variable_fini(removed, AIN_IFACE, true);
+		}
+		if (!strcmp(n, "Erase")) stack_push(valid);
+	} else if (!strcmp(n, "Reverse")) {
+		for (int i = 0; i < len / 2; i++) for (int v = 0; v < 2; v++) {
+			union vm_value tmp = p->values[i * 2 + v];
+			p->values[i * 2 + v] = p->values[(len - i - 1) * 2 + v];
+			p->values[(len - i - 1) * 2 + v] = tmp;
+		}
+	} else if (!strcmp(n, "Concat") || !strcmp(n, "Duplicate")) {
+		struct page *src = generic_array_page(args[1][0].i);
+		if (src && (src->a_type != AIN_IFACE || src->array.rank != 1 || (src->nr_vars & 1)))
+			VM_ERROR("Invalid interface array source");
+		int count = src ? src->nr_vars / 2 : 0;
+		bool replace = !strcmp(n, "Duplicate");
+		int start = replace ? 0 : len;
+		if (count > INT_MAX / 2 - start) VM_ERROR("Interface array size overflow");
+		/* An interface occupies an object reference and a vtable offset. Keep
+		 * both slots and retain the objects before a self-copy or a resize can
+		 * invalidate the source. A temporary Array.Where result owns its refs. */
+		union vm_value *values = count ? xmalloc((size_t)count * 2 * sizeof(*values)) : NULL;
+		if (count) memcpy(values, src->values, (size_t)count * 2 * sizeof(*values));
+		for (int i = 0; i < count; i++)
+			if (values[i * 2].i != -1) heap_ref(values[i * 2].i);
+		if (replace) generic_array_clear(slot);
+		if (replace || count) {
+			generic_iface_resize(slot, start + count);
+			p = generic_array_page(slot);
+			if (count) memcpy(p->values + start * 2, values, (size_t)count * 2 * sizeof(*values));
+		}
+		free(values);
+	} else VM_ERROR("Unsupported interface Array.%s", n);
+}
+
+static void generic_array_reference(int slot, int index, int type)
+{
+	struct page *p = generic_array_page(slot);
+	if (p && p->array.rank > 1) type = AIN_ARRAY;
+	bool valid = p && index >= 0 && index < p->nr_vars;
+	switch (type) {
+	case AIN_IFACE:
+		valid = p && index >= 0 && index < p->nr_vars / 2;
+		if (valid && p->values[index*2].i != -1) heap_ref(p->values[index*2].i);
+		stack_push(valid ? p->values[index*2].i : -1);
+		stack_push(valid ? p->values[index*2+1].i : 0);
+		break;
+	case AIN_INT: case AIN_FLOAT: case AIN_BOOL: case AIN_ENUM:
+		/* The reference keeps its owner alive until DELETE/finalization. */
+		if (valid) heap_ref(slot);
+		stack_push(valid ? slot : -1);
+		stack_push(valid ? index : -1);
+		break;
+	case AIN_STRING: case AIN_STRUCT: case AIN_REF_STRUCT:
+	case AIN_ARRAY:
+		/* ASSIGN followed by SP_INC consumes a single existing heap slot. */
+		if (!valid) {
+			stack_push(-1);
+			break;
+		}
+		if (p->values[index].i != -1)
+			heap_ref(p->values[index].i);
+		stack_push(p->values[index]);
+		break;
+	default:
+		VM_ERROR("Array reference element type %d is not implemented", type);
+	}
+}
+
+void generic_array_call_linked(struct ain_hll_function *f)
+{
+	if (!strcmp(f->name, "Erase") && f->nr_arguments == 2 && f->arguments[1].type.data == AIN_REF_ARRAY) {
+		if (stack_ptr < 2) VM_ERROR("Array.Erase argument underflow");
+		int source = stack_pop().i, target = stack_pop().i;
+		stack_push(generic_array_erase_values(target, source, hll_call_type_param));
+		return;
+	}
+	if ((f->nr_arguments == 2 && f->arguments[1].type.data == AIN_HLL_FUNC)
+		|| (f->nr_arguments == 4 && f->arguments[3].type.data == AIN_HLL_FUNC)) {
+		generic_array_callback_call(f); return;
+	}
+	if (hll_call_type_param == AIN_IFACE) { generic_iface_call(f); return; }
+	int argc = f->nr_arguments;
+	if (stack_ptr < argc)
+		VM_ERROR("Stack underflow in Array.%s", f->name);
+	/* Supported element types occupy one slot. Multi-slot interfaces are
+	 * rejected before changing the stack. */
+	int type = hll_call_type_param;
+	union vm_value args[5];
+	for (int i = argc - 1; i >= 0; i--)
+		args[i] = stack_pop();
+	int slot = args[0].i;
+	struct page *p = generic_array_page(slot);
+	int len = p ? p->nr_vars : 0;
+	const char *n = f->name;
+	static int traced;
+	if (traced++ < 16)
+		NOTICE("GENARRAY %s type=%d argc=%d slot=%d len=%d args=%d,%d,%d,%d fn=%d ip=%zu",
+			n, type, argc, slot, len, argc > 1 ? args[1].i : -1,
+			argc > 2 ? args[2].i : -1, argc > 3 ? args[3].i : -1,
+			argc > 4 ? args[4].i : -1,
+			call_stack_ptr ? call_stack[call_stack_ptr-1].fno : -1, instr_ptr);
+	if (!strcmp(n, "ShallowCopy")) {
+		struct page *copy = NULL;
+		if (p) {
+			copy = alloc_page(ARRAY_PAGE, p->a_type, len);
+			copy->array = p->array;
+			memcpy(copy->values, p->values, len * sizeof(union vm_value));
+			for (int i = 0; i < len; i++) {
+				int t = variable_type(p, i, NULL, NULL);
+				if ((t == AIN_STRING || t == AIN_STRUCT || t == AIN_REF_STRUCT || t == AIN_ARRAY || t == AIN_IFACE)
+					&& copy->values[i].i != -1) heap_ref(copy->values[i].i);
+			}
+		}
+		stack_push(heap_alloc_page(copy));
+		return;
+	}
+	if (!strcmp(n, "At") || !strcmp(n, "First") || !strcmp(n, "Last")) {
+		int index = !strcmp(n, "At") ? args[1].i : !strcmp(n, "First") ? 0 : len - 1;
+		generic_array_reference(slot, index, type);
+		return;
+	}
+	if (!strcmp(n, "Numof") || !strcmp(n, "Empty") || !strcmp(n, "Any")) {
+		stack_push(!strcmp(n, "Numof") ? len : !strcmp(n, "Empty") ? !len : !!len);
+		return;
+	}
+	if (!strcmp(n, "Free")) {
+		generic_array_clear(slot);
+		return;
+	}
+	if (!strcmp(n, "Reverse")) {
+		if (p) array_reverse(p);
+		return;
+	}
+	if (type == AIN_IFACE || type == AIN_IFACE_WRAP)
+		VM_ERROR("Array interface elements are not implemented: %s", n);
+	if (!strcmp(n, "Alloc")) {
+		int rank = 0;
+		bool omitted = false;
+		size_t prefix = 1, total = 0;
+		for (int i = 1; i < 5; i++) {
+			int dimension = args[i].i;
+			if (dimension == -1 && i > 1) { omitted = true; continue; }
+			if (dimension < 0 || omitted) VM_ERROR("Invalid Array.Alloc dimensions");
+			if (dimension && prefix > INT_MAX / (size_t)dimension) VM_ERROR("Array dimension product overflow");
+			prefix *= dimension;
+			if (total > INT_MAX - prefix) VM_ERROR("Array total allocation overflow");
+			total += prefix; rank++;
+		}
+		const struct ain_type *element = NULL;
+		if (type == AIN_ARRAY && rank > 1) {
+			/* CALLHLL names the immediate element (array for a matrix),
+			 * while alloc_array needs the leaf after the allocated dimensions.
+			 * Tagging integer leaves as arrays makes DELETE free node numbers. */
+			element = generic_array_element_type(slot);
+			for (int i = 1; i < rank; i++) {
+				if (!element || (element->data != AIN_ARRAY && element->data != AIN_REF_ARRAY))
+					VM_ERROR("Cannot resolve Array.Alloc element type for rank %d", rank);
+				element = element->array_type;
+			}
+			if (!element)
+				VM_ERROR("Missing Array.Alloc leaf type");
+			type = element->data;
+		}
+		enum ain_data_type storage = generic_array_storage_type(type);
+		int struc = element ? element->struc : type == AIN_STRUCT ? generic_array_struct_type(slot) : -1;
+		if (type == AIN_STRUCT && (struc < 0 || struc >= ain->nr_structures))
+			VM_ERROR("Cannot resolve Array struct element metadata");
+		generic_array_clear(slot);
+		heap_set_page(slot, alloc_array(rank, &args[1], storage, struc, true));
+		return;
+	}
+	if (p && p->array.rank > 1)
+		VM_ERROR("Array.%s requires leaf elements; use Array.At to access a nested row", n);
+	/* Existing helpers already handle element ownership and shrinking. */
+	enum ain_data_type storage = generic_array_storage_type(type);
+	int struc = type == AIN_STRUCT ? generic_array_struct_type(slot) : -1;
+	if (type == AIN_STRUCT && (struc < 0 || struc >= ain->nr_structures))
+		VM_ERROR("Cannot resolve Array struct element metadata");
+	// AIN v12 also exposes an owned struct array through array<ref T>.
+	// Keep its storage tag: subsequent owned copies still need deep copying.
+	if (p && p->a_type != storage && !(type == AIN_REF_STRUCT && p->a_type == AIN_ARRAY_STRUCT))
+		VM_ERROR("Array storage type %d disagrees with CALLHLL type %d", p->a_type, type);
+	if (!strcmp(n, "Duplicate") || !strcmp(n, "Concat")) {
+		struct page *src = generic_array_page(args[1].i);
+		if (src && src->a_type != storage && !(type == AIN_REF_STRUCT && src->a_type == AIN_ARRAY_STRUCT))
+			VM_ERROR("Array source storage type mismatch");
+		int count = src ? src->nr_vars : 0;
+		/* Preserve source elements before clearing or reallocating a self-copy. */
+		union vm_value *values = count ? xmalloc((size_t)count * sizeof(*values)) : NULL;
+		for (int i = 0; i < count; i++) values[i] = vm_copy(src->values[i], type);
+		if (!strcmp(n,"Duplicate")) { generic_array_clear(slot); p = NULL; len = 0; }
+		if (count > INT_MAX - len) VM_ERROR("Array concatenation size overflow");
+		for (int i = 0; i < count; i++) { p = array_pushback(p,values[i],storage,struc); heap_set_page(slot,p); }
+		free(values);
+	} else if (!strcmp(n, "Shuffle")) {
+		/* -1 means a fresh shuffle, not a repeatable seed. Keep this stream
+		 * separate from the game's seeded battle RNG. */
+		static unsigned random_seed;
+		if (args[1].i == -1 && !random_seed) random_seed = vm_random_seed();
+		unsigned seed = args[1].i == -1
+			? (random_seed = random_seed * 1664525u + 1013904223u)
+			: (unsigned)args[1].i;
+		for (int i = len - 1; i > 0; i--) {
+			seed = seed * 1664525u + 1013904223u;
+			int j = seed % ((unsigned)i + 1);
+			union vm_value value = p->values[i]; p->values[i] = p->values[j]; p->values[j] = value;
+		}
+	} else if (!strcmp(n, "Copy")) {
+		int si = argc == 3 || argc == 5 ? 2 : 1;
+		struct page *src = generic_array_page(args[si].i);
+		int dst_index = si == 2 ? args[1].i : 0;
+		int src_index = argc >= 4 ? args[si + 1].i : 0;
+		int src_len = src ? src->nr_vars : 0;
+		if (dst_index < 0 || dst_index > len || src_index < 0 || src_index > src_len)
+			VM_ERROR("Array.Copy index out of bounds");
+		int count = min(len - dst_index, src_len - src_index);
+		if (argc >= 4) count = min(count, max(0, args[si + 2].i));
+		array_copy(p, dst_index, src, src_index, count);
+		stack_push(count);
+	} else if (!strcmp(n, "Unique") || !strcmp(n, "Sort") || !strcmp(n, "QuickSort")
+		|| !strcmp(n,"AscSort") || !strcmp(n,"DescSort") || !strcmp(n,"Min") || !strcmp(n,"Max")) {
+		if (type != AIN_INT && type != AIN_ENUM && type != AIN_BOOL && type != AIN_FLOAT && type != AIN_STRING)
+			VM_ERROR("Unsupported value comparison in Array.%s", n);
+		bool extreme = !strcmp(n,"Min") || !strcmp(n,"Max");
+		int best = len ? 0 : -1;
+		for (int i = 1; i < len; i++) {
+			if (extreme) {
+				int cmp;
+				if (type == AIN_STRING) cmp = strcmp(heap_get_string(p->values[best].i)->text,heap_get_string(p->values[i].i)->text);
+				else if (type == AIN_FLOAT) cmp = (p->values[best].f > p->values[i].f) - (p->values[best].f < p->values[i].f);
+				else cmp = (p->values[best].i > p->values[i].i) - (p->values[best].i < p->values[i].i);
+				if (!strcmp(n,"Min") ? cmp > 0 : cmp < 0) best = i;
+				continue;
+			}
+			for (int j = 0; j < i; j++) {
+				int cmp;
+				if (type == AIN_STRING) cmp = strcmp(heap_get_string(p->values[j].i)->text, heap_get_string(p->values[i].i)->text);
+				else if (type == AIN_FLOAT) cmp = (p->values[j].f > p->values[i].f) - (p->values[j].f < p->values[i].f);
+				else cmp = (p->values[j].i > p->values[i].i) - (p->values[j].i < p->values[i].i);
+				if (!strcmp(n, "Unique")) {
+					if (!cmp) { bool erased; p = array_erase(p, i, &erased); heap_set_page(slot, p); len--; i--; break; }
+				} else if (!strcmp(n,"DescSort") ? cmp < 0 : cmp > 0) {
+					union vm_value value = p->values[i];
+					memmove(p->values + j + 1, p->values + j, (i-j) * sizeof(union vm_value));
+					p->values[j] = value;
+					break;
+				}
+			}
+		}
+		if (extreme) generic_array_reference(slot,best,type);
+		else if (strcmp(n, "Unique")) { heap_ref(slot); stack_push(slot); }
+	} else if (!strcmp(n, "LowerBound") || !strcmp(n, "UpperBound") || !strcmp(n, "BinarySearch")) {
+		int lo = 0, hi = len;
+		while (lo < hi) {
+			int mid = lo + (hi - lo) / 2;
+			int cmp;
+			if (type == AIN_STRING)
+				cmp = strcmp(heap_get_string(p->values[mid].i)->text, heap_get_string(args[1].i)->text);
+			else if (type == AIN_FLOAT)
+				cmp = (p->values[mid].f > args[1].f) - (p->values[mid].f < args[1].f);
+			else cmp = (p->values[mid].i > args[1].i) - (p->values[mid].i < args[1].i);
+			if (cmp < 0 || (cmp == 0 && !strcmp(n, "UpperBound"))) lo = mid + 1;
+			else hi = mid;
+		}
+		if (!strcmp(n, "BinarySearch")) {
+			bool match = lo < len;
+			if (match && type == AIN_STRING) match = !strcmp(heap_get_string(p->values[lo].i)->text, heap_get_string(args[1].i)->text);
+			else if (match && type == AIN_FLOAT) match = p->values[lo].f == args[1].f;
+			else if (match) match = p->values[lo].i == args[1].i;
+			if (!match) lo = -1;
+		}
+		if (type != AIN_REF_STRUCT) variable_fini(args[1], type, true);
+		stack_push(lo);
+	} else if (!strcmp(n, "Find") || !strcmp(n, "FindLast") || !strcmp(n, "IsExist")) {
+		int found = -1;
+		int begin = argc == 4 ? args[1].i : 0, end = argc == 4 ? args[2].i : len;
+		int search = argc == 4 ? 3 : 1;
+		if (begin < 0 || end < begin || end > len) VM_ERROR("Array.Find range out of bounds");
+		bool backwards = !strcmp(n, "FindLast");
+		for (int i = backwards ? end - 1 : begin; i >= begin && i < end; i += backwards ? -1 : 1) {
+			bool equal;
+			if (type == AIN_STRING)
+				equal = !strcmp(heap_get_string(p->values[i].i)->text, heap_get_string(args[search].i)->text);
+			else if (type == AIN_FLOAT) equal = p->values[i].f == args[search].f;
+			else equal = p->values[i].i == args[search].i;
+			if (equal) { found = i; break; }
+		}
+		if (type != AIN_REF_STRUCT) variable_fini(args[search], type, true);
+		stack_push(!strcmp(n, "IsExist") ? found >= 0 : found);
+	} else if (!strcmp(n, "EmplaceBack")) {
+		if (len == INT_MAX) VM_ERROR("Array size overflow");
+		union vm_value dim = { .i = len + 1 };
+		heap_set_page(slot, realloc_array(p, 1, &dim, storage, struc, true));
+		generic_array_reference(slot, len, type);
+	} else if (!strcmp(n, "Realloc")) {
+		if (args[1].i < 0) VM_ERROR("Negative Array.Realloc size");
+		heap_set_page(slot, realloc_array(p, 1, &args[1], storage, struc, true));
+	} else if (!strcmp(n, "PopBack")) {
+		/* array_popback previously underflowed on an allocated empty page. */
+		if (len) heap_set_page(slot, array_popback(p));
+	} else if (!strcmp(n, "Erase")) {
+		bool success;
+		heap_set_page(slot, array_erase(p, args[1].i, &success));
+		stack_push(success);
+	} else if (!strcmp(n, "PushBack") || !strcmp(n, "Insert")) {
+		if (len == INT_MAX) VM_ERROR("Array size overflow");
+		int vi = !strcmp(n, "Insert") ? 2 : 1;
+		int index = vi == 2 ? args[1].i : len;
+		if (index < 0 || index > len) VM_ERROR("Array.Insert index out of bounds");
+		/* ref struct values are borrowed; ordinary values have already
+		 * been copied by the caller's A_REF instruction. */
+		if (type == AIN_REF_STRUCT && args[vi].i != -1) heap_ref(args[vi].i);
+		/* Legacy array_insert clamps the end to the last existing element. */
+		if (vi == 2 && index < len)
+			heap_set_page(slot, array_insert(p, index, args[vi], storage, struc));
+		else
+			heap_set_page(slot, array_pushback(p, args[vi], storage, struc));
+	} else if (!strcmp(n, "Fill")) {
+		/* array_fill does not consume v on its empty-array early return. */
+		int vi = argc == 4 ? 3 : 1;
+		if (len)
+			stack_push(array_fill(p, argc == 4 ? args[1].i : 0, argc == 4 ? args[2].i : len, args[vi]));
+		else {
+			variable_fini(args[vi], type, true);
+			stack_push(0);
+		}
+	}
+}
+
+void generic_array_call(struct ain_hll_function *f)
+{
+	if (!generic_array_function_supported(f))
+		VM_ERROR("Unsupported generic Array overload: %s", f->name);
+	generic_array_call_linked(f);
+}
