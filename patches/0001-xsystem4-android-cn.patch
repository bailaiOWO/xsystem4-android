diff --git a/shaders/reign_post.f.glsl b/shaders/reign_post.f.glsl
new file mode 100644
index 0000000..99a970b
--- /dev/null
+++ b/shaders/reign_post.f.glsl
@@ -0,0 +1,45 @@
+uniform sampler2D tex;
+uniform sampler2D glare_tex;
+uniform int operation;
+uniform vec4 brightness;
+uniform vec2 blur_step;
+uniform vec3 ycbcr_exponent;
+uniform bool use_glare;
+in vec2 tex_coord;
+out vec4 frag_color;
+
+void main()
+{
+	vec4 scene = texture(tex, tex_coord);
+	if (operation == 0) {
+		// Tapir ps_brightness: the script controls all four stages.
+		float v = dot(scene.rgb, vec3(1.0 / 3.0));
+		v = clamp(v + brightness.w, 0.0, 1.0) - brightness.w;
+		v = clamp(v + brightness.x, 0.0, 1.0);
+		v = clamp(v * brightness.y + brightness.z, 0.0, 1.0);
+		frag_color = vec4(vec3(v), 1.0);
+	} else if (operation == 1) {
+		// The original blur shaders average a symmetric set of samples.
+		vec3 sum = vec3(0.0);
+		for (int i = -4; i <= 4; i++)
+			sum += texture(tex, tex_coord + float(i) * blur_step).rgb;
+		frag_color = vec4(sum / 9.0, 1.0);
+	} else {
+		vec3 rgb = scene.rgb;
+		if (use_glare)
+			rgb += texture(glare_tex, tex_coord).rgb;
+		rgb = clamp(rgb, 0.0, 1.0);
+		// Tapir's original Y/Cb/Cr filter, with (1,1,1) as the identity.
+		if (any(notEqual(ycbcr_exponent, vec3(1.0)))) {
+			vec3 c = vec3(dot(rgb, vec3(0.299, 0.587, 0.114)),
+				dot(rgb, vec3(-0.16874, -0.33126, 0.5)),
+				dot(rgb, vec3(0.5, -0.41869, -0.08131)));
+			// Exponents are positive; keep zero bases so white stays white.
+			c = 1.0 - pow(max(1.0 - c, vec3(0.0)), ycbcr_exponent);
+			rgb = vec3(c.x + 1.402 * c.z,
+				c.x - 0.34414 * c.y - 0.71414 * c.z,
+				c.x + 1.772 * c.y);
+		}
+		frag_color = vec4(rgb, scene.a);
+	}
+}
