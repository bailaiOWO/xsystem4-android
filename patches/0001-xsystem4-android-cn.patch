+/* Keep newer Sys43VM slot metadata alongside the existing gsave format. Never
+ * rewrite the game state just to update its description. Strings remain in
+ * the script's encoding, including Chinese and embedded newlines. */
+static char *group_comment_path(struct string *filename)
+{
+	char *save = savedir_path(filename->text);
+	char *path = xmalloc(strlen(save) + sizeof(".comment"));
+	sprintf(path, "%s.comment", save);
+	free(save);
+	return path;
+}
+
+static int gsave_record_int(struct gsave *save, struct gsave_record *rec, const char *name)
+{
+	struct gsave_struct_def *def = save->version >= 7 && rec->struct_index >= 0
+		&& rec->struct_index < save->nr_struct_defs ? &save->struct_defs[rec->struct_index] : NULL;
+	for (int i = 0; i < rec->nr_indices; i++) {
+		int index = rec->indices[i];
+		if (index < 0 || index >= save->nr_keyvals) continue;
+		const char *field = def ? (i < def->nr_fields ? def->fields[i].name : NULL) : save->keyvals[index].name;
+		if (field && !strcmp(field, name)) return max(0, save->keyvals[index].value);
+	}
+	return 0;
+}
