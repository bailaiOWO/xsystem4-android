+++ b/src/apeg.c
@@ -0,0 +1,231 @@
+/* AliceSoft APEG playback (see include/apeg.h).
+ * Video decoding and YUV presentation adapted from TomorrowX6/re-xsystem4,
+ * commit 683a119d0ab2b23e0440c6f5e84e2141653e5503, src/movie_plmpeg.c.
+ * Original movie backend: Copyright (C) 2023 kichikuou.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <SDL.h>
+
+#include "system4.h"
+#include "system4/archive.h"
+#include "system4/file.h"
+
+#include "apeg.h"
+#include "apeg_decoder.h"
+#include "gfx/gfx.h"
+#include "asset_manager.h"
+#include "mixer.h"
+#include "xsystem4.h"
+
+struct apeg_player {
+	struct apeg_decoder *decoder;
+	int width, height;
+	int duration;
+	struct channel *sound;
+	GLuint textures[3]; // Y, Cb, Cr; storage is allocated once per movie.
+	bool started;
+	bool seek_pending;
+	int last_pos;
+	uint32_t last_tick;
+};
+
+static void apeg_free_sound_data(struct archive_data *data)
+{
+	free(data->data);
+	free(data->name);
+	free(data);
+}
+
+static struct archive_ops apeg_sound_ops = { .free_data = apeg_free_sound_data };
+static struct archive apeg_sound_archive = { .ops = &apeg_sound_ops };
+
+static Shader apeg_shader;
+
+static void prepare_apeg_shader(struct gfx_render_job *job, void *data)
+{
+	struct apeg_player *p = data;
+	for (unsigned i = 0; i < 3; i++) {
+		glActiveTexture(GL_TEXTURE0 + i);
+		glBindTexture(GL_TEXTURE_2D, p->textures[i]);
+	}
+}
+
+static void load_apeg_shader(void)
+{
+	gfx_load_shader(&apeg_shader, "shaders/render.v.glsl", "shaders/movie.f.glsl");
+	glUseProgram(apeg_shader.program);
+	glUniform1i(glGetUniformLocation(apeg_shader.program, "texture_y"), 0);
+	glUniform1i(glGetUniformLocation(apeg_shader.program, "texture_cb"), 1);
+	glUniform1i(glGetUniformLocation(apeg_shader.program, "texture_cr"), 2);
+	apeg_shader.prepare = prepare_apeg_shader;
+}
+
+struct apeg_player *apeg_open(const char *game_path, int mixer_no)
+{
+	char *path = gamedir_path_icase(game_path);
+	FILE *fp = path ? file_open_utf8(path, "rb") : NULL;
+	if (!fp) {
+		WARNING("%s: %s", path ? display_utf0(path) : game_path, strerror(errno));
+		free(path);
+		return NULL;
+	}
+	struct apeg_decoder *decoder = apeg_decoder_open(fp);
+	if (!decoder) {
+		WARNING("%s: invalid APEG movie", display_utf0(path));
+		free(path);
+		return NULL;
+	}
+	struct apeg_player *p = xcalloc(1, sizeof(*p));
+	p->decoder = decoder;
+	p->width = apeg_decoder_width(decoder);
+	p->height = apeg_decoder_height(decoder);
+	p->duration = apeg_decoder_duration(decoder);
+
+	size_t size;
+	uint8_t *sound = apeg_decoder_read_sound(decoder, &size);
+	if (sound) {
+		struct archive_data *d = xcalloc(1, sizeof(*d));
+		d->data = sound;
+		d->size = size;
+		d->name = xstrdup(game_path);
+		d->no = -1;
+		d->archive = &apeg_sound_archive;
+		p->sound = channel_open_archive_data(d, ASSET_SOUND, -1);
+		if (p->sound && !channel_set_group(p->sound, mixer_no))
+			WARNING("APEG: invalid sound group %d", mixer_no);
+	}
+	if (!p->sound)
+		WARNING("%s: no playable sound track", display_utf0(path));
+	NOTICE("APEG %s: %dx%d, %d ms, video%s", display_utf0(path), p->width, p->height,
+	       p->duration, p->sound ? " + audio" : " (silent)");
+	free(path);
+	return p;
+}
+
+void apeg_close(struct apeg_player *p)
+{
+	if (!p)
+		return;
+	if (p->sound)
+		channel_close(p->sound);
+	if (p->textures[0])
+		glDeleteTextures(3, p->textures);
+	apeg_decoder_close(p->decoder);
+	free(p);
+}
+
+int apeg_width(struct apeg_player *p) { return p->width; }
+int apeg_height(struct apeg_player *p) { return p->height; }
+int apeg_duration(struct apeg_player *p) { return p->duration; }
+
+/* The movie clock follows the sound track while it plays (so it stops while
+ * the app is in the background and the audio device is paused) and the
+ * wall clock otherwise. */
+int apeg_position(struct apeg_player *p)
+{
+	if (!p->started)
+		return p->last_pos;
+	uint32_t now = SDL_GetTicks();
+	if (p->sound && channel_is_playing(p->sound))
+		p->last_pos = channel_get_pos(p->sound);
+	else
+		p->last_pos += (int)(now - p->last_tick);
+	p->last_tick = now;
+	if (p->last_pos > p->duration)
+		p->last_pos = p->duration;
+	return p->last_pos;
+}
+
+void apeg_seek(struct apeg_player *p, int msec)
+{
+	if (msec < 0)
+		msec = 0;
+	if (msec > p->duration)
+		msec = p->duration;
+	p->seek_pending = false;
+	if (!apeg_decoder_seek(p->decoder, msec)) {
+		WARNING("APEG seek failed at %d ms", msec);
+		return;
+	}
+	p->seek_pending = true;
+	p->last_pos = msec;
+	p->last_tick = SDL_GetTicks();
+	if (p->sound)
+		channel_seek(p->sound, msec);
+}
+
+bool apeg_play(struct apeg_player *p, int msec)
+{
+	apeg_seek(p, msec);
+	if (!p->seek_pending)
+		return false;
+	p->started = true;
+	if (p->sound && p->last_pos < channel_get_time_length(p->sound))
+		channel_play(p->sound);
+	return true;
+}
+
+bool apeg_is_end(struct apeg_player *p)
+{
+	return p->started && apeg_position(p) >= p->duration;
+}
+
+/* Upload only a new presentation frame. The decoder keeps its reference
+ * pictures and the GPU keeps its three plane allocations between frames. */
+bool apeg_draw(struct apeg_player *p, struct texture *target)
+{
+	if (!p || (!p->started && !p->seek_pending) || !target || !target->handle)
+		return false;
+	plm_frame_t *frame = apeg_decoder_frame(p->decoder, apeg_position(p));
+	if (!frame)
+		return false;
+	p->seek_pending = false;
+	if (!apeg_shader.program)
+		load_apeg_shader();
+	bool allocate = !p->textures[0];
+	if (allocate)
+		glGenTextures(3, p->textures);
+	plm_plane_t *planes[] = { &frame->y, &frame->cb, &frame->cr };
+	for (unsigned i = 0; i < 3; i++) {
+		glActiveTexture(GL_TEXTURE0 + i);
+		glBindTexture(GL_TEXTURE_2D, p->textures[i]);
+		plm_plane_t *plane = planes[i];
+		if (allocate) {
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, plane->width, plane->height, 0,
+			             GL_RED, GL_UNSIGNED_BYTE, plane->data);
+		} else {
+			glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, plane->width, plane->height,
+			                GL_RED, GL_UNSIGNED_BYTE, plane->data);
+		}
+	}
+
+	GLuint fbo = gfx_set_framebuffer(GL_DRAW_FRAMEBUFFER, target, 0, 0, target->w, target->h);
+	// Plane storage is macroblock-padded. Let the viewport crop that padding
+	// instead of stretching it into the visible picture.
+	float w = (float)target->w * frame->y.width / p->width;
+	float h = (float)target->h * frame->y.height / p->height;
+	mat4 world_transform = WORLD_TRANSFORM(w, h, 0, 0);
+	mat4 view_transform = WV_TRANSFORM(target->w, target->h);
+	struct gfx_render_job job = {
+		.shader = &apeg_shader,
+		.shape = GFX_RECTANGLE,
+		.world_transform = world_transform[0],
+		.view_transform = view_transform[0],
+		.data = p,
+	};
+	glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ZERO);
+	gfx_render(&job);
+	glActiveTexture(GL_TEXTURE0);
+	gfx_reset_framebuffer(GL_DRAW_FRAMEBUFFER, fbo);
+	return true;
+}
