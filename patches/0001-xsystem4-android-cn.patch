+static float post_filter_exponent(float value)
+{
+	// RanceQuest's zero-initialized CReignSetting persists FilterY=0 in
+	// 3DSetting.asd. Treat an unset/invalid override as the identity: using
+	// zero as an exponent removes luminance from the entire 3D image.
+	return isfinite(value) && value > 0.0f ? value : 1.0f;
+}
+
+static void post_target(struct RE_renderer *r, struct texture *target)
+{
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, r->post_fbo);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+		GL_TEXTURE_2D, target->handle, 0);
+	glViewport(0, 0, target->w, target->h);
+}
+
+static void post_sample(struct RE_renderer *r, struct texture *source, int operation)
+{
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, source->handle);
+	glUniform1i(glGetUniformLocation(r->post_program, "operation"), operation);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+}
+
+static void render_post_effects(struct RE_plugin *plugin, struct texture *target, GLuint output_fbo)
+{
+	// Tapir's glare and Y/Cb/Cr controls operate on the completed 3D image.
+	bool glare = plugin->glare_mode != 0;
+	float y = post_filter_exponent(plugin->post_effect_filter_y);
+	float cb = post_filter_exponent(plugin->post_effect_filter_cb);
+	float cr = post_filter_exponent(plugin->post_effect_filter_cr);
+	if (plugin->version != RE_TAPIR_PLUGIN || (!glare
+			&& y == 1.0f && cb == 1.0f && cr == 1.0f))
+		return;
+	struct RE_renderer *r = plugin->renderer;
+	if (!r->post_program) {
+		r->post_program = load_shader("shaders/reign_post.v.glsl", "shaders/reign_post.f.glsl");
+		glGenVertexArrays(1, &r->post_vao);
+		glGenFramebuffers(1, &r->post_fbo);
+	}
+	// Texture allocation must not leave a render target on the glare sampler.
+	glActiveTexture(GL_TEXTURE0);
+	if (r->post_scene.w != target->w || r->post_scene.h != target->h) {
+		gfx_delete_texture(&r->post_scene);
+		gfx_delete_texture(&r->post_glare[0]);
+		gfx_delete_texture(&r->post_glare[1]);
+		gfx_init_texture_blank(&r->post_scene, target->w, target->h);
+		int w = max(1, target->w / 4), h = max(1, target->h / 4);
+		gfx_init_texture_blank(&r->post_glare[0], w, h);
+		gfx_init_texture_blank(&r->post_glare[1], w, h);
+	}
+	GLint saved_read_fbo;
+	glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &saved_read_fbo);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, output_fbo);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, r->post_scene.handle);
+	glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, target->w, target->h);
+	glDisable(GL_BLEND);
+	glUseProgram(r->post_program);
+	glBindVertexArray(r->post_vao);
+	glUniform1i(glGetUniformLocation(r->post_program, "tex"), 0);
+	glUniform1i(glGetUniformLocation(r->post_program, "glare_tex"), 1);
+	if (glare) {
+		post_target(r, &r->post_glare[0]);
+		glUniform4fv(glGetUniformLocation(r->post_program, "brightness"), 1, plugin->glare_brightness);
+		post_sample(r, &r->post_scene, 0);
+		post_target(r, &r->post_glare[1]);
+		glUniform2f(glGetUniformLocation(r->post_program, "blur_step"), 1.0f / r->post_glare[0].w, 0.0f);
+		post_sample(r, &r->post_glare[0], 1);
+		post_target(r, &r->post_glare[0]);
+		glUniform2f(glGetUniformLocation(r->post_program, "blur_step"), 0.0f, 1.0f / r->post_glare[1].h);
+		post_sample(r, &r->post_glare[1], 1);
+	}
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, output_fbo);
+	glViewport(0, 0, target->w, target->h);
+	glUniform1i(glGetUniformLocation(r->post_program, "use_glare"), glare);
+	glUniform3f(glGetUniformLocation(r->post_program, "ycbcr_exponent"), y, cb, cr);
+	glActiveTexture(GL_TEXTURE1);
+	glBindTexture(GL_TEXTURE_2D, r->post_glare[0].handle);
+	post_sample(r, &r->post_scene, 2);
+	glBindVertexArray(0);
+	glUseProgram(0);
+	glActiveTexture(GL_TEXTURE1);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, saved_read_fbo);
+	glEnable(GL_BLEND);
+}
