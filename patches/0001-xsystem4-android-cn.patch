+#include <stdlib.h>
+#include <string.h>
+
 #include "hll.h"
 #include "vm/page.h"
 
+/*
+ * Rance X declares these as:
+ *     void Alloc(ref array<?>, int, int, int, int)
+ *     void Free(ref array<?>)
+ * The four integers describe the array to build; the first call is logged so
+ * the exact meaning/order can be confirmed from a real run.
+ */
+static void Array_Alloc(struct page **array, int size, int a, int b, int c)
+{
+	static int logged = 0;
+	if (logged < 8) {
+		NOTICE("Array.Alloc(size=%d, %d, %d, %d)", size, a, b, c);
+		logged++;
+	}
+	if (size < 0)
+		size = 0;
+	union vm_value dims[1] = { { .i = size } };
+	*array = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+}
+
+static void Array_Free(struct page **array)
+{
+	if (!array)
+		return;
+	// The VM owns pages; dropping the reference is enough.
+	*array = NULL;
+}
+
+/*
+ * Helpers shared by the container operations below. They work on flat arrays of
+ * a single dimension; anything else is left alone rather than guessed at.
+ */
+static int array_len(struct page *array)
+{
+	if (!array || array->type != ARRAY_PAGE || array->array.rank != 1)
+		return 0;
+	return array->nr_vars;
+}
+
+static int Array_Numof(struct page *array)
+{
+	return array_len(array);
+}
+
+static bool Array_Empty(struct page *array)
+{
+	return array_len(array) == 0;
+}
+
+static void Array_Reverse(struct page *array)
+{
+	int n = array_len(array);
+	for (int i = 0; i < n / 2; i++) {
+		union vm_value tmp = array->values[i];
+		array->values[i] = array->values[n - 1 - i];
+		array->values[n - 1 - i] = tmp;
+	}
+}
+
+static bool array_is_int(struct page *array)
+{
+	return array && array->type == ARRAY_PAGE && array->array.rank == 1 &&
+	       array->a_type == AIN_ARRAY_INT;
+}
+
+static void Array_Shuffle(struct page *array, int seed)
+{
+	int n = array_len(array);
+	if (n < 2 || !array_is_int(array))
+		return;
+	srand(seed);
+	for (int i = n - 1; i > 0; i--) {
+		int j = rand() % (i + 1);
+		union vm_value tmp = array->values[i];
+		array->values[i] = array->values[j];
+		array->values[j] = tmp;
+	}
+}
+
+static int int_compare(const void *a, const void *b)
+{
+	int x = ((const union vm_value*)a)->i;
+	int y = ((const union vm_value*)b)->i;
+	return (x > y) - (x < y);
+}
+
+// The script declares these as returning the array reference.
+static struct page *Array_AscSort(struct page *array)
+{
+	if (array_is_int(array))
+		qsort(array->values, array->nr_vars, sizeof(union vm_value), int_compare);
+	return array;
+}
+
+static struct page *Array_DescSort(struct page *array)
+{
+	if (!array_is_int(array))
+		return array;
+	Array_AscSort(array);
+	int n = array->nr_vars;
+	for (int i = 0; i < n / 2; i++) {
+		union vm_value tmp = array->values[i];
+		array->values[i] = array->values[n - 1 - i];
+		array->values[n - 1 - i] = tmp;
+	}
+	return array;
+}
+
+static struct page *Array_QuickSort(struct page *array)
+{
+	return Array_AscSort(array);
+}
+
+static struct page *Array_Sort(struct page *array)
+{
+	return Array_AscSort(array);
+}
+
+static int Array_Copy(struct page **dst, struct page *src)
+{
+	int n = array_len(src);
+	if (n == 0 || !array_is_int(src))
+		return 0;
+	union vm_value dims[1] = { { .i = n } };
+	*dst = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!*dst)
+		return 0;
+	memcpy((*dst)->values, src->values, n * sizeof(union vm_value));
+	return n;
+}
+
+static int Array_Concat(struct page **dst, struct page *src)
+{
+	int n = array_len(*dst), m = array_len(src);
+	if (m == 0 || !array_is_int(*dst) || !array_is_int(src))
+		return n;
+	union vm_value dims[1] = { { .i = n + m } };
+	struct page *grown = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!grown)
+		return n;
+	memcpy(grown->values, (*dst)->values, n * sizeof(union vm_value));
+	memcpy(grown->values + n, src->values, m * sizeof(union vm_value));
+	*dst = grown;
+	return n + m;
+}
+
+static bool Array_Erase(struct page **array, int index)
+{
+	int n = array_len(*array);
+	if (index < 0 || index >= n)
+		return false;
+	for (int i = index; i < n - 1; i++)
+		(*array)->values[i] = (*array)->values[i + 1];
+	(*array)->nr_vars = n - 1;
+	return true;
+}
+
+static void Array_Unique(struct page **array)
+{
+	if (!array_is_int(*array))
+		return;
+	struct page *a = *array;
+	int n = a->nr_vars, out = 0;
+	for (int i = 0; i < n; i++) {
+		bool seen = false;
+		for (int j = 0; j < out; j++) {
+			if (a->values[j].i == a->values[i].i) {
+				seen = true;
+				break;
+			}
+		}
+		if (!seen)
+			a->values[out++] = a->values[i];
+	}
+	a->nr_vars = out;
+}
+
+// Generic values arrive as a pointer to the raw slot, so the same code stores
+// ints, floats, strings and heap references alike.
+static void Array_PushBack(struct page **array, union vm_value *value)
+{
+	int n = array_len(*array);
+	if (!array_is_int(*array) || !value)
+		return;
+	union vm_value dims[1] = { { .i = n + 1 } };
+	struct page *grown = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!grown)
+		return;
+	memcpy(grown->values, (*array)->values, n * sizeof(union vm_value));
+	grown->values[n] = *value;
+	*array = grown;
+}
+
+static void Array_PopBack(struct page **array)
+{
+	int n = array_len(*array);
+	if (n > 0)
+		(*array)->nr_vars = n - 1;
+}
+
+static void Array_Realloc(struct page **array, int size)
+{
+	int n = array_len(*array);
+	if (size < 0)
+		size = 0;
+	if (n == size)
+		return;
+	if (!array_is_int(*array)) {
+		*array = NULL;
+		n = 0;
+	}
+	union vm_value dims[1] = { { .i = size } };
+	struct page *grown = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!grown)
+		return;
+	int copy = n < size ? n : size;
+	if (n > 0)
+		memcpy(grown->values, (*array)->values, copy * sizeof(union vm_value));
+	*array = grown;
+}
+
+static void Array_Duplicate(struct page **dst, struct page *src)
+{
+	int n = array_len(src);
+	union vm_value dims[1] = { { .i = n } };
+	struct page *copy = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!copy)
+		return;
+	if (n > 0)
+		memcpy(copy->values, src->values, n * sizeof(union vm_value));
+	*dst = copy;
+}
+
+static struct page *Array_ShallowCopy(struct page *src)
+{
+	int n = array_len(src);
+	union vm_value dims[1] = { { .i = n } };
+	struct page *copy = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (copy && n > 0)
+		memcpy(copy->values, src->values, n * sizeof(union vm_value));
+	return copy;
+}
+
+// Values of generic parameters arrive as a pointer to the raw slot.
+static int Array_Insert(struct page **array, int index, union vm_value *value)
+{
+	int n = array_len(*array);
+	if (!array_is_int(*array) || !value)
+		return n;
+	if (index < 0)
+		index = 0;
+	if (index > n)
+		index = n;
+	union vm_value dims[1] = { { .i = n + 1 } };
+	struct page *grown = alloc_array(1, dims, AIN_ARRAY_INT, -1, true);
+	if (!grown)
+		return n;
+	memcpy(grown->values, (*array)->values, index * sizeof(union vm_value));
+	grown->values[index] = *value;
+	memcpy(grown->values + index + 1, (*array)->values + index,
+	       (n - index) * sizeof(union vm_value));
+	*array = grown;
+	return n + 1;
+}
+
+static int Array_FillRange(struct page **array, int start, int count, union vm_value *value);
+
+static int Array_Fill(struct page **array, union vm_value *value)
+{
+	return Array_FillRange(array, 0, array_len(*array), value);
+}
+
+static int Array_FillRange(struct page **array, int start, int count, union vm_value *value)
+{
+	int n = array_len(*array);
+	if (!array_is_int(*array) || !value)
+		return 0;
+	if (start < 0)
+		start = 0;
+	if (start >= n || count <= 0)
+		return 0;
+	if (start + count > n)
+		count = n - start;
+	for (int i = 0; i < count; i++)
+		(*array)->values[start + i] = *value;
+	return count;
+}
+
+static int array_find_value(struct page *array, int from, int to, int step, union vm_value *value)
+{
+	int n = array_len(array);
+	if (!array_is_int(array) || !value)
+		return -1;
+	for (int i = from; i != to; i += step) {
+		if (i < 0 || i >= n)
+			break;
+		if (array->values[i].i == value->i)
+			return i;
+	}
+	return -1;
+}
+
+static int Array_Find(struct page *array, union vm_value *value)
+{
+	return array_find_value(array, 0, array_len(array), 1, value);
+}
+
+static int Array_FindLast(struct page *array, union vm_value *value)
+{
+	return array_find_value(array, array_len(array) - 1, -1, -1, value);
+}
+
+static bool Array_IsExist(struct page *array, union vm_value *value)
+{
+	return array_find_value(array, 0, array_len(array), 1, value) >= 0;
+}
+
+static int Array_LowerBound(struct page *array, union vm_value *value)
+{
+	int n = array_len(array);
+	if (!array_is_int(array) || !value)
+		return -1;
+	for (int i = 0; i < n; i++) {
+		if (array->values[i].i >= value->i)
+			return i;
+	}
+	return -1;
+}
+
+static int Array_UpperBound(struct page *array, union vm_value *value)
+{
+	int n = array_len(array);
+	if (!array_is_int(array) || !value)
+		return -1;
+	for (int i = 0; i < n; i++) {
+		if (array->values[i].i > value->i)
+			return i;
+	}
+	return -1;
+}
+
+static int Array_BinarySearch(struct page *array, union vm_value *value)
+{
+	int n = array_len(array);
+	if (!array_is_int(array) || !value)
+		return -1;
+	int lo = 0, hi = n - 1;
+	while (lo <= hi) {
+		int mid = (lo + hi) / 2;
+		if (array->values[mid].i == value->i)
+			return mid;
+		if (array->values[mid].i < value->i)
+			lo = mid + 1;
+		else
+			hi = mid - 1;
+	}
+	return -1;
+}
+
+static int Array_CopyFrom(struct page **dst, int dst_i, struct page *src, int src_i, int count)
+{
+	int dn = array_len(*dst), sn = array_len(src);
+	if (!array_is_int(*dst) || !array_is_int(src))
