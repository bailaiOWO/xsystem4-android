+			fno >= 0 && fno < ain->nr_functions ? ain->functions[fno].name : "invalid",
+			call_stack[i].struct_page, call_stack[i].page_slot, call_stack[i].call_address);
+	}
+	for (int i = stack_ptr - 1; stack && i >= 0 && i >= stack_ptr - 12; i--)
+		NOTICE("VMSTACK %d=%d", i, stack[i].i);
