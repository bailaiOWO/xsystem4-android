+
+#ifndef XSYSTEM4_QUICKSAVE_H
+#define XSYSTEM4_QUICKSAVE_H
+
+#include <stdbool.h>
+#include <setjmp.h>
+
+/* 待处理的动作 */
+#define QS_NONE 0
+#define QS_SAVE 1
+#define QS_LOAD 2
+#define QS_SAVE_FORCE 3   /* 退出游戏时强制写自动槽 */
+
+/* 槽位类型：10 个手动 + 10 个自动 */
+#define QS_KIND_MANUAL 0
+#define QS_KIND_AUTO   1
+#define QS_SLOTS       10
+
+/* 自动存档间隔：默认 10 分钟，可用滑块在 5~60 分钟之间调 */
+#define QS_AUTO_INTERVAL_DEFAULT 600
+#define QS_AUTO_INTERVAL_MIN      300
+#define QS_AUTO_INTERVAL_MAX     3600
+
+/*
+ * 读档用的长跳转目标：由 vm_execute_ain() 设置。
+ * 读档必须在指令边界把 C 调用栈清空，否则 C 栈与 VM 调用栈会错位。
+ */
+extern jmp_buf quickload_buf;
+
+void quicksave_request_save(int kind, int slot);
+void quicksave_request_load(int kind, int slot);
+int quicksave_pending_action(void);
+int quicksave_pending_kind(void);
+int quicksave_pending_slot(void);
+
+int quicksave_apply_save(void);
+void quicksave_apply_load(void);
+
+bool quicksave_exists(int kind, int slot);
+bool quicksave_delete(int kind, int slot);
+
+/* 所有槽位的状态，返回 malloc 的 JSON */
+char *quicksave_list_json(void);
+
+/* 由 vm_execute 的指令边界周期调用：到点就写一个自动存档槽 */
+void quicksave_check_auto(void);
+
+/* 立即写一个自动存档槽（正常退出游戏时用） */
+void quicksave_force_auto(void);
+void quicksave_apply_force_auto(void);
+
+/* 自动存档间隔（秒） */
+void quicksave_set_auto_interval(int seconds);
+int quicksave_auto_interval(void);
+
+/* 还有没有没处理完的请求（UI 侧等它落盘） */
+bool quicksave_busy(void);
+
+/* VM 是否已经跑起来（这时才适合发读档请求） */
+void quicksave_mark_vm_running(void);
+bool quicksave_vm_ready(void);
+
+/* 找时间最新的存档槽；没有存档返回 false */
+bool quicksave_latest(int *kind, int *slot);
+
+/*
+ * 启动瞬间自动恢复：在 vm_call(main) 之前调用，直接从快照接着跑 ——
+ * main 一次都不执行，所以玩家看不到主菜单一闪而过。
+ * 返回 true 表示已经恢复，调用方不要再执行 main。
+ * 开关用存档目录里的 .no_auto_resume 文件表示（Kotlin 侧切换）。
+ */
+bool quicksave_auto_resume(void);
+void quicksave_set_auto_resume(bool on);
+bool quicksave_auto_resume_enabled(void);
+
+#endif /* XSYSTEM4_QUICKSAVE_H */
