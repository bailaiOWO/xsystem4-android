+/* AIN 11 Activity vertical scrollbars. SPDX-License-Identifier: GPL-2.0-or-later */
+struct parts_scrollbar *parts_scrollbar_get(struct parts *p)
+{
+	if (!p->scrollbar) {
+		p->scrollbar = xcalloc(1, sizeof(*p->scrollbar));
+		*p->scrollbar = (struct parts_scrollbar){.w=32, .h=360, .up=32, .down=32,
+			.total=1024, .view=360, .step=20};
+		p->component_type_override = 3; // modern widget type 2
+		p->clickable = true;
+		parts_scrollbar_resize(p);
+	}
+	return p->scrollbar;
+}
+
+void parts_scrollbar_free(struct parts_scrollbar *s)
+{
+	if (!s) return;
+	for (int i=0; i<5; i++) {
+		if (s->flat[i]) free_string(s->flat[i]);
+		if (s->cg[i]) free_string(s->cg[i]);
+	}
+	for (int i=0; i<4; i++) parts_state_free(&s->visuals[i]);
+	free(s);
+}
+
+void parts_scrollbar_set_pos(struct parts *p, int pos, bool notify)
+{
+	struct parts_scrollbar *s = parts_scrollbar_get(p);
+	pos = max(0, min(max(0, s->total - s->view), pos));
+	if (s->pos == pos) return;
+	s->pos = pos;
+	parts_dirty(p);
+	if (notify) s->notify_pending = true;
+}
+
+void parts_scrollbar_flush_notification(struct parts *p)
+{
+	struct parts_scrollbar *s = p->scrollbar;
+	if (!s || !s->notify_pending || p->delegate_index < 0) return;
+	s->notify_pending = false;
+	parts_msg_push(p, PARTS_MSG_SCROLL, "ii", s->pos, s->total);
+}
+
+void parts_scrollbar_resize(struct parts *p)
+{
+	struct parts_scrollbar *s = p->scrollbar;
+	if (!s) return;
+	s->w = max(0,s->w); s->h = max(0,s->h);
+	for (int i=0; i<PARTS_NR_STATES; i++) {
+		if (p->states[i].type != PARTS_RECT_DETECTION)
+			parts_state_reset(&p->states[i], PARTS_RECT_DETECTION);
+		parts_set_dims(p, &p->states[i].common, s->w, s->h);
+	}
+	parts_scrollbar_set_pos(p,s->pos,false);
+	parts_dirty(p);
+}
+
+Rectangle parts_scrollbar_rect(struct parts_scrollbar *s, int piece)
+{
+	int length = s->horizontal ? s->w : s->h;
+	int width = s->horizontal ? s->h : s->w;
+	int up = min(length,max(0,s->up));
+	int down = min(length-up,max(0,s->down));
+	int track = length-up-down;
+	int thumb = s->total <= s->view || s->total <= 0 ? track
+		: min(track,max(min(track,width),(int)((double)track*s->view/s->total)));
+	int range = max(0,s->total-s->view);
+	int y = up + (range ? (int)((double)(track-thumb)*s->pos/range) : 0);
+	Rectangle r;
+	switch (piece) {
+	case 1: r=(Rectangle){0,0,width,up}; break;
+	case 2: r=(Rectangle){0,length-down,width,down}; break;
+	case 3: r=(Rectangle){0,y,width,thumb}; break;
+	default:r=(Rectangle){0,up,width,track}; break;
+	}
+	return s->horizontal ? (Rectangle){r.y,r.x,r.h,r.w} : r;
+}
+
+void parts_scrollbar_load_assets(struct parts *p)
+{
+	struct parts_scrollbar *s = parts_scrollbar_get(p);
+	const int override[] = {4,1,2,3};
+	const char *vertical[] = {"／背景.flat", "／上按钮／一般.flat", "／下按钮／一般.flat", "／栏／一般.flat"};
+	const char *horizontal[] = {"／背景.flat", "／左按钮／一般.flat", "／右按钮／一般.flat", "／栏／一般.flat"};
+	const char **suffix = s->horizontal ? horizontal : vertical;
+	for (int i=0; i<4; i++) {
+		int idx = override[i];
+		struct string *name = NULL;
+		if (s->flat[idx] && s->flat[idx]->size) {
+			name = string_dup(s->flat[idx]);
+			// Thumb/button overrides name the animation group, not a state.
+			if (i && !asset_exists_by_name(ASSET_FLAT,name->text,NULL)) {
+				char *tail = utf2gbk("／一般.flat",0);
+				string_append_cstr(&name,tail,strlen(tail)); free(tail);
+			}
+		} else if (s->flat[0] && s->flat[0]->size) {
+			name = string_dup(s->flat[0]);
+			char *tail = utf2gbk(suffix[i],0);
+			string_append_cstr(&name,tail,strlen(tail)); free(tail);
+		}
+		parts_state_free(&s->visuals[i]);
+		if (name && name->size) {
+			parts_state_reset(&s->visuals[i],PARTS_FLAT);
+			parts_flat_load(p,&s->visuals[i].flat,name);
+		} else {
+			struct string *cgname = s->cg[idx] && s->cg[idx]->size ? s->cg[idx] : s->cg[0];
+			if (cgname && cgname->size) {
+				struct cg *cg = asset_cg_load_by_name(cgname->text,NULL);
+				if (cg) {
+					parts_state_reset(&s->visuals[i],PARTS_CG);
+					gfx_init_texture_with_cg(&s->visuals[i].common.texture,cg);
+					s->visuals[i].common.w = cg->metrics.w;
+					s->visuals[i].common.h = cg->metrics.h;
+					cg_free(cg);
+				}
+			}
+		}
+		if (name) free_string(name);
+	}
+	parts_dirty(p);
+}
+
+void parts_scrollbar_input(struct parts *p, Point cursor, bool hovered, bool down,
+		bool pressed, bool released)
+{
+	struct parts_scrollbar *s = p->scrollbar;
+	if (!s || !p->global.scale.y || !p->global.scale.x) return;
+	float angle = p->global.rotation.z * (3.14159265358979323846f/180.0f);
+	float x = cursor.x-p->global.pos.x, y = cursor.y-p->global.pos.y;
+	float local_y = (-x*sinf(angle)+y*cosf(angle))/p->global.scale.y
+		- p->states[0].common.origin_offset.y;
+	if (s->horizontal)
+		local_y = (x*cosf(angle)+y*sinf(angle))/p->global.scale.x
+			- p->states[0].common.origin_offset.x;
+	Rectangle thumb = parts_scrollbar_rect(s,3);
+	int start = s->horizontal ? thumb.x : thumb.y;
+	int size = s->horizontal ? thumb.w : thumb.h;
+	int length = s->horizontal ? s->w : s->h;
+	if (pressed && hovered) {
+		if (local_y < s->up) parts_scrollbar_set_pos(p,s->pos-s->step,true);
+		else if (local_y >= length-s->down) parts_scrollbar_set_pos(p,s->pos+s->step,true);
+		else if (local_y >= start && local_y < start+size) {
+			s->dragging = true; s->drag_offset = local_y-start;
+		} else parts_scrollbar_set_pos(p,s->pos+(local_y<start ? -s->view : s->view),true);
+	}
+	if (down && s->dragging) {
+		int travel = length-min(length,s->up)-min(max(0,length-s->up),s->down)-size;
+		int pos = travel>0 ? lroundf((local_y-s->drag_offset-s->up)*(s->total-s->view)/travel) : 0;
+		parts_scrollbar_set_pos(p,pos,true);
+	}
+	if (released) s->dragging = false;
+}
