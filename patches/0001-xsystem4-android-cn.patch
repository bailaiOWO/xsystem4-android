+// A stubbed call must consume its arguments exactly like a real one does,
+// otherwise the VM stack is left unbalanced and the VM fails much later with
+// unrelated-looking errors.
+static void stub_pop_arguments(struct ain_hll_function *f)
+{
+	for (int i = f->nr_arguments - 1; i >= 0; i--) {
+		switch (f->arguments[i].type.data) {
+		case AIN_REF_INT:
+		case AIN_REF_LONG_INT:
+		case AIN_REF_BOOL:
+		case AIN_REF_ENUM:
+		case AIN_REF_FLOAT:
+			// Immediate references occupy two stack slots.
+			if (stack_ptr < 2) VM_ERROR("Stack underflow in unimplemented HLL call");
+			stack_ptr -= 2;
+			break;
+		case AIN_REF_STRING:
+		case AIN_REF_STRUCT:
+		case AIN_REF_ARRAY_TYPE:
+		case AIN_REF_ARRAY:
+		case AIN_REF_FUNC_TYPE:
+			if (!stack_ptr) VM_ERROR("Stack underflow in unimplemented HLL call");
+			stack_ptr--;
+			break;
+		case AIN_HLL_PARAM:
+		case AIN_REF_HLL_PARAM:
+		case AIN_HLL_FUNC:
+		case AIN_IFACE:
+			VM_ERROR("Cannot discard unsupported generic HLL argument type %d",
+				f->arguments[i].type.data);
+		case AIN_ARRAY_TYPE:
+			if (!stack_ptr) VM_ERROR("Stack underflow in unimplemented HLL call");
+			/* Sys41VM lends legacy value arrays instead of copying them. */
+			if (ain->version <= 1)
+				stack_ptr--;
+			else
+				variable_fini(stack_pop(), f->arguments[i].type.data, false);
+			break;
+		default:
+			if (!stack_ptr) VM_ERROR("Stack underflow in unimplemented HLL call");
+			variable_fini(stack_pop(), f->arguments[i].type.data, false);
+			break;
+		}
+	}
