+/* Message pages repeatedly rebuild the same glyphs, especially while skipping.
+ * Share immutable rendered glyphs; active text owns a reference, and only idle
+ * entries may be evicted. Font, color, outline and spacing all belong to the key. */
+struct parts_glyph_cache {
