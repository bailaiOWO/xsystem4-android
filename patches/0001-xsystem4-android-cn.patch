+ * along with this program; if not, see <http://gnu.org/licenses/>.
+ */
+
+/*
+ * 即时存档 / 即时读档（模拟器那种任意时刻的快照）。
+ *
+ * 引擎本来就有指令级的 VM 快照原语（resume.c 的 vm_save_image / vm_load_image，
+ * 存的是整个堆 + 调用栈 + 值栈 + 指令指针），但只能由游戏脚本在固定位置调用
+ * （System.ResumeSave/ResumeLoad，用于"续玩"）。这里把它变成随时可用：
+ *
+ *   存档：请求丢给 VM 线程，在指令边界执行 —— 保证快照自洽（不会拍到半条指令）。
+ *   读档：不能在 UI 线程直接替换 VM 状态（C 调用栈会和 VM 调用栈错位），
+ *         所以同样丢给 VM 线程，在指令边界用 longjmp 一路跳回 vm_execute_ain
+ *         的 setjmp 点，把 C 栈清空，然后加载快照并重新进入 vm_execute()。
+ *         之所以可行：vm_execute() 的退出条件是 instr_ptr == VM_RETURN，
+ *         与进入时的调用栈深度无关，所以从快照的任意深度接着跑都能正常收尾。
+ *
+ * 槽位：10 个手动（quicksave1..10）+ 10 个自动（quicksave_auto1..10）。
+ * 自动槽由 quicksave_check_auto() 每 QS_AUTO_INTERVAL 秒轮换写入一个。
+ *
+ * 局限：快照只覆盖 VM（脚本变量、结构体、数组、调用栈、当前指令）。
+ * 引擎 C 侧的瞬时状态（正在播的动画帧、音频位置、sprite 对象）不在里面，
+ * 读档后画面可能要等游戏脚本自己重画一次才对齐。
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "system4.h"
+#include "xsystem4.h"
+#include "vm.h"
+#include "quicksave.h"
+#include "parts.h"
+
+#include "cJSON.h"
+
+/*
+ * resume.c 提供这两个。它们声明在 include/vm.h 的 VM_PRIVATE 段里，
+ * 这里显式再声明一次，免得依赖 VM_PRIVATE。
+ */
+int vm_save_image(const char *key, const char *path);
+void vm_load_image(const char *key, const char *path);
+
+#define QUICKSAVE_KEY "quicksave"
+
+jmp_buf quickload_buf;   /* vm.c 的 vm_execute_ain 用它做读档重入 */
+
+static volatile int qs_action = QS_NONE;
+static volatile int qs_kind;
+static volatile int qs_slot;
+
+/* 自动存档轮换状态 */
+static int auto_next_slot = 1;
+static time_t auto_last;
+static int auto_interval = QS_AUTO_INTERVAL_DEFAULT;
+static bool auto_enabled = false;   /* 定时自动存档：默认关闭，见 quicksave_check_auto() */
+static volatile bool vm_running;
+
+static bool valid_kind(int kind)
+{
+	return kind == QS_KIND_MANUAL || kind == QS_KIND_AUTO;
+}
+
+static bool valid_slot(int slot)
+{
+	return slot >= 1 && slot <= QS_SLOTS;
+}
+
+static void quicksave_name(int kind, int slot, char *buf, size_t size)
+{
+	snprintf(buf, size, kind == QS_KIND_AUTO ? "quicksave_auto%d" : "quicksave%d", slot);
+}
+
+static char *quicksave_fullpath(int kind, int slot)
+{
+	if (!config.save_dir)
+		return NULL;
+	char name[32];
+	quicksave_name(kind, slot, name, sizeof(name));
+	return savedir_path(name);
+}
+
+/* ---- 查询 ---- */
+
+bool quicksave_exists(int kind, int slot)
+{
+	if (!valid_kind(kind) || !valid_slot(slot))
+		return false;
+	char *full = quicksave_fullpath(kind, slot);
+	bool ok = full && access(full, F_OK) == 0;
+	free(full);
+	return ok;
+}
+
+bool quicksave_delete(int kind, int slot)
+{
+	if (!valid_kind(kind) || !valid_slot(slot))
+		return false;
+	char *full = quicksave_fullpath(kind, slot);
+	bool ok = full && remove(full) == 0;
+	if (ok)
+		NOTICE("QUICKSAVE deleted kind=%d slot=%d", kind, slot);
+	free(full);
+	return ok;
+}
+
+char *quicksave_list_json(void)
+{
+	cJSON *root = cJSON_CreateObject();
+	cJSON *arr = cJSON_AddArrayToObject(root, "slots");
+
+	for (int kind = QS_KIND_MANUAL; kind <= QS_KIND_AUTO; kind++) {
+		for (int slot = 1; slot <= QS_SLOTS; slot++) {
+			cJSON *o = cJSON_CreateObject();
+			cJSON_AddNumberToObject(o, "kind", kind);
+			cJSON_AddNumberToObject(o, "slot", slot);
+
+			char *full = quicksave_fullpath(kind, slot);
+			struct stat st;
+			if (full && stat(full, &st) == 0) {
+				cJSON_AddBoolToObject(o, "exists", true);
+				cJSON_AddNumberToObject(o, "size", (double)st.st_size);
+				struct tm tm;
+				localtime_r(&st.st_mtime, &tm);
+				char ts[32];
+				strftime(ts, sizeof(ts), "%m-%d %H:%M", &tm);
+				cJSON_AddStringToObject(o, "time", ts);
+			} else {
+				cJSON_AddBoolToObject(o, "exists", false);
+				cJSON_AddStringToObject(o, "time", "");
+			}
+			free(full);
+			cJSON_AddItemToArray(arr, o);
+		}
+	}
+
+	cJSON_AddBoolToObject(root, "ok", true);
+	cJSON_AddNumberToObject(root, "autoInterval", auto_interval);
+	cJSON_AddBoolToObject(root, "vmReady", vm_running);
+	char *out = cJSON_PrintUnformatted(root);
+	cJSON_Delete(root);
+	return out;
+}
+
+/* ---- UI 线程调用：只登记请求，真正的活由 VM 线程在指令边界干 ---- */
+
+void quicksave_request_save(int kind, int slot)
+{
+	qs_kind = kind;
+	qs_slot = slot;
+	qs_action = QS_SAVE;
+}
+
+void quicksave_request_load(int kind, int slot)
+{
+	qs_kind = kind;
+	qs_slot = slot;
+	qs_action = QS_LOAD;
+}
+
+int quicksave_pending_action(void)
+{
+	return qs_action;
+}
+
+int quicksave_pending_kind(void)
+{
+	return qs_kind;
+}
+
+int quicksave_pending_slot(void)
+{
+	return qs_slot;
+}
+
+/* ---- VM 线程调用 ---- */
+
+static int quicksave_write(int kind, int slot)
+{
+	char name[32];
+	quicksave_name(kind, slot, name, sizeof(name));
+	int r = vm_save_image(QUICKSAVE_KEY, name);
+	NOTICE("QUICKSAVE saved kind=%d slot=%d (%s) result=%d", kind, slot, name, r);
+	return r;
+}
+
+int quicksave_apply_save(void)
+{
+	int kind = qs_kind, slot = qs_slot;
+	qs_action = QS_NONE;
+	return quicksave_write(kind, slot);
+}
+
+void quicksave_apply_load(void)
+{
+	int kind = qs_kind, slot = qs_slot;
+	qs_action = QS_NONE;
+
+	char name[32];
+	quicksave_name(kind, slot, name, sizeof(name));
+	NOTICE("QUICKSAVE loading kind=%d slot=%d (%s)", kind, slot, name);
+	vm_load_image(QUICKSAVE_KEY, name);
+	vm_restore_input_depth();
+}
+
+/*
+ * 到点就轮到下一个自动槽。在指令边界调用，所以快照是自洽的。
+ * 用 wall clock（time()）而不是引擎时间：引擎时间会被变速齿轮缩放，
+ * 而"多久自动存一次"应该按玩家的真实时间算。
+ */
+void quicksave_check_auto(void)
+{
+	/*
+	 * 默认不自动存档。
+	 *
+	 * 原因（实测）：引擎的全量快照要先把整个存档在内存里构建好再落盘。
+	 * 游戏跑久了内存本来就紧，定时触发很容易撞上内存不足，
+	 * 而引擎对分配失败是 Fatal 处理 —— 结果是整个进程 SIGABRT。
+	 * 日志实证：*ERROR*(save_stack_to_rsave): Out of memory 之后立刻 signal 6。
+	 * 手动存档由玩家主动触发，风险自担；自动触发会变成"随机闪退"，不能默认开。
+	 */
+	if (!auto_enabled)
+		return;
+	time_t now = time(NULL);
+	if (auto_last == 0) {
+		auto_last = now;
+		return;
+	}
+	if (now - auto_last < auto_interval)
+		return;
+	auto_last = now;
+
+	int slot = auto_next_slot;
+	auto_next_slot = (auto_next_slot % QS_SLOTS) + 1;
+	quicksave_write(QS_KIND_AUTO, slot);
+}
+
+/* 正常退出游戏时强制写一次自动存档（不看间隔） */
+void quicksave_force_auto(void)
+{
+	int slot = auto_next_slot;
+	auto_next_slot = (auto_next_slot % QS_SLOTS) + 1;
+	auto_last = time(NULL);
+	NOTICE("QUICKSAVE forced auto save (slot %d)", slot);
+	quicksave_write(QS_KIND_AUTO, slot);
+}
+
+void quicksave_apply_force_auto(void)
+{
+	qs_action = QS_NONE;
+	quicksave_force_auto();
+}
+
+void quicksave_set_auto_interval(int seconds)
+{
+	if (seconds < QS_AUTO_INTERVAL_MIN)
+		seconds = QS_AUTO_INTERVAL_MIN;
+	if (seconds > QS_AUTO_INTERVAL_MAX)
+		seconds = QS_AUTO_INTERVAL_MAX;
+	auto_interval = seconds;
+	NOTICE("QUICKSAVE auto interval = %d s", seconds);
+}
+
+int quicksave_auto_interval(void)
+{
+	return auto_interval;
+}
+
+bool quicksave_busy(void)
+{
+	return qs_action != QS_NONE;
+}
+
+void quicksave_mark_vm_running(void)
+{
+	vm_running = true;
+}
+
+bool quicksave_vm_ready(void)
+{
+	return vm_running;
+}
+
+#define QS_NO_RESUME_FILE ".no_auto_resume"
+
+static char *quicksave_flag_path(void)
+{
+	return savedir_path(QS_NO_RESUME_FILE);
+}
+
+bool quicksave_auto_resume_enabled(void)
+{
+	/*
+	 * UI 线程在引擎启动前就可能问到这个问题，那时 config.save_dir 还是空的，
+	 * 去拼路径会直接崩（整个应用一起挂）。没就绪就先按"启用"回答。
+	 */
+	if (!config.save_dir)
+		return true;
+	char *p = quicksave_flag_path();
+	bool disabled = p && access(p, F_OK) == 0;
+	free(p);
+	return !disabled;
+}
+
+void quicksave_set_auto_resume(bool on)
+{
+	if (!config.save_dir)
+		return;
+	char *p = quicksave_flag_path();
+	if (!p)
+		return;
+	if (on) {
+		remove(p);
+	} else {
+		FILE *f = fopen(p, "w");
+		if (f)
+			fclose(f);
+	}
+	free(p);
+}
+
+/*
+ * 启动瞬间恢复。此时 VM 已经初始化完毕（堆/栈/全局变量都在），
+ * 直接把快照整体装进来，然后调用方直接进 vm_execute() 接着跑 ——
+ * main 一次都不会执行，所以看不到主菜单。
+ */
+bool quicksave_auto_resume(void)
+{
+	if (!quicksave_auto_resume_enabled())
+		return false;
+	int kind = 0, slot = 0;
+	if (!quicksave_latest(&kind, &slot))
+		return false;
+	char name[32];
+	quicksave_name(kind, slot, name, sizeof(name));
+	NOTICE("QUICKSAVE auto-resume from kind=%d slot=%d (%s)", kind, slot, name);
+	vm_load_image(QUICKSAVE_KEY, name);
+	vm_restore_input_depth();
+	return true;
+}
+
+/* 时间最新的槽位（手动 + 自动一起比） */
+bool quicksave_latest(int *out_kind, int *out_slot)
+{
+	time_t best = 0;
+	bool found = false;
+	for (int kind = QS_KIND_MANUAL; kind <= QS_KIND_AUTO; kind++) {
+		for (int slot = 1; slot <= QS_SLOTS; slot++) {
+			char *full = quicksave_fullpath(kind, slot);
+			struct stat st;
+			if (full && stat(full, &st) == 0 && st.st_mtime >= best) {
+				best = st.st_mtime;
+				*out_kind = kind;
+				*out_slot = slot;
+				found = true;
+			}
+			free(full);
+		}
+	}
+	return found;
+}
+
+#ifdef __ANDROID__
+#include <jni.h>
+
+JNIEXPORT jstring JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickList(
+	JNIEnv *env, jobject thiz)
+{
+	(void)thiz;
+	char *json = quicksave_list_json();
+	jstring ret = (*env)->NewStringUTF(env, json ? json : "{\"ok\":false}");
+	free(json);
+	return ret;
+}
+
+/* 请求存档到指定槽；0 = 已受理 */
+JNIEXPORT jint JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickSaveTo(
+	JNIEnv *env, jobject thiz, jint kind, jint slot)
+{
+	(void)env;
+	(void)thiz;
+	if (!valid_kind((int)kind) || !valid_slot((int)slot))
+		return 2;
+	quicksave_request_save((int)kind, (int)slot);
+	return 0;
+}
+
+/* 请求从指定槽读档；0 = 已受理，1 = 该槽没有存档 */
+JNIEXPORT jint JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickLoadFrom(
+	JNIEnv *env, jobject thiz, jint kind, jint slot)
+{
+	(void)env;
+	(void)thiz;
+	if (!quicksave_exists((int)kind, (int)slot))
+		return 1;
+	quicksave_request_load((int)kind, (int)slot);
+	return 0;
+}
+
+/* 设置自动存档间隔（秒） */
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickSetInterval(
+	JNIEnv *env, jobject thiz, jint seconds)
+{
+	(void)env;
+	(void)thiz;
+	quicksave_set_auto_interval((int)seconds);
+}
+
+/* 强制写一次自动存档（退出游戏时用）；返回后仍需等 quicksave_busy() 变 false */
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickForceAuto(
+	JNIEnv *env, jobject thiz)
+{
+	(void)env;
+	(void)thiz;
+	qs_kind = QS_KIND_AUTO;
+	qs_action = QS_SAVE_FORCE;
+}
+
+JNIEXPORT jboolean JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickBusy(
+	JNIEnv *env, jobject thiz)
+{
+	(void)env;
+	(void)thiz;
+	return quicksave_busy() ? JNI_TRUE : JNI_FALSE;
+}
+
+/* VM 起来没有；返回 false 时不要发读档请求 */
+JNIEXPORT jboolean JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickVmReady(
+	JNIEnv *env, jobject thiz)
+{
+	(void)env;
+	(void)thiz;
+	return quicksave_vm_ready() ? JNI_TRUE : JNI_FALSE;
+}
+
+/* 时间最新的槽位，返回 "kind:slot"；没有则返回空串 */
+JNIEXPORT jstring JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickLatest(
+	JNIEnv *env, jobject thiz)
+{
+	(void)thiz;
+	int kind = 0, slot = 0;
+	char buf[32] = "";
+	if (quicksave_latest(&kind, &slot))
+		snprintf(buf, sizeof(buf), "%d:%d", kind, slot);
+	return (*env)->NewStringUTF(env, buf);
+}
+
+/* 开关"启动时自动读取最新存档" */
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickSetAutoResume(
+	JNIEnv *env, jobject thiz, jboolean on)
+{
+	(void)env;
+	(void)thiz;
+	quicksave_set_auto_resume(on == JNI_TRUE);
+}
+
+JNIEXPORT jboolean JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickGetAutoResume(
+	JNIEnv *env, jobject thiz)
+{
+	(void)env;
+	(void)thiz;
+	return quicksave_auto_resume_enabled() ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT jboolean JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeQuickDelete(
+	JNIEnv *env, jobject thiz, jint kind, jint slot)
+{
+	(void)env;
+	(void)thiz;
+	return quicksave_delete((int)kind, (int)slot) ? JNI_TRUE : JNI_FALSE;
+}
+#endif
