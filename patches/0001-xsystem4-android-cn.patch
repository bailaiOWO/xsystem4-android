+static int system_resume_hll_syscall(struct ain_hll_function *f)
+{
+	if (f->nr_arguments < 2 || f->arguments[0].type.data != AIN_STRING
+			|| f->arguments[1].type.data != AIN_STRING)
+		return -1;
+	if (!strcmp(f->name, "ResumeSave") && f->nr_arguments == 3
+			&& f->return_type.data == AIN_BOOL
+			&& f->arguments[2].type.data == AIN_REF_INT)
+		return SYS_RESUME_SAVE;
+	if (!strcmp(f->name, "ResumeLoad") && f->nr_arguments == 2
+			&& f->return_type.data == AIN_VOID)
+		return SYS_RESUME_LOAD;
+	return -1;
+}
+
+bool vm_system_resume_hll_supported(struct ain_hll_function *f)
+{
+	return system_resume_hll_syscall(f) >= 0;
+}
+
+void vm_system_resume_hll_call(struct ain_hll_function *f)
+{
+	int code = system_resume_hll_syscall(f);
+	if (code < 0)
+		VM_ERROR("Unsupported system resume signature: %s", f->name);
+	// Run before libffi removes the string arguments: the resume image keeps
+	// the VM stack in the same state as a legacy CALLSYS ResumeSave.
+	system_call(code);
+}
