+
+/* system.Error reports failures the script detected itself: a save or load
+ * step that did not complete ("…の保存失败", "加载失败了"), a movie that
+ * could not play, a broken script assertion. The original shows an error box
+ * and continues; logging alone hid failed saves. Each distinct message is
+ * shown once per session and always recorded in xsystem4-trace.txt. */
+static struct string *System_Error(struct string *message)
+{
+	static char *shown[32];
+	static int nr_shown;
+	char *text = sjis2utf(message->text, message->size);
+	WARNING("system.Error: %s", text);
+	trace_log("SCRIPT ERROR \"%.200s\"", message->text);
+	bool seen = false;
+	for (int i = 0; i < nr_shown && !seen; i++)
+		seen = !strcmp(shown[i], text);
+	if (!seen) {
+		if (nr_shown < (int)(sizeof(shown) / sizeof(*shown)))
+			shown[nr_shown++] = xstrdup(text);
+		char box[1024];
+		snprintf(box, sizeof(box), "游戏脚本报告了错误：\n\n%s\n\n已记录在游戏目录的 xsystem4-trace.txt。", text);
+		SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "xsystem4", box, NULL);
+	}
+	free(text);
+	return string_ref(message);
+}
