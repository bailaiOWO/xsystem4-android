+static void pa_checkbox_default(struct parts *p, int state)
+{
+	int w=p->checkbox_width, h=p->checkbox_height;
+	if (w<=0 || h<=0) return;
+	struct parts_state *s=&p->states[state];
+	parts_state_reset(s,PARTS_PANEL);
+	parts_set_dims(p,&s->common,w,h);
+	SDL_Color c=p->checkbox_color;
+	s->panel.color=c;
+	gfx_init_texture_rgba(&s->common.texture,w,h,c);
+	int light=(state==2 || (p->checkbox_button_mode && p->checkbox_checked)) ? 64 : 255;
+	int dark=light==64 ? 255 : 64;
+	gfx_fill(&s->common.texture,0,0,w,1,light,light,light);
+	gfx_fill(&s->common.texture,0,0,1,h,light,light,light);
+	gfx_fill(&s->common.texture,0,h-1,w,1,dark,dark,dark);
+	gfx_fill(&s->common.texture,w-1,0,1,h,dark,dark,dark);
+	if (p->checkbox_checked && !p->checkbox_button_mode) {
+		gfx_draw_line(&s->common.texture,w/4,h/2,w/2,3*h/4,0,0,0);
+		gfx_draw_line(&s->common.texture,w/2,3*h/4,3*w/4,h/4,0,0,0);
+	}
+}
