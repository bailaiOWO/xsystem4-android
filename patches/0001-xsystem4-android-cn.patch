+/*
+ * After a load the restored stack decides how many input waits are open. In
+ * Rance 10 only parts::detail::WaitForClick and CActivity@UpdateActivity open
+ * input: BeginInput before the wait loop, EndInput after it, each through a
+ * one-call wrapper. A frame stopped between the two holds one level.
+ */
+static int input_hll_delta(int lib, int fn)
+{
+	if (lib < 0 || lib >= ain->nr_libraries || strcmp(ain->libraries[lib].name, "PartsEngine"))
+		return 0;
+	if (fn < 0 || fn >= ain->libraries[lib].nr_functions)
+		return 0;
+	const char *name = ain->libraries[lib].functions[fn].name;
+	return !strcmp(name, "BeginInput") ? 1 : !strcmp(name, "EndInput") ? -1 : 0;
+}
+
+// +1/-1 for a function whose body is only a BeginInput/EndInput HLL call.
+static int input_wrapper_delta(int fno)
+{
+	if (fno < 0 || fno >= ain->nr_functions)
+		return 0;
+	size_t ip = ain->functions[fno].address;
+	int delta = 0;
+	for (int n = 0; n < 8 && ip + 2 <= ain->code_size; n++) {
+		enum opcode op = LittleEndian_getW(ain->code, ip);
+		if (op == CALLHLL)
+			delta += input_hll_delta(LittleEndian_getDW(ain->code, ip + 2),
+					LittleEndian_getDW(ain->code, ip + 6));
+		else if (op == RETURN)
+			return delta;
+		else if (op == CALLFUNC || op == CALLMETHOD || op == ENDFUNC)
+			return 0;
+		ip += instruction_width(op);
+	}
+	return 0;
+}
+
+static int input_frame_depth(int fno, size_t pos)
+{
+	if (fno < 0 || fno >= ain->nr_functions)
+		return 0;
+	size_t ip = ain->functions[fno].address;
+	if (pos < ip || pos > ain->code_size)
+		return 0;
+	int depth = 0, nested = 0;
+	while (ip < pos && ip + 2 <= ain->code_size) {
+		enum opcode op = LittleEndian_getW(ain->code, ip);
+		// Lambda bodies are emitted inline (FUNC..ENDFUNC, jumped over).
+		if (op == FUNC) {
+			nested++;
+		} else if (op == ENDFUNC) {
+			if (!nested)
+				break;
+			nested--;
+		} else if (!nested && op == CALLHLL) {
+			depth += input_hll_delta(LittleEndian_getDW(ain->code, ip + 2),
+					LittleEndian_getDW(ain->code, ip + 6));
+		} else if (!nested && op == CALLFUNC) {
+			depth += input_wrapper_delta(LittleEndian_getDW(ain->code, ip + 2));
+		}
+		ip += instruction_width(op);
+	}
+	return depth > 0 ? depth : 0;
+}
+
+unsigned vm_input_depth_from_stack(void)
+{
+	unsigned depth = 0;
+	for (int i = 0; i < call_stack_ptr; i++) {
+		// Where this frame stopped: the next frame's return address, or the
+		// current instruction for the innermost frame.
+		size_t pos = i + 1 < call_stack_ptr ? call_stack[i + 1].return_address : instr_ptr;
+		depth += input_frame_depth(call_stack[i].fno, pos);
+	}
+	return depth;
+}
+
+void vm_restore_input_depth(void)
+{
+	PE_ResetInputDepth(vm_input_depth_from_stack());
+}
