+/* System40 treats save names starting with "<memory>" as in-memory files that
+ * live only for the current session (Rance 9 keeps choice/recollection
+ * snapshots there). Back them with a hidden folder emptied on first use. */
+#define MEMORY_SAVE_PREFIX "<memory>"
+#define MEMORY_SAVE_DIR ".xsystem4-memory"
+
+static char *memory_save_dir(void)
+{
+	static bool cleared;
+	char *dir = xmalloc(strlen(config.save_dir) + sizeof(MEMORY_SAVE_DIR) + 1);
+	sprintf(dir, "%s/%s", config.save_dir, MEMORY_SAVE_DIR);
+	if (!cleared) {
+		cleared = true;
+		UDIR *d = opendir_utf8(dir);
+		if (d) {
+			char *name;
+			while ((name = readdir_utf8(d))) {
+				if (strcmp(name, ".") && strcmp(name, "..")) {
+					char *file = xmalloc(strlen(dir) + strlen(name) + 2);
+					sprintf(file, "%s/%s", dir, name);
