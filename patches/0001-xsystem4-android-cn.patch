@@ -0,0 +1,776 @@
+/*
+ * Anime4K post-processing for xsystem4 (Android port).
+ *
+ * Copyright (C) 2025 xsystem4-android contributors
+ * Anime4K shader files: Copyright (c) 2019-2021 bloc97 (MIT license)
+ *
+ * Parses mpv-style Anime4K shader files at runtime, wraps each pass into a
+ * standalone GLES3 program and runs the chain:
+ *   game texture (800x600) -> x2 CNN M (1600x1200) -> x2 CNN S (3200x2400)
+ *   -> bilinear downscale blit to the screen viewport.
+ */
+#include <SDL.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "system4.h"
+#include "gfx/gl.h"
+#include "anime4k.h"
+
+#ifdef __ANDROID__
+#include <jni.h>
+#endif
+
+// Desktop builds are also used for compatibility debugging. Keep that path
+// free of optional upscaling until explicitly selected.
+#ifdef __ANDROID__
+static atomic_int g_mode = 2; // 0=off, 1=x2, 2=x4
+#else
+static atomic_int g_mode = 0;
+#endif
+static bool g_init_done = false;
+static bool g_failed = false;
+static int g_failed_mode = -1, g_failed_w, g_failed_h;
+static bool g_use_float = false; // EXT_color_buffer_float available
+static int g_src_w = 0, g_src_h = 0;
+static int g_init_mode = -1;
+
+static const char *CHAIN_X2_FILES[] = {
+	"shaders/anime4k/Anime4K_Upscale_CNN_x2_M.glsl",
+};
+static const char *CHAIN_X4_FILES[] = {
+	"shaders/anime4k/Anime4K_Upscale_CNN_x2_M.glsl",
+	"shaders/anime4k/Anime4K_Upscale_CNN_x2_S.glsl",
+};
+static const char *CHAIN_CUNNY2_FILES[] = {
+	"shaders/cunny/CuNNy2-fast-NVL.glsl",
+};
+#define CHAIN_X2_LEN 1
+#define CHAIN_X4_LEN 2
+#define MAX_CHAIN_LEN 2
+
+#define A4K_MAX_PASSES 16
+#define A4K_MAX_BINDS 8
+#define A4K_NAME_LEN 48
+
+struct a4k_pass {
+	char *body;
+	char binds[A4K_MAX_BINDS][A4K_NAME_LEN];
+	int n_binds;
+	char save[A4K_NAME_LEN]; // "" if none
+	char width_expr[A4K_NAME_LEN];
+	char height_expr[A4K_NAME_LEN];
+	GLuint prog;
+	GLint loc_tex[A4K_MAX_BINDS];
+	GLint loc_size[A4K_MAX_BINDS];
+};
+
+struct a4k_rt {
+	char name[A4K_NAME_LEN]; // SAVE name, or "MAIN" for the output texture
+	GLuint tex;
+	GLuint fbo;
+	int w, h;
+};
+
+struct a4k_file {
+	struct a4k_pass passes[A4K_MAX_PASSES];
+	int n_passes;
+	struct a4k_rt rts[A4K_MAX_PASSES + 1]; // saved textures + main out
+	int n_rts;
+	struct a4k_rt main_out;
+};
+
+static struct a4k_file g_files[MAX_CHAIN_LEN];
+static GLuint g_copy_prog = 0;
+static GLint g_copy_loc_tex = -1;
+static GLuint g_vert_shader = 0;
+static GLuint g_vert_shader_flip = 0;
+
+/*
+ * Fullscreen triangle, plain NDC passthrough. Every intermediate pass uses
+ * this: all chain FBOs then share the source texture's orientation, which is
+ * what mpv hook semantics assume (N_pos of MAIN and of saved textures must
+ * agree). Flipping per-pass would give odd/even passes opposite orientation
+ * and stack an upside-down ghost in residual adds.
+ */
+static const char VERTEX_SHADER[] =
+	"#version 300 es\n"
+	"out vec2 vUV;\n"
+	"void main() {\n"
+	"    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+	"    vUV = p;\n"
+	"    gl_Position = vec4(p.x * 2.0 - 1.0, p.y * 2.0 - 1.0, 0.0, 1.0);\n"
+	"}\n";
+
+/* Same triangle, y-flipped: only for the final blit to the screen. */
+static const char VERTEX_SHADER_FLIPY[] =
+	"#version 300 es\n"
+	"out vec2 vUV;\n"
+	"void main() {\n"
+	"    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+	"    vUV = p;\n"
+	"    gl_Position = vec4(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);\n"
+	"}\n";
+
+static const char COPY_FRAG[] =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"uniform sampler2D uTex0;\n"
+	"in vec2 vUV;\n"
+	"out vec4 fragColor;\n"
+	"void main() { fragColor = texture(uTex0, vUV); }\n";
+
+static char *load_file_text(const char *path)
+{
+	size_t size = 0;
+	char *data = SDL_LoadFile(path, &size);
+	if (!data) {
+		WARNING("Anime4K: failed to load shader file %s", path);
+	}
+	return data;
+}
+
+static bool compile_shader(GLuint shader, const char *label)
+{
+	glCompileShader(shader);
+	GLint ok = 0;
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		GLint len = 0;
+		glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &len);
+		char *log = xmalloc(len + 1);
+		glGetShaderInfoLog(shader, len, NULL, log);
+		WARNING("Anime4K: shader compile failed (%s): %s", label, log);
+		free(log);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Parse one mpv-style shader file into g_files[idx].
+ *
+ * Uses manual line scanning rather than strtok so that CR characters from
+ * CRLF line endings never leak into header values (a trailing \r in a SAVE
+ * name would make every later BIND lookup fail).
+ */
+static bool parse_file(int idx, const char *path)
+{
+	struct a4k_file *f = &g_files[idx];
+	char *text = load_file_text(path);
+	if (!text)
+		return false;
+
+	struct a4k_pass *cur = NULL;
+	char *body = NULL;
+	size_t body_len = 0, body_cap = 0;
+	bool in_headers = false;
+
+	char *p = text;
+	while (*p) {
+		char *nl = strchr(p, '\n');
+		size_t ll = nl ? (size_t)(nl - p) : strlen(p);
+		// strip trailing \r
+		size_t sl = ll;
+		while (sl > 0 && p[sl - 1] == '\r')
+			sl--;
+
+		char line[1024];
+		if (sl >= sizeof(line))
+			sl = sizeof(line) - 1;
+		memcpy(line, p, sl);
+		line[sl] = '\0';
+
+		if (strncmp(line, "//!DESC", 7) == 0) {
+			// finish previous pass
+			if (cur && body) {
+				body[body_len] = '\0';
+				cur->body = strdup(body);
+			}
+			if (f->n_passes >= A4K_MAX_PASSES) {
+				WARNING("Anime4K: too many passes in %s", path);
+				free(text);
+				return false;
+			}
+			cur = &f->passes[f->n_passes++];
+			memset(cur, 0, sizeof(*cur));
+			cur->save[0] = '\0';
+			cur->width_expr[0] = '\0';
+			cur->height_expr[0] = '\0';
+			body_len = 0;
+			if (!body) {
+				body_cap = 1 << 16;
+				body = xmalloc(body_cap);
+			}
+			in_headers = true;
+		} else if (in_headers && strncmp(line, "//!", 3) == 0) {
+			if (cur && strncmp(line, "//!BIND ", 8) == 0) {
+				if (cur->n_binds < A4K_MAX_BINDS)
+					snprintf(cur->binds[cur->n_binds++], A4K_NAME_LEN, "%s", line + 8);
+			} else if (cur && strncmp(line, "//!SAVE ", 8) == 0) {
+				snprintf(cur->save, A4K_NAME_LEN, "%s", line + 8);
+			} else if (cur && strncmp(line, "//!WIDTH ", 9) == 0) {
+				snprintf(cur->width_expr, A4K_NAME_LEN, "%s", line + 9);
+			} else if (cur && strncmp(line, "//!HEIGHT ", 10) == 0) {
+				snprintf(cur->height_expr, A4K_NAME_LEN, "%s", line + 10);
+			}
+			// HOOK/COMPONENTS/WHEN: ignored
+		} else if (cur) {
+			in_headers = false;
+			if (body_len + ll + 2 > body_cap) {
+				body_cap *= 2;
+				body = xrealloc(body, body_cap);
+			}
+			memcpy(body + body_len, p, ll);
+			body_len += ll;
+			body[body_len++] = '\n';
+		}
+
+		if (!nl)
+			break;
+		p = nl + 1;
+	}
+	if (cur && body) {
+		body[body_len] = '\0';
+		cur->body = strdup(body);
+	}
+	free(body);
+	free(text);
+	return f->n_passes > 0;
+}
+
+/*
+ * Evaluate an mpv RPN size expression like "MAIN.w 2 *".
+ * main_w/main_h describe the file input; rts resolve previously saved names.
+ */
+static bool eval_rpn(const char *expr, int main_w, int main_h,
+                     struct a4k_rt *rts, int n_rts, float *out)
+{
+	float stack[16];
+	int sp = 0;
+	char buf[A4K_NAME_LEN];
+	snprintf(buf, A4K_NAME_LEN, "%s", expr);
+	char *saveptr = NULL;
+	for (char *tok = strtok_r(buf, " ", &saveptr); tok;
+	     tok = strtok_r(NULL, " ", &saveptr)) {
+		if (sp >= 16)
+			return false;
+		if (strcmp(tok, "MAIN.w") == 0) {
+			stack[sp++] = main_w;
+		} else if (strcmp(tok, "MAIN.h") == 0) {
+			stack[sp++] = main_h;
+		} else if (strstr(tok, ".w") || strstr(tok, ".h")) {
+			bool found = false;
+			for (int i = 0; i < n_rts; i++) {
+				size_t nlen = strlen(rts[i].name);
+				if (strncmp(tok, rts[i].name, nlen) == 0 && tok[nlen] == '.') {
+					stack[sp++] = tok[nlen + 1] == 'w' ? rts[i].w : rts[i].h;
+					found = true;
+					break;
+				}
+			}
+			if (!found)
+				return false;
+		} else if (tok[0] == '+' || tok[0] == '-' || tok[0] == '*' || tok[0] == '/') {
+			if (sp < 2)
+				return false;
+			float b = stack[--sp];
+			float a = stack[--sp];
+			switch (tok[0]) {
+			case '+': stack[sp++] = a + b; break;
+			case '-': stack[sp++] = a - b; break;
+			case '*': stack[sp++] = a * b; break;
+			case '/': stack[sp++] = b != 0.f ? a / b : 0.f; break;
+			}
+		} else {
+			char *end = NULL;
+			float v = strtof(tok, &end);
+			if (end == tok)
+				return false;
+			stack[sp++] = v;
+		}
+	}
+	if (sp != 1)
+		return false;
+	*out = stack[0];
+	return true;
+}
+
+/*
+ * Build the standalone fragment shader source for a pass.
+ */
+static char *build_frag_source(struct a4k_pass *p)
+{
+	// Header + per-bind uniforms (~100B each) + per-bind defines (~500B each)
+	// + body + main(). Give a generous margin; a negative remaining size
+	// would abort the process via FORTIFY.
+	size_t cap = 1024 + (size_t)p->n_binds * 1024 + strlen(p->body) + 256;
+	char *src = xmalloc(cap);
+	size_t off = 0;
+	off += snprintf(src + off, cap - off,
+		"#version 300 es\n"
+		"precision highp float;\n"
+		"precision highp int;\n");
+	for (int k = 0; k < p->n_binds; k++) {
+		off += snprintf(src + off, cap - off,
+			"uniform sampler2D uTex%d;\n"
+			"uniform vec2 uSize%d;\n", k, k);
+	}
+	off += snprintf(src + off, cap - off,
+		"in vec2 vUV;\n"
+		"out vec4 fragColor;\n");
+	for (int k = 0; k < p->n_binds; k++) {
+		// mpv hook semantics: N_pos/N_tex use NORMALIZED coordinates (0..1),
+		// N_texOff offsets in pixels, N_pt is the normalized pixel size.
+		off += snprintf(src + off, cap - off,
+			"#define %s_size uSize%d\n"
+			"#define %s_pt (1.0 / uSize%d)\n"
+			"#define %s_pos vUV\n"
+			"#define %s_tex(p_) texture(uTex%d, p_)\n"
+			"#define %s_texOff(o_) texture(uTex%d, vUV + (o_) * (1.0 / uSize%d))\n",
+			p->binds[k], k,
+			p->binds[k], k,
+			p->binds[k],
+			p->binds[k], k,
+			p->binds[k], k, k);
+	}
+	off += snprintf(src + off, cap - off, "%s\n", p->body);
+	off += snprintf(src + off, cap - off,
+		"void main() { fragColor = hook(); }\n");
+	return src;
+}
+
+static bool compile_pass(struct a4k_pass *p, const char *label)
+{
+	GLuint prog = glCreateProgram();
+	GLuint frag = glCreateShader(GL_FRAGMENT_SHADER);
+	char *src = build_frag_source(p);
+	const char *srcs[1] = { src };
+	glShaderSource(frag, 1, srcs, NULL);
+	free(src);
+	if (!compile_shader(frag, label)) {
+		glDeleteShader(frag);
+		glDeleteProgram(prog);
+		return false;
+	}
+	glAttachShader(prog, g_vert_shader);
+	glAttachShader(prog, frag);
+	glLinkProgram(prog);
+	glDeleteShader(frag);
+	GLint ok = 0;
+	glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		WARNING("Anime4K: program link failed (%s)", label);
+		glDeleteProgram(prog);
+		return false;
+	}
+	p->prog = prog;
+	for (int k = 0; k < p->n_binds; k++) {
+		char tu[16], su[16];
+		snprintf(tu, 16, "uTex%d", k);
+		snprintf(su, 16, "uSize%d", k);
+		p->loc_tex[k] = glGetUniformLocation(prog, tu);
+		p->loc_size[k] = glGetUniformLocation(prog, su);
+	}
+	return true;
+}
+
+static bool alloc_rt(struct a4k_rt *rt, const char *name, int w, int h)
+{
+	snprintf(rt->name, A4K_NAME_LEN, "%s", name);
+	rt->w = w;
+	rt->h = h;
+	glGenTextures(1, &rt->tex);
+	glBindTexture(GL_TEXTURE_2D, rt->tex);
+	// CNN feature maps carry signed pre-activation values; RGBA8 clamps
+	// negatives to 0 and kills the effect. Use half-float when the device
+	// supports rendering to it.
+	GLenum internal = g_use_float ? GL_RGBA16F : GL_RGBA;
+	GLenum type = g_use_float ? GL_HALF_FLOAT : GL_UNSIGNED_BYTE;
+	glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, GL_RGBA, type, NULL);
+	// LINEAR: matches mpv's default; also blends out any residual sampling
+	// seams between CNN passes.
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	glGenFramebuffers(1, &rt->fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, rt->fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, rt->tex, 0);
+	bool complete = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+	if (!complete)
+		WARNING("Anime4K: incomplete framebuffer for %s", name);
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	return complete;
+}
+
+static void free_rt(struct a4k_rt *rt)
+{
+	if (rt->tex)
+		glDeleteTextures(1, &rt->tex);
+	if (rt->fbo)
+		glDeleteFramebuffers(1, &rt->fbo);
+	memset(rt, 0, sizeof(*rt));
+}
+
+static struct a4k_rt *find_rt(struct a4k_file *f, const char *name)
+{
+	for (int i = 0; i < f->n_rts; i++) {
+		if (strcmp(f->rts[i].name, name) == 0)
+			return &f->rts[i];
+	}
+	return NULL;
+}
+
+static void free_file_state(struct a4k_file *f)
+{
+	for (int i = 0; i < f->n_passes; i++) {
+		if (f->passes[i].prog)
+			glDeleteProgram(f->passes[i].prog);
+		free(f->passes[i].body);
+	}
+	f->n_passes = 0;
+	for (int i = 0; i < f->n_rts; i++)
+		free_rt(&f->rts[i]);
+	f->n_rts = 0;
+	free_rt(&f->main_out);
+}
+
+static void release_chain(void)
+{
+	for (int i = 0; i < MAX_CHAIN_LEN; i++)
+		free_file_state(&g_files[i]);
+	if (g_copy_prog) glDeleteProgram(g_copy_prog);
+	if (g_vert_shader) glDeleteShader(g_vert_shader);
+	if (g_vert_shader_flip) glDeleteShader(g_vert_shader_flip);
+	g_copy_prog = g_vert_shader = g_vert_shader_flip = 0;
+	g_init_done = false;
+	g_init_mode = -1;
+}
+
+static bool init_chain(int src_w, int src_h, int mode)
+{
+	GLuint vert = glCreateShader(GL_VERTEX_SHADER);
+	const char *vsrc[1] = { VERTEX_SHADER };
+	glShaderSource(vert, 1, vsrc, NULL);
+	if (!compile_shader(vert, "vertex")) {
+		glDeleteShader(vert);
+		g_vert_shader = 0;
+		return false;
+	}
+	g_vert_shader = vert;
+
+	GLuint vert_f = glCreateShader(GL_VERTEX_SHADER);
+	const char *vsrc_f[1] = { VERTEX_SHADER_FLIPY };
+	glShaderSource(vert_f, 1, vsrc_f, NULL);
+	if (!compile_shader(vert_f, "vertex-flip")) {
+		glDeleteShader(vert_f);
+		g_vert_shader_flip = 0;
+		glDeleteShader(vert);
+		g_vert_shader = 0;
+		return false;
+	}
+	g_vert_shader_flip = vert_f;
+
+	GLuint cprog = glCreateProgram();
+	GLuint cfrag = glCreateShader(GL_FRAGMENT_SHADER);
+	const char *csrc[1] = { COPY_FRAG };
+	glShaderSource(cfrag, 1, csrc, NULL);
+	if (!compile_shader(cfrag, "copy")) {
+		glDeleteShader(cfrag);
+		glDeleteProgram(cprog);
+		glDeleteShader(vert);
+		g_vert_shader = 0;
+		glDeleteShader(vert_f);
+		g_vert_shader_flip = 0;
+		return false;
+	}
+	glAttachShader(cprog, vert_f);
+	glAttachShader(cprog, cfrag);
+	glLinkProgram(cprog);
+	glDeleteShader(cfrag);
+	GLint ok = 0;
+	glGetProgramiv(cprog, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		glDeleteProgram(cprog);
+		glDeleteShader(vert);
+		g_vert_shader = 0;
+		glDeleteShader(vert_f);
+		g_vert_shader_flip = 0;
+		return false;
+	}
+	g_copy_prog = cprog;
+	g_copy_loc_tex = glGetUniformLocation(cprog, "uTex0");
+
+	// Check for renderable half-float textures (needed for CNN feature maps).
+	const char *exts = (const char *)glGetString(GL_EXTENSIONS);
+	/* CuNNy2's upstream features use normalized RGBA8 + ReLU;
+	 * preserve that quantization, independently of Anime4K's signed maps. */
+	g_use_float = mode != 3 && exts && strstr(exts, "EXT_color_buffer_float");
+	NOTICE("Anime4K: float render targets %s", g_use_float ? "enabled" : "unavailable, falling back to RGBA8");
+
+	const char **chain_files;
+	int chain_len;
+	switch (mode) {
+	case 1:
+		chain_files = CHAIN_X2_FILES;
+		chain_len = CHAIN_X2_LEN;
+		break;
+	case 3:
+		chain_files = CHAIN_CUNNY2_FILES;
+		chain_len = CHAIN_X2_LEN;
+		break;
+	case 2:
+	default:
+		chain_files = CHAIN_X4_FILES;
+		chain_len = CHAIN_X4_LEN;
+		break;
+	}
+
+	for (int i = 0; i < chain_len; i++) {
+		struct a4k_file *f = &g_files[i];
+		if (!parse_file(i, chain_files[i]))
+			return false;
+		NOTICE("Anime4K: %s parsed %d passes", chain_files[i], f->n_passes);
+		for (int pi = 0; pi < f->n_passes; pi++) {
+			struct a4k_pass *p = &f->passes[pi];
+			if (p->n_binds > 0) {
+				char blist[256] = {0};
+				for (int b = 0; b < p->n_binds; b++) {
+					strcat(blist, p->binds[b]);
+					if (b + 1 < p->n_binds)
+						strcat(blist, ",");
+				}
+				NOTICE("Anime4K:   pass %d save=%s w=%s h=%s binds=[%s]",
+				       pi, p->save[0] ? p->save : "-",
+				       p->width_expr[0] ? p->width_expr : "-",
+				       p->height_expr[0] ? p->height_expr : "-", blist);
+			}
+		}
+
+		// Allocate SAVE textures (unique names), compile passes.
+		for (int pi = 0; pi < f->n_passes; pi++) {
+			struct a4k_pass *p = &f->passes[pi];
+			char label[128];
+			snprintf(label, 128, "%s pass %d", chain_files[i], pi);
+
+			// Validate binds are resolvable (MAIN or a previous SAVE).
+			for (int b = 0; b < p->n_binds; b++) {
+				if (strcmp(p->binds[b], "MAIN") != 0 &&
+				    !find_rt(f, p->binds[b])) {
+					WARNING("Anime4K: %s binds unknown texture %s",
+					        label, p->binds[b]);
+					return false;
+				}
+			}
+
+			// Target size for this pass.
+			float w = src_w, h = src_h;
+			if (p->width_expr[0] && !eval_rpn(p->width_expr, src_w, src_h, f->rts, f->n_rts, &w))
+				w = src_w;
+			if (p->height_expr[0] && !eval_rpn(p->height_expr, src_w, src_h, f->rts, f->n_rts, &h))
+				h = src_h;
+			int iw = w <= 0.f ? src_w : (int)(w + 0.5f);
+			int ih = h <= 0.f ? src_h : (int)(h + 0.5f);
+
+			if (p->save[0] && strcmp(p->save, "MAIN") != 0) {
+				struct a4k_rt *existing = find_rt(f, p->save);
+				if (existing) {
+					// Reused name (ping-pong): check size
+					if (existing->w != iw || existing->h != ih)
+						WARNING("Anime4K: texture %s resized %dx%d -> %dx%d",
+						        p->save, existing->w, existing->h, iw, ih);
+				} else {
+					if (f->n_rts >= A4K_MAX_PASSES + 1)
+						return false;
+					if (!alloc_rt(&f->rts[f->n_rts++], p->save, iw, ih))
+						return false;
+				}
+			}
+
+			if (!compile_pass(p, label))
+				return false;
+		}
+		// Output texture for passes that SAVE MAIN.
+		int out_w = src_w, out_h = src_h;
+		for (int pi = f->n_passes - 1; pi >= 0; pi--) {
+			if (strcmp(f->passes[pi].save, "MAIN") == 0) {
+				float w, h;
+				if (f->passes[pi].width_expr[0] &&
+				    eval_rpn(f->passes[pi].width_expr, src_w, src_h, f->rts, f->n_rts, &w))
+					out_w = (int)(w + 0.5f);
+				if (f->passes[pi].height_expr[0] &&
+				    eval_rpn(f->passes[pi].height_expr, src_w, src_h, f->rts, f->n_rts, &h))
+					out_h = (int)(h + 0.5f);
+				break;
+			}
+		}
+		char out_name[A4K_NAME_LEN];
+		snprintf(out_name, A4K_NAME_LEN, "MAIN_OUT_%d", i);
+		if (!alloc_rt(&f->main_out, out_name, out_w, out_h))
+			return false;
+		NOTICE("Anime4K: %s output %dx%d", chain_files[i], out_w, out_h);
+
+		// Next file's input size is this file's output size.
+		src_w = out_w;
+		src_h = out_h;
+	}
+
+	g_init_done = true;
+	g_init_mode = mode;
+	return true;
+}
+
+static GLuint run_file(struct a4k_file *f, GLuint src_tex, int src_w, int src_h)
+{
+	static int log_runs = 0;
+	for (int pi = 0; pi < f->n_passes; pi++) {
+		struct a4k_pass *p = &f->passes[pi];
+
+		GLuint target_fbo;
+		int target_w, target_h;
+		if (p->save[0] && strcmp(p->save, "MAIN") != 0) {
+			struct a4k_rt *rt = find_rt(f, p->save);
+			if (!rt)
+				return 0;
+			target_fbo = rt->fbo;
+			target_w = rt->w;
+			target_h = rt->h;
+		} else {
+			target_fbo = f->main_out.fbo;
+			target_w = f->main_out.w;
+			target_h = f->main_out.h;
+		}
+
+		glBindFramebuffer(GL_FRAMEBUFFER, target_fbo);
+		glViewport(0, 0, target_w, target_h);
+		glUseProgram(p->prog);
+		if (log_runs < 4)
+			NOTICE("Anime4K: run pass %d -> %s (%dx%d)", pi,
+			       p->save[0] ? p->save : "MAIN", target_w, target_h);
+		for (int k = 0; k < p->n_binds; k++) {
+			GLuint tex;
+			int tw, th;
+			if (strcmp(p->binds[k], "MAIN") == 0) {
+				tex = src_tex;
+				tw = src_w;
+				th = src_h;
+			} else {
+				struct a4k_rt *rt = find_rt(f, p->binds[k]);
+				if (!rt)
+					return 0;
+				tex = rt->tex;
+				tw = rt->w;
+				th = rt->h;
+			}
+			glActiveTexture(GL_TEXTURE0 + k);
+			glBindTexture(GL_TEXTURE_2D, tex);
+			if (p->loc_tex[k] >= 0)
+				glUniform1i(p->loc_tex[k], k);
+			if (p->loc_size[k] >= 0)
+				glUniform2f(p->loc_size[k], (float)tw, (float)th);
+		}
+		glDrawArrays(GL_TRIANGLES, 0, 3);
+	}
+	log_runs++;
+	return f->main_out.tex;
+}
+
+void anime4k_set_mode(int mode)
+{
+	atomic_store(&g_mode, mode >= 0 && mode <= 3 ? mode : 0);
+}
+
+int anime4k_get_mode(void)
+{
+	return atomic_load(&g_mode);
+}
+
+bool anime4k_enabled(void)
+{
+	return atomic_load(&g_mode) > 0;
+}
+
+static int chain_length(void)
+{
+	return g_init_mode == 2 ? CHAIN_X4_LEN : CHAIN_X2_LEN;
+}
+
+bool anime4k_render(GLuint src_tex, int w, int h,
+                    int vp_x, int vp_y, int vp_w, int vp_h)
+{
+	int cur_mode = atomic_load(&g_mode);
+	if (cur_mode == 0)
+		return false;
+	if (g_failed && cur_mode == g_failed_mode && w == g_failed_w && h == g_failed_h)
+		return false;
+	g_failed = false;
+	bool need_reinit = !g_init_done ||
+	                   w != g_src_w || h != g_src_h ||
+	                   cur_mode != g_init_mode;
+	if (need_reinit) {
+		release_chain();
+		if (!init_chain(w, h, cur_mode)) {
+			release_chain();
+			g_failed = true;
+			g_failed_mode = cur_mode; g_failed_w = w; g_failed_h = h;
+			WARNING("Anime4K: disabled (initialization failed)");
+			return false;
+		}
+	}
+	g_src_w = w;
+	g_src_h = h;
+
+	bool blend_was_on = glIsEnabled(GL_BLEND);
+	glDisable(GL_BLEND);
+
+	int chain_len = chain_length();
+	GLuint tex = src_tex;
+	int tw = w, th = h;
+	for (int i = 0; i < chain_len; i++) {
+		GLuint out = run_file(&g_files[i], tex, tw, th);
+		if (!out) {
+			if (blend_was_on)
+				glEnable(GL_BLEND);
+			return false;
+		}
+		tex = out;
+		tw = g_files[i].main_out.w;
+		th = g_files[i].main_out.h;
+	}
+
+	/* Do not infer GPU failure from image brightness. Scene changes and
+	 * fades are valid, and RGBA16F readback as GL_UNSIGNED_BYTE is not
+	 * portable on GLES. The old probe permanently disabled a healthy chain.
+	 * Validate shaders and framebuffers at initialization instead. */
+
+	// Final blit to the screen (letterbox viewport, bilinear sampling).
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	glViewport(vp_x, vp_y, vp_w, vp_h);
+	glUseProgram(g_copy_prog);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, tex);
+	if (g_copy_loc_tex >= 0)
+		glUniform1i(g_copy_loc_tex, 0);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	glUseProgram(0);
+	glActiveTexture(GL_TEXTURE0);
+	if (blend_was_on)
+		glEnable(GL_BLEND);
+	return true;
+}
+
+#ifdef __ANDROID__
+JNIEXPORT void JNICALL
+Java_io_github_kichikuou_xsystem4_XSystem4Activity_nativeSetAnime4kMode(
+	JNIEnv *env, jobject thiz, jint mode)
+{
+	(void)env;
+	(void)thiz;
+	anime4k_set_mode((int)mode);
+}
+#endif
