+	// Keep the current texture if loading or creating its replacement fails.
+	struct cg *cg = asset_cg_load_by_name(new_name->text, NULL);
+	if (!cg) return false;
+	Texture replacement = {0};
+	gfx_init_texture_with_cg(&replacement, cg);
+	cg_free(cg);
+	if (!replacement.handle) return false;
+	if (!f->proxy_names) {
+		f->proxy_names = xcalloc(f->nr_libraries, sizeof(*f->proxy_names));
+		f->original_textures = xcalloc(f->nr_libraries, sizeof(*f->original_textures));
+	}
+	if (f->proxy_names[i]) {
+		gfx_delete_texture(&f->textures[i]);
+		free_string(f->proxy_names[i]);
+	} else {
+		f->original_textures[i] = f->textures[i];
