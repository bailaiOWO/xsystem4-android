+/* Newer Flat files move CG libraries into named rectangles in TALT atlases. */
+static void parts_flat_import_atlases(struct flat *fl)
+{
+	for (unsigned i = 0; i < fl->nr_talt_entries; i++) {
+		struct talt_entry *atlas = &fl->talt_entries[i];
+		if (atlas->off > fl->data_size || atlas->size > fl->data_size - atlas->off) continue;
