+	if (src_i + count > sn)
+		count = sn - src_i;
+	if (dst_i + count > dn)
+		count = dn - dst_i;
+	if (count <= 0)
+		return 0;
+	memcpy((*dst)->values + dst_i, src->values + src_i, count * sizeof(union vm_value));
+	return count;
+}
