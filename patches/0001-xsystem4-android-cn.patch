+static bool glyph_style_equal(const struct text_style *a, const struct text_style *b)
+{
+	return a->face == b->face && a->size == b->size && a->bold_width == b->bold_width
+		&& a->weight == b->weight && a->edge_left == b->edge_left && a->edge_up == b->edge_up
+		&& a->edge_right == b->edge_right && a->edge_down == b->edge_down
+		&& !memcmp(&a->color, &b->color, sizeof(a->color))
+		&& !memcmp(&a->edge_color, &b->edge_color, sizeof(a->edge_color))
+		&& a->scale_x == b->scale_x && a->space_scale_x == b->space_scale_x
+		&& a->font_spacing == b->font_spacing;
+}
+
+static void glyph_cache_trim(size_t limit)
+{
+	while (glyph_cache_bytes > limit) {
+		struct parts_glyph_cache **oldest = NULL;
+		for (int i = 0; i < 256; i++)
+			for (struct parts_glyph_cache **p = &glyph_cache[i]; *p; p = &(*p)->next)
+				if (!(*p)->refs && (!oldest || (*p)->used < (*oldest)->used)) oldest = p;
+		if (!oldest) break;
+		struct parts_glyph_cache *g = *oldest; *oldest = g->next;
+		glyph_cache_bytes -= sizeof(*g) + (size_t)g->texture.w * g->texture.h * 4;
+		gfx_delete_texture(&g->texture); free(g);
+	}
+}
+
+void parts_text_cache_clear(void) { glyph_cache_trim(0); }
+
+static struct parts_glyph_cache *glyph_cache_get(struct text_style *style, const char *ch)
+{
+	unsigned hash = 0;
+	for (const unsigned char *p = (const unsigned char *)ch; *p; p++) hash = hash * 31 + *p;
+	hash %= 256;
+	for (struct parts_glyph_cache *g = glyph_cache[hash]; g; g = g->next) {
+		if (strcmp(g->ch, ch) || !glyph_style_equal(&g->style, style)) continue;
+		g->refs++; g->used = ++glyph_cache_clock; return g;
+	}
+	struct parts_glyph_cache *g = xcalloc(1, sizeof(*g));
+	g->style = *style; memcpy(g->ch, ch, strlen(ch) + 1);
+	int w = gfx_size_char(style, ch), h = text_style_height(style);
+	gfx_init_texture_rgba(&g->texture, w, h, (SDL_Color){0,0,0,0});
+	g->advance = ceilf(gfx_render_textf(&g->texture, 0, 0, ch, style, false));
+	g->refs = 1; g->used = ++glyph_cache_clock;
+	g->next = glyph_cache[hash]; glyph_cache[hash] = g;
+	glyph_cache_bytes += sizeof(*g) + (size_t)g->texture.w * g->texture.h * 4;
+	glyph_cache_trim(16u * 1024 * 1024);
+	return g;
+}
