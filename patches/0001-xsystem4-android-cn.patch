+/* These process-owned values carry the selected save slot across system.Reset.
+ * They deliberately survive module finalization and VM heap replacement. */
+static struct { struct string *key, *value; } *game_variables;
+static int nr_game_variables;
+static int SystemService_GameVariable_Index(struct string *key)
+{
+	for (int i = 0; i < nr_game_variables; i++)
+		if (!strcmp(game_variables[i].key->text, key->text)) return i;
+	return -1;
+}
+static bool SystemService_GameVariable_IsExist(struct string *key)
+{
+	return SystemService_GameVariable_Index(key) >= 0;
+}
+static void SystemService_GameVariable_Set(struct string *key, struct string *value)
+{
+	int index = SystemService_GameVariable_Index(key);
+	struct string *copy = string_ref(value);
+	if (index < 0) {
+		index = nr_game_variables++;
+		game_variables = xrealloc(game_variables, nr_game_variables * sizeof(*game_variables));
+		game_variables[index].key = string_ref(key);
+	} else free_string(game_variables[index].value);
+	game_variables[index].value = copy;
+}
+static struct string *SystemService_GameVariable_Get(struct string *key)
+{
+	int index = SystemService_GameVariable_Index(key);
+	return string_ref(index >= 0 ? game_variables[index].value : &EMPTY_STRING);
+}
+static int SystemService_GameVariable_NumofKey(void) { return nr_game_variables; }
+static struct string *SystemService_GameVariable_GetKey(int index)
+{
+	return string_ref(index >= 0 && index < nr_game_variables ? game_variables[index].key : &EMPTY_STRING);
+}
+static void SystemService_GameVariable_Erase(struct string *key)
+{
+	int index = SystemService_GameVariable_Index(key);
+	if (index < 0) return;
+	free_string(game_variables[index].key);
+	free_string(game_variables[index].value);
+	memmove(&game_variables[index], &game_variables[index+1],
+		(--nr_game_variables-index) * sizeof(*game_variables));
+}
