+static void pa_link_show_conditions(struct pa_activity *a, struct ex_tree *tree)
+{
+	int no=PA_GetActivityPartsNumber(a->name,tree->name);
+	struct string *hover=pa_string(tree,"光标选中表示連動");
+	struct string *check=pa_string(tree,"复选框表示連動");
+	if (no>=0 && hover->size) {
+		int target=PA_GetActivityPartsNumber(a->name,hover);
+		if (target>=0) PE_SetOnCursorShowLinkPartsNumber(no,target);
+	}
+	if (no>=0 && check->size) {
+		int target=PA_GetActivityPartsNumber(a->name,check);
+		struct parts *t=target>=0 ? parts_get(target) : NULL;
+		// Only checkboxes have a checked state; other targets impose nothing.
+		if (t && t->component_type_override==2) {
+			parts_get(no)->check_show_link=target;
+			parts_set_check_link_hidden(parts_get(no),!t->checkbox_checked);
+		}
+	}
+	struct ex_tree *children=pa_child(tree,"子パーツ");
+	if (children && !children->is_leaf)
+		for (unsigned i=0;i<children->nr_children;i++) pa_link_show_conditions(a,&children->children[i]);
+}
+static void pa_link_radio_groups(struct pa_activity *a, struct ex_tree *tree)
+{
+	struct ex_tree *info=pa_child(tree,"种类別情报");
+	if (pa_type(info,"ラジオ按钮ボックス")) {
+		int no=PA_GetActivityPartsNumber(a->name,tree->name);
+		struct ex_value *list=pa_value(info,"复选框リスト");
+		if (no>=0 && list && list->type==EX_LIST)
+			for (unsigned i=0;i<list->list->nr_items;i++) {
+				struct ex_value *name=ex_list_get(list->list,i);
+				if (name->type!=EX_STRING) continue;
+				int child=PA_GetActivityPartsNumber(a->name,name->s);
+				if (child>=0) PA_AddRadioButtonBoxChild(no,child);
+			}
+	}
+	struct ex_tree *children=pa_child(tree,"子パーツ");
+	if (children && !children->is_leaf)
+		for (unsigned i=0;i<children->nr_children;i++) pa_link_radio_groups(a,&children->children[i]);
+}
+static struct archive_data *pa_archive(struct string *filename)
+{
+	char *path = xmalloc(filename->size + 9);
+	snprintf(path, filename->size + 9, "%s.pactex", filename->text);
+	struct archive_data *data = asset_get_by_name(ASSET_PACT,path,NULL);
+	if (!data) data = asset_get_by_name(ASSET_PACT,filename->text,NULL);
+	free(path); return data;
+}
+static bool PA_IsExistActivityFile(struct string *filename)
+{
+	struct archive_data *data = pa_archive(filename);
+	if (!data) return false;
+	archive_free_data(data); return true;
+}
+static bool PA_ReadActivityFile(struct string *name, struct string *filename, bool edit)
+{
+	uint64_t started=SDL_GetPerformanceCounter();
+	uint32_t script_start = vm_time();
+	(void)edit;
+	struct archive_data *data = pa_archive(filename);
+	if (!data) { WARNING("Missing Activity file: %s",display_sjis0(filename->text)); return false; }
+	struct ex *layout = ex_read(data->data,data->size);
+	archive_free_data(data);
+	if (!layout) { WARNING("Corrupt Activity file: %s", display_sjis0(filename->text)); return false; }
+	struct ex_tree *root = NULL;
+	for (unsigned i = 0; i < layout->nr_blocks && !root; i++)
+		if (layout->blocks[i].val.type == EX_TREE) root = pa_child(layout->blocks[i].val.tree,"ルートパーツ");
+	if (!root) { WARNING("Activity file has no root parts: %s", display_sjis0(filename->text)); ex_free(layout); return false; }
+	struct pa_activity *a = pa_find(name);
+	if (a && a->count) { struct page *erased = NULL; PA_ReleaseActivity(name,&erased); if (erased) free_page(erased); a = NULL; }
+	if (!a) { PA_CreateActivity(name); a = pa_find(name); }
+	a->layout = layout; pa_load_part(a,root,-1,0);
+	for (unsigned i = 0; i < layout->nr_blocks; i++) {
+		struct ex_block *b = &layout->blocks[i];
+		if (b->val.type != EX_LIST || !pa_matches(b->name->text, "结束キー")) continue;
+		for (unsigned j = 0; j < b->val.list->nr_items; j++) {
+			struct ex_value *key = ex_list_get(b->val.list, j);
+			if (key->type == EX_INT) PA_SetActivityEndKey(name, key->i);
+		}
+	}
+	pa_link_radio_groups(a,root);
+	pa_link_show_conditions(a,root);
+	parts_profile_slow("activity",started,a->count);
+	NOTICE("Activity loaded: %s (%d parts)",display_sjis0(filename->text),a->count);
+	if (ain->version >= 11) vm_exclude_load_time((uint32_t)vm_time() - script_start);
+	return true;
+}
