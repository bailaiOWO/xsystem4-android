+static bool read_legacy_group_save_comment(struct string *key, struct string *filename, struct string **comment)
+{
+	int id, end = 0;
+	if (!game_rance10_cn || strcmp(key->text, "rance10")
+			|| sscanf(filename->text, "LocalSave%d.asd%n", &id, &end) != 1
+			|| filename->text[end] || id < 0) return false;
+	char *path = savedir_path(filename->text);
+	enum savefile_error error;
+	struct gsave *save = gsave_read(path, &error);
+	ustat st;
+	char date[32] = "";
+	if (!stat_utf8(path, &st)) {
+		struct tm *time = localtime(&st.st_mtime);
+		if (time) strftime(date, sizeof(date), "%Y/%m/%d %H:%M", time);
+	}
+	free(path);
+	if (!save) return false;
+	struct gsave_record *context = NULL;
+	for (int i = 0; i < save->nr_globals; i++) {
+		struct gsave_global *g = &save->globals[i];
+		if (!strcmp(g->name, "g_gameContext") && g->type == AIN_STRUCT
+				&& g->value >= 0 && g->value < save->nr_records) context = &save->records[g->value];
+	}
+	if (context) {
+		char text[128];
+		snprintf(text, sizeof(text), "%d|%d|%d|%d|0|%s|", id,
+			gsave_record_int(save, context, "m_chapter"),
+			gsave_record_int(save, context, "m_turn"),
+			gsave_record_int(save, context, "m_gamePhase"), date);
+		free_string(*comment); *comment = cstr_to_string(text);
+	}
+	gsave_free(save);
+	return context != NULL;
+}
