+/* Translated Pact files encode even Japanese property names in GBK. */
+static bool pa_matches(const char *encoded, const char *utf8)
+{
+	/* A layout queries the same property names thousands of times. Opening
+	 * iconv converters for every sibling comparison stalls large settings
+	 * pages. Keys are immutable and independent of the loaded game. */
+	static struct pa_key { char *utf8, *sjis, *gbk; } *keys;
+	static int count;
+	int i = 0;
+	for (; i < count; i++) if (!strcmp(keys[i].utf8, utf8)) break;
+	if (i == count) {
+		keys = xrealloc(keys, (count + 1) * sizeof(*keys));
+		keys[count++] = (struct pa_key){strdup(utf8), utf2sjis(utf8, 0), utf2gbk(utf8, 0)};
+	}
+	return !strcmp(encoded, keys[i].sjis) || !strcmp(encoded, keys[i].gbk);
+}
+static struct ex_tree *pa_child(struct ex_tree *tree, const char *utf8)
+{
+	if (!tree || tree->is_leaf) return NULL;
+	struct ex_tree *result = NULL;
+	for (unsigned i = 0; i < tree->nr_children; i++)
+		if (pa_matches(tree->children[i].name->text, utf8)) { result = &tree->children[i]; break; }
+	return result;
+}
+static struct ex_value *pa_value(struct ex_tree *tree, const char *key)
+{
+	struct ex_tree *child = pa_child(tree, key);
+	return child && child->is_leaf ? &child->leaf.value : NULL;
+}
+static double pa_number(struct ex_tree *tree, const char *key, int index, double fallback)
+{
+	struct ex_value *v = pa_value(tree, key);
+	if (index >= 0) v = v && v->type == EX_LIST ? ex_list_get(v->list, index) : NULL;
+	return !v ? fallback : v->type == EX_INT ? v->i : v->type == EX_FLOAT ? v->f : fallback;
+}
+static struct string *pa_string(struct ex_tree *tree, const char *key)
+{
+	struct ex_value *v = pa_value(tree, key);
+	return v && v->type == EX_STRING ? v->s : &EMPTY_STRING;
+}
+static bool pa_type(struct ex_tree *tree, const char *type)
+{
+	return pa_matches(pa_string(tree, "パーツ类型")->text, type);
+}
+
+static void pa_load_rectangle(int no, struct ex_tree *state, int index)
+{
+	const char *corners[] = {"左上", "右上", "左下", "右下"};
+	// Pact rectangle corners are pixel coordinates. Rectangle mode is not
+	// the component's ratio-coordinate flag: EnemyActionIconBase uses mode
+	// 1 with a 78x90 ClickArea. Scaling it by the canvas also inflates its
+	// parent's measured layout and shifts centered visuals off-screen.
+	int left = pa_number(state, corners[0], 0, 0);
+	int top = pa_number(state, corners[0], 1, 0);
+	int right = left, bottom = top;
+	for (int i = 1; i < 4; i++) {
+		int x = pa_number(state, corners[i], 0, 0);
+		int y = pa_number(state, corners[i], 1, 0);
+		if (x < left) left = x;
+		if (x > right) right = x;
+		if (y < top) top = y;
+		if (y > bottom) bottom = y;
+	}
+	// These parts provide bounds for layout/input without drawing a texture.
+	PE_SetPartsRectangleDetectionSize(no, right - left, bottom - top, index);
+}
