+static void PartsEngine_SetMessageWindowText(int no, struct string *text, int msg,
+		struct string *func, int ver, int step)
+{
+	struct parts *p = parts_get(no);
+	struct parts_message_window *m = parts_message_get(p);
+	int begin = text->size >= m->source->size &&
+		!memcmp(text->text,m->source->text,m->source->size) ? m->source->size : 0;
+	if (!begin) m->nr_read_spans=0;
+	if (text->size > begin && (msgskip_is_read(msg) || msgskip_is_adv_read(func,ver,step))) {
+		int fno = ain_get_function(ain,"message::detail::GetReadMessageTextColor");
+		if (fno >= 0 && ain->functions[fno].nr_args == 6
+				&& ain->functions[fno].return_type.data == AIN_VOID
+				&& ain->functions[fno].vars[0].type.data == AIN_REF_INT
+				&& ain->functions[fno].vars[2].type.data == AIN_REF_INT
+				&& ain->functions[fno].vars[4].type.data == AIN_REF_INT) {
+			// The script owns the configured read/back-scene palette. A value
+			// left at -1 means that recoloring is disabled in game settings.
+			struct page *rgb = alloc_page(ARRAY_PAGE,AIN_INT,3);
+			rgb->array.rank = 1; rgb->array.struct_type = -1;
+			int slot = heap_alloc_page(rgb);
+			// HLL arguments have been popped, but ffi.c still finalizes their
+			// stack cells after returning. Preserve them across the VM callback.
+			union vm_value saved_args[6];
+			int base = stack_ptr;
+			memcpy(saved_args,&stack[base],sizeof(saved_args));
+			for (int i=0;i<3;i++) { rgb->values[i].i=-1; stack_push(slot); stack_push(i); }
+			vm_call(fno,-1);
+			if (stack_ptr != base) VM_ERROR("Read-message color callback changed stack size");
+			memcpy(&stack[base],saved_args,sizeof(saved_args));
+			int r=rgb->values[0].i,g=rgb->values[1].i,b=rgb->values[2].i;
+			heap_unref(slot);
+			if (r>=0 && r<=255 && g>=0 && g<=255 && b>=0 && b<=255) {
+				if (!begin) m->nr_read_spans=0;
+				m->read_spans=xrealloc(m->read_spans,(m->nr_read_spans+1)*sizeof(*m->read_spans));
+				m->read_spans[m->nr_read_spans++]=(struct parts_read_span){begin,text->size,{r,g,b,255}};
+			}
+		}
+	}
+	// Reset before adding spans when the script replaces the current page.
+	if (!begin && m->source->size) { free_string(m->source); m->source=string_ref(&EMPTY_STRING); m->elapsed=0; }
+	PE_SetMessageWindowText(no,text,msg,func,ver,step);
+}
