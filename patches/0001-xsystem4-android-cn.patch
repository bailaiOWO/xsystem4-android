+static struct { struct string **titles; int count; } searches[6];
+
+static struct afa_listing { struct string **titles; int count; bool ready; } listings[6];
+
+static void afa_clear_listings(void)
+{
+	for (int t = 0; t < 6; t++) {
+		for (int i = 0; i < listings[t].count; i++) free_string(listings[t].titles[i]);
+		free(listings[t].titles);
+		listings[t].titles = NULL; listings[t].count = 0; listings[t].ready = false;
+	}
+}
+
+static int afa_search_titles(int type, struct string *name, int mode)
+{
+	if (type < 0 || type >= 6) return 0;
+	for (int i = 0; i < searches[type].count; i++) free_string(searches[type].titles[i]);
+	free(searches[type].titles); searches[type].titles = NULL; searches[type].count = 0;
+	const enum asset_type sounds[] = {ASSET_BGM, ASSET_SOUND, ASSET_VOICE};
+	int groups = type == 5 ? 3 : 1;
+	for (int i = 0; i < groups; i++) {
+		enum asset_type asset = type == 5 ? sounds[i] : get_asset_type(type);
+		int count;
+		struct string **titles = asset_search_titles(asset, name->text, mode, &count);
+		for (int j = 0; j < count; j++) {
+			bool duplicate = false;
+			for (int k = 0; groups > 1 && k < searches[type].count; k++)
+				if (!strcmp(searches[type].titles[k]->text, titles[j]->text)) { duplicate = true; break; }
+			if (duplicate) { free_string(titles[j]); continue; }
+			searches[type].titles = xrealloc(searches[type].titles,
+				(searches[type].count + 1) * sizeof(*titles));
+			searches[type].titles[searches[type].count++] = titles[j];
+		}
+		free(titles);
+	}
+	return searches[type].count;
+}
+/* Full listings reuse the search over an empty prefix, cached separately so
+ * they do not clobber an in-progress script search of the same type. */
+static int AFAFactory_GetCountOfData(int type)
+{
+	if (type < 0 || type >= 6) return 0;
+	if (!listings[type].ready) {
+		struct string **saved = searches[type].titles; int saved_count = searches[type].count;
+		searches[type].titles = NULL; searches[type].count = 0;
+		afa_search_titles(type, &EMPTY_STRING, 1);
+		listings[type].titles = searches[type].titles;
+		listings[type].count = searches[type].count;
+		listings[type].ready = true;
+		searches[type].titles = saved; searches[type].count = saved_count;
+	}
+	return listings[type].count;
+}
+static struct string *AFAFactory_GetTitleByIndex(int type, int index)
+{
+	if (index < 0 || index >= AFAFactory_GetCountOfData(type)) return string_ref(&EMPTY_STRING);
+	return string_ref(listings[type].titles[index]);
+}
+static int AFAFactory_SearchTitle(int type, struct string *name) { return afa_search_titles(type, name, 0); }
+static int AFAFactory_PrefixSearchTitle(int type, struct string *name) { return afa_search_titles(type, name, 1); }
+static int AFAFactory_SuffixSearchTitle(int type, struct string *name) { return afa_search_titles(type, name, 2); }
+static struct string *AFAFactory_GetSearchTitleByIndex(int type, int index)
+{
+	return type >= 0 && type < 6 && index >= 0 && index < searches[type].count
