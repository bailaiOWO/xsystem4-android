-    return (*(int*)a - *(int*)b);
+    int lhs = *(const int*)a, rhs = *(const int*)b;
+    return (lhs > rhs) - (lhs < rhs);
 }
 
 static int compare_string(const void *a, const void *b) {
@@ -199,7 +200,7 @@ static void read_register(unsigned handle, const char *filename)
