 FetchContent_MakeAvailable(cglm)
 
 add_library(ffi STATIC IMPORTED)
@@ -23,6 +31,58 @@ find_package(SDL2 REQUIRED)
 find_package(SndFile REQUIRED)
 find_package(ZLIB REQUIRED)
 
+# Movie playback backend.
+#
+# The bundled pl_mpeg decoder only handles MPEG-PS, but several AliceSoft games
+# ship their movies as ASF containers (WMV1/WMA2 - e.g. Rance Quest, Rance IX),
+# so an ffmpeg build plays them out of the box. tools/build_ffmpeg_android.sh
+# cross-compiles a minimal ffmpeg for Android; this looks for it in the usual
+# places and silently falls back to pl_mpeg when it is not there.
+option(USE_FFMPEG "Use ffmpeg for movie playback when available" ON)
+set(FFMPEG_ROOT "" CACHE PATH "Prefix of a prebuilt ffmpeg (containing lib/ and include/)")
+set(XSYS4_USE_FFMPEG OFF)
+set(XSYS4_FFMPEG_LIBS "")
+if (USE_FFMPEG)
+  get_filename_component(_xsys4_repo "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
+  # The Android toolchain provides CMAKE_ANDROID_ARCH_ABI; ANDROID_ABI is only
+  # set when the caller passes it explicitly.
+  set(_ffmpeg_abi "${ANDROID_ABI}")
+  if (NOT _ffmpeg_abi)
+    set(_ffmpeg_abi "${CMAKE_ANDROID_ARCH_ABI}")
+  endif()
+  set(_ffmpeg_candidates
+    "${FFMPEG_ROOT}"
+    "${_xsys4_repo}/ffmpeg/${_ffmpeg_abi}"
+    "${_xsys4_repo}/../android-build/deps/ffmpeg/${_ffmpeg_abi}")
+  foreach (_root ${_ffmpeg_candidates})
+    # Plain EXISTS checks: find_path/find_library would cache the negative
+    # result of an earlier configure run and never look again.
+    if (_root AND EXISTS "${_root}/lib/libavformat.a"
+        AND EXISTS "${_root}/lib/libavcodec.a"
+        AND EXISTS "${_root}/lib/libswscale.a"
+        AND EXISTS "${_root}/lib/libavutil.a"
+        AND EXISTS "${_root}/include/libavcodec/avcodec.h")
+      set(XSYS4_USE_FFMPEG ON)
+      set(XSYS4_FFMPEG_INCLUDE_DIR "${_root}/include")
+      # Static libraries must precede their dependencies on the link line.
+      set(XSYS4_FFMPEG_LIBS
+          "${_root}/lib/libavformat.a"
+          "${_root}/lib/libavcodec.a"
+          "${_root}/lib/libswscale.a")
+      if (EXISTS "${_root}/lib/libswresample.a")
+        list(APPEND XSYS4_FFMPEG_LIBS "${_root}/lib/libswresample.a")
+      endif()
+      list(APPEND XSYS4_FFMPEG_LIBS "${_root}/lib/libavutil.a")
+      message(STATUS "Movie backend: ffmpeg (${_root})")
+      break()
+    endif()
+  endforeach()
+  if (NOT XSYS4_USE_FFMPEG)
+    message(STATUS "Movie backend: pl_mpeg (no ffmpeg under ${_ffmpeg_candidates}; "
+                   "run tools/build_ffmpeg_android.sh to enable ASF/WMV movies)")
+  endif()
+endif()
+
 add_subdirectory(subprojects/libsys4)
 
 add_library(xsystem4 SHARED)
@@ -43,12 +103,16 @@ configure_file(src/version.h.in version.h)
