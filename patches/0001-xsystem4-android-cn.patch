+/* Only called on a fatal error, never from the frame loop or trace logger.
+ * Keep diagnostics beside the emulator's data, outside game save slots. */
+void vm_write_error_report(const char *message)
+{
+	static bool writing;
+	if (writing || !config.home_dir || !*config.home_dir)
+		return;
+	writing = true;
+	const char *filename = "/xsystem4-last-error.txt";
+	size_t size = strlen(config.home_dir) + strlen(filename) + 1;
+	char *path = malloc(size);
+	if (!path) {
+		writing = false;
+		return;
+	}
+	snprintf(path, size, "%s%s", config.home_dir, filename);
+	FILE *out = file_open_utf8(path, "wb");
+	free(path);
+	if (!out) {
+		writing = false;
+		return;
+	}
+	fprintf(out, "xsystem4 error report\nunix_time=%lld\n%s\n",
+		(long long)time(NULL), message ? message : "(no message)");
+	if (ain) {
+		fprintf(out, "AIN version=%d ip=%zu stack=%d frames=%d\n",
+			ain->version, instr_ptr, stack_ptr, call_stack_ptr);
+		int frames = call_stack_ptr;
+		if (frames > (int)(sizeof(call_stack) / sizeof(*call_stack)))
+			frames = sizeof(call_stack) / sizeof(*call_stack);
+		for (int i = frames - 1; i >= 0; i--) {
+			int fno = call_stack[i].fno;
+			const char *name = ain->functions && fno >= 0 && fno < ain->nr_functions
+				? ain->functions[fno].name : "invalid";
+			char *utf8 = sjis2utf(name ? name : "invalid", 0);
+			fprintf(out, "VMFRAME %d fno=%d name=%s this=%d local=%d from=%u\n",
+				i, fno, utf8 ? utf8 : "invalid", call_stack[i].struct_page,
+				call_stack[i].page_slot, call_stack[i].call_address);
+			free(utf8);
+		}
+		int values = stack_ptr;
+		if (values > (int)stack_size) values = stack_size;
+		for (int i = values - 1; stack && i >= 0 && i >= values - 32; i--)
+			fprintf(out, "VMSTACK %d=%d\n", i, stack[i].i);
+	}
+	fclose(out);
+	writing = false;
+}
