+		calls++; draws+=rendered; slowest=max(slowest,end-begin);
+		event_ms+=events_done-begin; render_ms+=render_done-events_done; swap_ms+=end-render_done;
+		if (end-last_report>=2000) {
+			extern unsigned r10_back_scene_saves; extern double r10_back_scene_ms;
+			NOTICE("R10FRAME span=%u updates=%u draws=%u events=%u render=%u present=%u slowest=%u pages=%u page_save=%.0f",
+				end-last_report,calls,draws,event_ms,render_ms,swap_ms,slowest,
+				r10_back_scene_saves,r10_back_scene_ms);
+			r10_back_scene_saves=0; r10_back_scene_ms=0;
+			last_report=end; calls=draws=slowest=event_ms=render_ms=swap_ms=0;
+		}
+	}
+	fp_frame_end(events_done-begin, render_done-events_done, sact_profile_ticks()-render_done);
 	return 1;
 }
 
