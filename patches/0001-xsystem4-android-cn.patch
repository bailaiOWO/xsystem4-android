   src/hll/Math.c
+  src/hll/NewerLibs.c
   src/hll/MapLoader.c
   src/hll/MenuMsg.c
   src/hll/MonsterInfo.c
@@ -227,8 +296,20 @@ target_sources(xsystem4 PRIVATE
   )
 
 target_link_libraries(xsystem4 PRIVATE
+  ${XSYS4_FFMPEG_LIBS}
   m ZLIB::ZLIB SDL2::SDL2 Freetype::Freetype ffi GLESv3 cglm SndFile::sndfile sys4)
 
+if (XSYS4_USE_FFMPEG)
+  target_sources(xsystem4 PRIVATE src/movie_ffmpeg.c)
+  target_include_directories(xsystem4 PRIVATE ${XSYS4_FFMPEG_INCLUDE_DIR})
+  # Keep the static ffmpeg symbols local: the libraries are not necessarily
+  # built with -fPIC, and exporting them would need dynamic relocations the
+  # linker cannot emit (R_AARCH64_ADR_PREL_PG_HI21 ... recompile with -fPIC).
+  target_link_options(xsystem4 PRIVATE "-Wl,--exclude-libs,ALL")
+else()
+  target_sources(xsystem4 PRIVATE src/movie_plmpeg.c)
+endif()
+
 target_compile_options(xsystem4 PRIVATE -Wno-unused-parameter)
 
 install(TARGETS xsystem4)
