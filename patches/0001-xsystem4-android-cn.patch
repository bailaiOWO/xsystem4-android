+static bool PA_ReleaseActivity(struct string *name, struct page **erased)
+{
+	struct pa_activity *a = pa_find(name);
+	if (!a) return false;
+	union vm_value count = {.i = a->count};
+	struct page *list = alloc_array(1, &count, AIN_ARRAY_INT, -1, false);
+	for (int i = a->count - 1; i >= 0; i--) {
+		list->values[i].i = PE_GetDelegateIndex(a->parts[i].number);
+		PE_ReleaseParts(a->parts[i].number); free_string(a->parts[i].name);
+	}
+	if (*erased) { delete_page_vars(*erased); free_page(*erased); }
+	*erased = list;
+	free(a->parts); free(a->end_keys); if (a->layout) ex_free(a->layout); free_string(a->name);
+	memset(a, 0, sizeof(*a));
+	return true;
