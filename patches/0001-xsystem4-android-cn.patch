diff --git a/src/hll/regex.inc b/src/hll/regex.inc
new file mode 100644
index 0000000..7d64a80
--- /dev/null
+++ b/src/hll/regex.inc
@@ -0,0 +1,441 @@
+/* Character-level regular expressions for String.ReplaceRegex.
+ *
+ * Rance 10 strips colour tags from battle-log lines with `\{.+?\}` and
+ * substitutes a hero name for `＜艾尔..＞`. Script strings are GBK/SJIS, so
+ * `.` and every literal must match whole double-byte characters, never a lead
+ * or trail byte on its own.
+ *
+ * Supported: literals, `.`, `\` escapes (\d \w \s \D \W \S and escaped
+ * metacharacters), classes `[...]` with ranges and negation, groups `(...)`
+ * and `(?:...)`, alternation `|`, quantifiers `* + ? {n} {n,} {n,m}` with lazy
+ * `?` forms, and anchors `^ $`. Matching is backtracking.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <stdlib.h>
+
+enum rx_kind { RX_CHAR, RX_ANY, RX_CLASS, RX_GROUP, RX_BOL, RX_EOL };
+
+struct rx_range { int lo, hi; };
+
+struct rx_seq;
+
+struct rx_node {
+	enum rx_kind kind;
+	int ch;                         // RX_CHAR
+	struct rx_range *ranges;        // RX_CLASS
+	int nr_ranges;
+	bool negate;
+	struct rx_seq *alts;            // RX_GROUP alternatives
+	int nr_alts;
+	int min, max;                   // max < 0: unbounded
+	bool lazy;
+};
+
+struct rx_seq {
+	struct rx_node *nodes;
+	int nr_nodes;
+};
+
+struct rx_text {
+	const int *ch;   // decoded characters
+	int len;
+};
+
+/* Decode one character: double-byte when the lead byte allows it. */
+static int rx_decode(const char *s, int *len)
+{
+	const uint8_t *u = (const uint8_t *)s;
+	if (u[0] && SJIS_2BYTE(u[0]) && u[1]) {
+		*len = 2;
+		return (u[0] << 8) | u[1];
+	}
+	*len = 1;
+	return u[0];
+}
+
+static int *rx_decode_all(const char *s, int size, int *count, int **offsets)
+{
+	int *out = xmalloc(sizeof(int) * (size + 1));
+	int *off = xmalloc(sizeof(int) * (size + 2));
+	int n = 0, i = 0;
+	while (i < size) {
+		int len;
+		off[n] = i;
+		out[n++] = rx_decode(s + i, &len);
+		i += len > size - i ? size - i : len;
+	}
+	off[n] = size;
+	*count = n;
+	*offsets = off;
+	return out;
+}
+
+struct rx_parser {
+	const int *p;
+	int len, pos;
+	bool error;
+};
+
+static bool rx_parse_alts(struct rx_parser *ps, struct rx_seq **alts, int *nr_alts);
+
+static void rx_add_range(struct rx_node *n, int lo, int hi)
+{
+	n->ranges = xrealloc(n->ranges, sizeof(*n->ranges) * (n->nr_ranges + 1));
+	n->ranges[n->nr_ranges++] = (struct rx_range){ lo, hi };
+}
+
+/* \d \w \s and their negations, as class ranges. */
+static bool rx_class_escape(struct rx_node *n, int c)
+{
+	switch (c) {
+	case 'd': rx_add_range(n, '0', '9'); return true;
+	case 'w': rx_add_range(n, '0', '9'); rx_add_range(n, 'A', 'Z');
+		  rx_add_range(n, 'a', 'z'); rx_add_range(n, '_', '_'); return true;
+	case 's': rx_add_range(n, ' ', ' '); rx_add_range(n, '\t', '\r'); return true;
+	}
+	return false;
+}
+
+static int rx_escape_char(int c)
+{
+	switch (c) {
+	case 'n': return '\n';
+	case 't': return '\t';
+	case 'r': return '\r';
+	}
+	return c;
+}
+
+static bool rx_parse_atom(struct rx_parser *ps, struct rx_node *n)
+{
+	memset(n, 0, sizeof(*n));
+	n->min = n->max = 1;
+	int c = ps->p[ps->pos++];
+	switch (c) {
+	case '.': n->kind = RX_ANY; return true;
+	case '^': n->kind = RX_BOL; return true;
+	case '$': n->kind = RX_EOL; return true;
+	case '(': {
+		n->kind = RX_GROUP;
+		if (ps->pos + 1 < ps->len && ps->p[ps->pos] == '?' && ps->p[ps->pos + 1] == ':')
+			ps->pos += 2;
+		if (!rx_parse_alts(ps, &n->alts, &n->nr_alts))
+			return false;
+		if (ps->pos >= ps->len || ps->p[ps->pos] != ')')
+			return false;
+		ps->pos++;
+		return true;
+	}
+	case '[': {
+		n->kind = RX_CLASS;
+		if (ps->pos < ps->len && ps->p[ps->pos] == '^') {
+			n->negate = true;
+			ps->pos++;
+		}
+		bool first = true;
+		while (ps->pos < ps->len && (ps->p[ps->pos] != ']' || first)) {
+			first = false;
+			int lo = ps->p[ps->pos++];
+			if (lo == '\\' && ps->pos < ps->len) {
+				int e = ps->p[ps->pos++];
+				if (rx_class_escape(n, e))
+					continue;
+				lo = rx_escape_char(e);
+			}
+			int hi = lo;
+			if (ps->pos + 1 < ps->len && ps->p[ps->pos] == '-' && ps->p[ps->pos + 1] != ']') {
+				ps->pos++;
+				hi = ps->p[ps->pos++];
+				if (hi == '\\' && ps->pos < ps->len)
+					hi = rx_escape_char(ps->p[ps->pos++]);
+			}
+			rx_add_range(n, lo, hi);
+		}
+		if (ps->pos >= ps->len)
+			return false;
+		ps->pos++;  // ']'
+		return true;
+	}
+	case '\\':
+		if (ps->pos >= ps->len)
+			return false;
+		c = ps->p[ps->pos++];
+		if (c == 'D' || c == 'W' || c == 'S') {
+			n->kind = RX_CLASS;
+			n->negate = true;
+			return rx_class_escape(n, c - 'A' + 'a');
+		}
+		if (rx_class_escape(n, c)) {
+			n->kind = RX_CLASS;
+			return true;
+		}
+		n->kind = RX_CHAR;
+		n->ch = rx_escape_char(c);
+		return true;
+	case ')': case '|': case '*': case '+': case '?':
+		return false;
+	}
+	n->kind = RX_CHAR;
+	n->ch = c;
+	return true;
+}
+
+static bool rx_parse_number(struct rx_parser *ps, int *out)
+{
+	int start = ps->pos, v = 0;
+	while (ps->pos < ps->len && ps->p[ps->pos] >= '0' && ps->p[ps->pos] <= '9')
+		v = v * 10 + ps->p[ps->pos++] - '0';
+	*out = v;
+	return ps->pos > start;
+}
+
+static void rx_parse_quantifier(struct rx_parser *ps, struct rx_node *n)
+{
+	if (ps->pos >= ps->len)
+		return;
+	int c = ps->p[ps->pos];
+	if (c == '*') { n->min = 0; n->max = -1; ps->pos++; }
+	else if (c == '+') { n->min = 1; n->max = -1; ps->pos++; }
+	else if (c == '?') { n->min = 0; n->max = 1; ps->pos++; }
+	else if (c == '{') {
+		int save = ps->pos, lo, hi;
+		ps->pos++;
+		if (!rx_parse_number(ps, &lo)) { ps->pos = save; return; }
+		hi = lo;
+		if (ps->pos < ps->len && ps->p[ps->pos] == ',') {
+			ps->pos++;
+			if (!rx_parse_number(ps, &hi))
+				hi = -1;
+		}
+		if (ps->pos >= ps->len || ps->p[ps->pos] != '}') { ps->pos = save; return; }
+		ps->pos++;
+		n->min = lo;
+		n->max = hi;
+	} else {
+		return;
+	}
+	if (ps->pos < ps->len && ps->p[ps->pos] == '?') {
+		n->lazy = true;
+		ps->pos++;
+	}
+}
+
+static bool rx_parse_seq(struct rx_parser *ps, struct rx_seq *seq)
+{
+	seq->nodes = NULL;
+	seq->nr_nodes = 0;
+	while (ps->pos < ps->len && ps->p[ps->pos] != '|' && ps->p[ps->pos] != ')') {
+		struct rx_node n;
+		if (!rx_parse_atom(ps, &n))
+			return false;
+		rx_parse_quantifier(ps, &n);
+		seq->nodes = xrealloc(seq->nodes, sizeof(*seq->nodes) * (seq->nr_nodes + 1));
+		seq->nodes[seq->nr_nodes++] = n;
+	}
+	return true;
+}
+
+static bool rx_parse_alts(struct rx_parser *ps, struct rx_seq **alts, int *nr_alts)
+{
+	*alts = NULL;
+	*nr_alts = 0;
+	do {
+		*alts = xrealloc(*alts, sizeof(**alts) * (*nr_alts + 1));
+		if (!rx_parse_seq(ps, &(*alts)[(*nr_alts)++]))
+			return false;
+	} while (ps->pos < ps->len && ps->p[ps->pos] == '|' && ++ps->pos);
+	return true;
+}
+
+static void rx_free_seq(struct rx_seq *seq);
+static void rx_free_node(struct rx_node *n)
+{
+	free(n->ranges);
+	for (int i = 0; i < n->nr_alts; i++)
+		rx_free_seq(&n->alts[i]);
+	free(n->alts);
+}
+static void rx_free_seq(struct rx_seq *seq)
+{
+	for (int i = 0; i < seq->nr_nodes; i++)
+		rx_free_node(&seq->nodes[i]);
+	free(seq->nodes);
+}
+
+/* Continuation-passing backtracking matcher. */
+struct rx_cont {
+	int (*fn)(const struct rx_cont *k, const struct rx_text *t, int pos);
+	const struct rx_seq *seq;
+	int idx;
+	const struct rx_node *node;
+	int count;
+	int start;  // position where the current repetition began (empty-loop guard)
+	const struct rx_cont *next;
+};
+
+static int rx_steps;
+#define RX_STEP_LIMIT 2000000
+
+static int rx_run(const struct rx_cont *k, const struct rx_text *t, int pos)
+{
+	if (++rx_steps > RX_STEP_LIMIT)
+		return -1;
+	return k ? k->fn(k, t, pos) : pos;
+}
+
+static int rx_seq_cont(const struct rx_cont *k, const struct rx_text *t, int pos);
+
+static bool rx_class_has(const struct rx_node *n, int c)
+{
+	bool in = false;
+	for (int i = 0; i < n->nr_ranges && !in; i++)
+		in = c >= n->ranges[i].lo && c <= n->ranges[i].hi;
+	return in != n->negate;
+}
+
+/* Match exactly one occurrence of `n` at pos, then continue with k. */
+static int rx_one(const struct rx_node *n, const struct rx_text *t, int pos, const struct rx_cont *k)
+{
+	switch (n->kind) {
+	case RX_CHAR:
+		return pos < t->len && t->ch[pos] == n->ch ? rx_run(k, t, pos + 1) : -1;
+	case RX_ANY:
+		return pos < t->len && t->ch[pos] != '\n' ? rx_run(k, t, pos + 1) : -1;
+	case RX_CLASS:
+		return pos < t->len && rx_class_has(n, t->ch[pos]) ? rx_run(k, t, pos + 1) : -1;
+	case RX_BOL:
+		return pos == 0 ? rx_run(k, t, pos) : -1;
+	case RX_EOL:
+		return pos == t->len ? rx_run(k, t, pos) : -1;
+	case RX_GROUP:
+		for (int i = 0; i < n->nr_alts; i++) {
+			struct rx_cont c = { rx_seq_cont, &n->alts[i], 0, NULL, 0, 0, k };
+			int r = rx_run(&c, t, pos);
+			if (r >= 0)
+				return r;
+		}
+		return -1;
+	}
+	return -1;
+}
+
+static int rx_rep(const struct rx_node *n, int count, const struct rx_text *t, int pos,
+		const struct rx_cont *next);
+
+static int rx_rep_cont(const struct rx_cont *k, const struct rx_text *t, int pos)
+{
+	// An optional iteration that consumed nothing cannot make progress: stop
+	// looping. Required iterations may be empty (anchors, `(a*){2}`).
+	if (pos == k->start && k->count > k->node->min)
+		return -1;
+	return rx_rep(k->node, k->count, t, pos, k->next);
+}
+
+static int rx_rep(const struct rx_node *n, int count, const struct rx_text *t, int pos,
+		const struct rx_cont *next)
+{
+	bool more = n->max < 0 || count < n->max;
+	struct rx_cont again = { rx_rep_cont, NULL, 0, n, count + 1, pos, next };
+	if (count < n->min)
+		return rx_one(n, t, pos, &again);
+	if (n->lazy) {
+		int r = rx_run(next, t, pos);
+		if (r >= 0 || !more)
+			return r;
+		return rx_one(n, t, pos, &again);
+	}
+	if (more) {
+		int r = rx_one(n, t, pos, &again);
+		if (r >= 0)
+			return r;
+	}
+	return rx_run(next, t, pos);
+}
+
+static int rx_seq_cont(const struct rx_cont *k, const struct rx_text *t, int pos)
+{
+	if (k->idx >= k->seq->nr_nodes)
+		return rx_run(k->next, t, pos);
+	struct rx_cont rest = { rx_seq_cont, k->seq, k->idx + 1, NULL, 0, 0, k->next };
+	return rx_rep(&k->seq->nodes[k->idx], 0, t, pos, &rest);
+}
+
+/* Compile `pattern`; NULL on a syntax error. */
+static struct rx_node *rx_compile(const struct string *pattern)
+{
+	int count, *offsets;
+	int *p = rx_decode_all(pattern->text, pattern->size, &count, &offsets);
+	free(offsets);
+	struct rx_parser ps = { p, count, 0, false };
+	struct rx_node *root = xcalloc(1, sizeof(*root));
+	root->kind = RX_GROUP;
+	root->min = root->max = 1;
+	bool ok = rx_parse_alts(&ps, &root->alts, &root->nr_alts) && ps.pos == count;
+	free(p);
+	if (!ok) {
+		rx_free_node(root);
+		free(root);
+		return NULL;
+	}
+	return root;
+}
+
+static void rx_release(struct rx_node *root)
+{
+	if (!root)
+		return;
+	rx_free_node(root);
+	free(root);
+}
+
+/* Leftmost match at or after `from` (in characters); end in *end. */
+static int rx_search(const struct rx_node *root, const struct rx_text *t, int from, int *end)
+{
+	for (int start = from; start <= t->len; start++) {
+		rx_steps = 0;
+		int r = rx_one(root, t, start, NULL);
+		if (r >= 0) {
+			*end = r;
+			return start;
+		}
+		if (rx_steps > RX_STEP_LIMIT)
+			return -1;
+	}
+	return -1;
+}
+
+/* Replace every non-overlapping match; the replacement is literal. */
+static struct string *rx_replace_all(const struct string *subject, const struct string *pattern,
+		const struct string *replacement, bool *valid)
+{
+	struct rx_node *root = rx_compile(pattern);
+	*valid = root != NULL;
+	if (!root)
+		return string_dup(subject);
+	int count, *offsets;
+	int *chars = rx_decode_all(subject->text, subject->size, &count, &offsets);
+	struct rx_text t = { chars, count };
+	struct string *out = string_ref(&EMPTY_STRING);
+	int pos = 0, copied = 0;
+	while (pos <= count) {
+		int end, start = rx_search(root, &t, pos, &end);
+		if (start < 0)
+			break;
+		string_append_cstr(&out, subject->text + offsets[copied], offsets[start] - offsets[copied]);
+		string_append(&out, replacement);
+		copied = end;
+		pos = end > start ? end : end + 1;
+		if (end == start && start < count) {
+			// Keep the character an empty match stood on.
+			string_append_cstr(&out, subject->text + offsets[start], offsets[start + 1] - offsets[start]);
+			copied = start + 1;
+		}
+	}
+	if (copied < count)
+		string_append_cstr(&out, subject->text + offsets[copied], subject->size - offsets[copied]);
+	free(chars);
+	free(offsets);
+	rx_release(root);
+	return out;
+}
