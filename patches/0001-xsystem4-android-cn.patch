+/* %D emits SJIS digits, while CN EX node/row keys are GBK. Keep exact match
+ * authoritative and only translate SJIS numeric pairs on a miss. */
+static char *ex_key_sjis_digits_to_gbk(const char *src)
+{
+	if (ain->version < 11)
+		return NULL;
+	char *path = xstrdup(src);
+	bool changed = false;
+	for (size_t i = 0; path[i];) {
+		unsigned char c = path[i], next = path[i+1];
+		if (c == 0x82 && next >= 0x4f && next <= 0x58) {
+			path[i] = 0xa3;
+			path[i+1] = 0xb0 + next - 0x4f;
+			changed = true;
+			i += 2;
+		} else if (c >= 0x81 && c <= 0xfe && next >= 0x40 && next != 0x7f) {
+			i += 2;
+		} else {
+			i++;
+		}
+	}
+	if (!changed) {
+		free(path);
+		return NULL;
+	}
+	return path;
+}
