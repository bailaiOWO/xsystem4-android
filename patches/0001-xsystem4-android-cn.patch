+bool write_group_save_comment(struct string *key, struct string *filename, struct string *comment)
+{
+	char *save = savedir_path(filename->text);
+	bool exists = file_exists(save);
+	free(save);
+	if (!exists) return false;
+	char *path = group_comment_path(filename);
+	char *tmp_path;
+	FILE *fp = atomic_file_open(path, &tmp_path);
+	if (!fp) {
+		free(path);
+		return false;
+	}
+	uint32_t header[] = {0x31434758, key->size, comment->size}; // XGC1
+	bool ok = fwrite(header, sizeof(header), 1, fp) == 1
+		&& fwrite(key->text, 1, key->size, fp) == key->size
+		&& fwrite(comment->text, 1, comment->size, fp) == comment->size;
+	ok = atomic_file_commit(fp, tmp_path, path, ok);
+	free(path);
+	return ok;
+}
