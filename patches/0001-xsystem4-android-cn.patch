+/*
+ * Anime4K post-processing for xsystem4 (Android port).
+ *
+ * Renders the game through the Anime4K CNN shader chain (bloc97, MIT license)
+ * before presenting to the screen. The mpv-style shader files are parsed at
+ * runtime and wrapped into standalone GLES3 programs.
+ */
+#ifndef ANIME4K_H
+#define ANIME4K_H
+
+#include <SDL.h>
+#include <stdbool.h>
+#include "gfx/gl.h"
+
+void anime4k_set_mode(int mode); /* 0=off, 1=x2 (M only), 2=x4 (M+S), 3=CuNNy2 fast-NVL x2 */
+int anime4k_get_mode(void);
+bool anime4k_enabled(void);
+
+/*
+ * Renders src_tex (w x h) through the Anime4K chain into the currently bound
+ * framebuffer, restricted to the given viewport. Returns false when the chain
+ * is unavailable (the caller should fall back to the default blit).
+ */
+bool anime4k_render(GLuint src_tex, int w, int h,
+                    int vp_x, int vp_y, int vp_w, int vp_h);
+
+#endif
