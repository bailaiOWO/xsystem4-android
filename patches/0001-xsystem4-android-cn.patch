+
+/* APEG decoder ported from TomorrowX6/re-xsystem4, commit
+ * 683a119d0ab2b23e0440c6f5e84e2141653e5503 (src/movie_plmpeg.c
+ * and include/apeg_vlc.h). The APEG picture algorithms and VLC tables
+ * are retained; container ownership and scheduling are independent.
+ * https://github.com/TomorrowX6/re-xsystem4
+ */
+
+#ifndef XSYSTEM4_APEG_DECODER_H
+#define XSYSTEM4_APEG_DECODER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include "pl_mpeg.h"
+
+struct apeg_decoder;
+
+/* Takes ownership of fp, including on failure. Requires a seekable file. */
+struct apeg_decoder *apeg_decoder_open(FILE *fp);
+void apeg_decoder_close(struct apeg_decoder *decoder);
+int apeg_decoder_width(struct apeg_decoder *decoder);
+int apeg_decoder_height(struct apeg_decoder *decoder);
+int apeg_decoder_duration(struct apeg_decoder *decoder);
+
+/* Caller frees the returned SOND payload. Does not change the video cursor.
+ * No sound/read failure returns NULL and writes zero to size. */
+unsigned char *apeg_decoder_read_sound(struct apeg_decoder *decoder, size_t *size);
+
+/* Clamps msec to the movie duration, seeks to the preceding keyframe and
+ * decodes toward the target. The first frame afterwards is immediately due. */
+bool apeg_decoder_seek(struct apeg_decoder *decoder, int msec);
+
+/* Returns the frame to present after the donor's 35 ms catch-up window,
+ * or NULL if none is due or at end/read failure. Old B pictures are skipped;
+ * a future frame is retained internally. Only one frame needs uploading. */
+/* The frame and its Y/Cb/Cr planes are borrowed and remain valid only until
+ * the next frame/seek/close call. No frame pixels are copied by this API. */
+plm_frame_t *apeg_decoder_frame(struct apeg_decoder *decoder, int msec);
+
+#endif /* XSYSTEM4_APEG_DECODER_H */
