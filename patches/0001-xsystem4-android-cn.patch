+/*
+ * Report an unimplemented HLL function together with its exact prototype, as
+ * declared by the script. Porting a new game means implementing these one at a
+ * time, so the signature is the whole specification we need to get started.
+ *
+ * This is deliberately NOT fatal: a modal error would stop the game at the
+ * first missing function and hide everything behind it. Instead the call is
+ * logged once and a default value is returned, so a full sweep of a new game
+ * can be collected in one run.
+ */
+static bool *reported_unimplemented;
+
+// "<return type> Name(<arg types>)" as declared by the script.
+static char *hll_function_prototype(struct ain_hll_function *f)
+{
+	char args[1024];
+	size_t off = 0;
+	args[0] = '\0';
+	for (int i = 0; i < f->nr_arguments && off < sizeof(args) - 1; i++) {
+		char *t = ain_strtype_d(ain, &f->arguments[i].type);
+		off += snprintf(args + off, sizeof(args) - off, "%s%s", i ? ", " : "", t);
+		free(t);
+	}
+	char *ret = ain_strtype_d(ain, &f->return_type);
+	char *sig = xmalloc(strlen(ret) + strlen(f->name) + strlen(args) + 8);
+	sprintf(sig, "%s %s(%s)", ret, f->name, args);
+	free(ret);
+	return sig;
+}
+
+static void unimplemented_hll_function(int libno, struct ain_hll_function *f)
+{
+	if (!reported_unimplemented) {
+		int nr = 0;
+		for (int i = 0; i < ain->nr_libraries; i++)
+			nr += ain->libraries[i].nr_functions;
+		reported_unimplemented = xcalloc(nr, sizeof(bool));
+	}
+	int index = 0;
+	for (int i = 0; i < libno; i++)
+		index += ain->libraries[i].nr_functions;
+	int fno = f - ain->libraries[libno].functions;
+	if (index + fno < 0 || reported_unimplemented[index + fno])
+		return;
+	reported_unimplemented[index + fno] = true;
+
+	char *sig = hll_function_prototype(f);
+	WARNING("Unimplemented HLL function: %s.%s -> %s",
+	        ain->libraries[libno].name, f->name, sig);
+	trace_log("UNIMPLEMENTED HLL %s.%s -> %s",
+	          ain->libraries[libno].name, f->name, sig);
+	free(sig);
+}
