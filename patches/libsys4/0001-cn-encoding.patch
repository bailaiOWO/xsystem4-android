+static char *find_dirent_match(const char *dir, const char *name)
+{
+	char *alt = alt_name_decoding(name);
+	DIR *d = opendir(dir && *dir ? dir : ".");
+	if (!d) {
+		free(alt);
+		return NULL;
+	}
+	struct dirent *e;
+	char *found = NULL;
+	while ((e = readdir(d))) {
+		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+			continue;
+		if (!strcasecmp(e->d_name, name) ||
+		    (alt && !strcasecmp(e->d_name, alt))) {
+			found = xstrdup(e->d_name);
+			break;
+		}
+	}
+	closedir(d);
+	free(alt);
+	return found;
