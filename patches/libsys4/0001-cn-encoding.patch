+				free(out);
+				return NULL;
+			}
+			len = strlen(out);
+			snprintf(cand, sizeof(cand), "%s%s%s", out,
+			         (len && out[len - 1] != '/') ? "/" : "", match);
+			free(match);
+			if (stat(cand, &st) != 0) {
+				free(work);
+				free(out);
+				return NULL;
+			}
+		}
+		snprintf(out, PATH_MAX, "%s", cand);
+	}
+	free(work);
