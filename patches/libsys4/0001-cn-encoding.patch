+	char *work = xstrdup(path);
+	char *out = xmalloc(PATH_MAX);
+	out[0] = '\0';
+	if (path[0] == '/')
+		strcpy(out, "/");
+
+	char *saveptr = NULL;
+	for (char *comp = strtok_r(work, "/", &saveptr); comp;
+	     comp = strtok_r(NULL, "/", &saveptr)) {
+		char cand[PATH_MAX];
+		size_t len = strlen(out);
+		snprintf(cand, sizeof(cand), "%s%s%s", out,
+		         (len && out[len - 1] != '/') ? "/" : "", comp);
+		if (stat(cand, &st) != 0) {
+			char *match = find_dirent_match(*out ? out : ".", comp);
+			if (!match) {
